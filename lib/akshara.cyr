# akshara.cyr -- bundled distribution
# Version: 1.1.2
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/akshara.deps):
include "lib/io.cyr"

# --- tok.cyr ---

# akshara — corpus + tokenizers (byte-level + opt-in BPE): the text → token-id
# data layer.
#
# The embedded/loaded corpus, the packed token store (+ width-generic accessors
# and the streaming read path), the adaptive byte vocab, and the opt-in BPE
# tokenizer (learn / encode / decode). Carved out of attn11's train.cyr
# (2026-06-22, the M1 extraction) byte-identically; shared by attn11 and tarka.
# Every 1.x optimization keeps every output bit-identical (docs/adr/0001); the
# golden cases in tests/golden.cyr pin the 1.1.1 outputs.
#
# Error returns are negative and documented per function (docs/api.md lists them
# all). The library never opens files: the loader, streaming and emit paths call
# four consumer-supplied symbols (_putc, secure_read_file, read_stdin,
# file_seek), left unresolved in dist/akshara.cyr.

# ---- corpus ----------------------------------------------------------------
# A small, structured corpus so the tiny model can visibly learn and produce
# real words within a few thousand steps. Char-level. Assembled at runtime from
# short segments (Cyrius has no string-literal concatenation, and a single
# 190-char literal would trip the 120-col lint gate).

# Copy NUL-terminated `s` to buf + pos; return the new end position.
fn _append(buf, pos, s): i64 {
    var n = strlen(s); var i = 0;
    while (i < n) { store8(buf + pos + i, load8(s + i)); i = i + 1; }
    return pos + n;
}

# Fill `buf` with the corpus text (null-terminated); return its length.
# `buf` must hold at least 256 bytes (the text is 193 bytes plus the NUL).
fn corpus_build(buf): i64 {
    var p = 0;
    p = _append(buf, p, "cyrius compiles to a tiny static elf. ");
    p = _append(buf, p, "cyrius has no libc. cyrius has no llvm. ");
    p = _append(buf, p, "attn11 trains a transformer in cyrius. ");
    p = _append(buf, p, "a transformer learns to predict the next token. ");
    p = _append(buf, p, "the next token is the goal. ");
    store8(buf + p, 0);
    return p;
}

# ---- tokenizer (byte-level) ------------------------------------------------
var g_vocab = 0;     # id -> BASE byte value (<= 256 entries; BPE ids >= base
# resolve through g_tok_bytes/g_tok_len instead)
var g_char2id = 0;   # byte value -> BASE id (256 entries, -1 if absent)
var g_data = 0;      # encoded corpus (ids), length g_datalen
var g_datalen = 0;
var g_data_w = 1;    # bytes per token in the PACKED g_data store: 1 = u8
# (byte-level, vocab <= 256), 2 = u16 (BPE, vocab <= 768), 8 = i64.
# The corpus is the one buffer that scales with input size, so
# only it is packed. Set by the caller BEFORE corpus_set, which
# refuses any other width; bpe_learn widens u8 to u16.
var g_corpus_vlen = 0;  # BYTE vocab size of the loaded corpus (the BPE base;
# NOT the consumer's model vocab)

# BPE state (see the BPE section below; all zero in byte-level mode)
var g_bpe_on = 0;       # 0 = byte-level (the default), 1 = BPE active
var g_bpe_base = 0;     # base (byte) vocab size B
var g_bpe_nmerges = 0;  # merges actually learned/loaded (<= BPE_MAX_MERGES)
var g_merges = 0;       # 2*BPE_MAX_MERGES i64: merge m = (left id, right id)
var g_tok_len = 0;      # BPE_VMAX i64: byte length of each id's expansion
var g_tok_bytes = 0;    # BPE_VMAX * BPE_MAX_TOKLEN raw BYTES (fixed stride)
var g_enc_buf = 0;      # ENC_MAX i64: prompt-encode scratch
var g_paircnt = 0;      # BPE_VMAX^2 i64: pair counts (bpe_learn only)
var g_text = 0;         # raw corpus bytes, retained by corpus_set
var g_textlen = 0;

# ---- streaming token-shard corpus (the RAM-independent large-corpus path)
# When g_stream != 0 the corpus is NOT held in g_data; gd_ld pulls tokens from a
# pre-encoded token shard on demand through ONE chunk cache (g_stream_buf,
# g_stream_cap tokens) via file_seek + file_read on g_stream_fd. RAM is then
# O(model + chunk), independent of corpus size — so a GB-scale shard trains in
# bounded RAM. The cached tokens are IDENTICAL to what an in-memory g_data would
# hold, so every sampling/eval path that reads through gd_ld stays byte-for-byte
# unchanged. The consumer opens and validates the shard and sets every g_stream*
# field (attn11: src/stream.cyr shard_open); corpus_set does not touch them, so
# a consumer that streams must clear g_stream before loading an in-memory corpus.
var g_stream = 0;          # 1 = corpus is streamed (gd_ld reads from the shard)
var g_stream_fd = 0 - 1;   # the open shard fd (held for the run)
var g_stream_doff = 0;     # byte offset of the token data within the file
var g_stream_buf = 0;      # chunk cache: g_stream_cap tokens at g_data_w bytes
var g_stream_cap = 0;      # chunk capacity in tokens (= STREAM_CHUNK())
var g_stream_lo = 0;       # token index of the first cached token
var g_stream_clen = 0;     # tokens currently cached (0 = empty)

# Tokens per streamed chunk read (> the 8192 context cap of every consumer).
fn STREAM_CHUNK(): i64 { return 65536; }

# Cap on a loaded corpus: 64 MiB (a u16 store is then 128 MiB, well inside the
# allocator's 2 GiB single-allocation limit).
fn MAX_CORPUS_BYTES(): i64 { return 67108864; }

# Largest `len` corpus_set accepts: len * 8 cannot wrap (2^60 - 1).
fn _CORPUS_LEN_MAX(): i64 { return 1152921504606846975; }

# Fatal error: message to stderr, exit 1. Used where the library cannot return
# an error (a streamed read under the training loop, the one-time BPE tables).
fn _ak_fatal(msg): i64 {
    sys_write(2, msg, strlen(msg));
    sys_exit(1);
    return 0;
}

# ---- packed token-store accessors ------------------------------------------
# Width-generic token load/store into a byte buffer: w = 1 (u8), 2 (u16), or 8
# (i64, the legacy full-width). load zero-extends (token ids are non-negative);
# store writes only the low w bytes (ids <= 767 fit u16, never the high bits).

# Load element i of a w-wide packed buffer (any w other than 1 or 2 reads i64).
fn _tw_ld(buf, i, w): i64 {
    if (w == 1) { return load8(buf + i); }
    if (w == 2) { return load16(buf + i * 2); }
    return load64(buf + i * 8);
}

# Store v as element i of a w-wide packed buffer (any w other than 1 or 2 writes i64).
fn _tw_st(buf, i, w, v): i64 {
    if (w == 1) { store8(buf + i, v); }
    elif (w == 2) { store16(buf + i * 2, v); }
    else { store64(buf + i * 8, v); }
    return 0;
}

# Fetch token `i` from the streamed shard via the single chunk cache. A miss
# (re)loads [i, i+cap) — clamped to g_datalen — in ONE read loop; every window's
# accesses are then local (a window spans <= ctx+1 tokens << cap), so the
# amortized cost is ~one read per window. The returned value equals an in-memory
# gd_ld byte-for-byte, which is the whole point. A hostile shard is the
# consumer's open-time gate (file size vs ntokens), so a chunk read never passes
# EOF. Fails loud (stderr, exit 1) on an index outside [0, g_datalen), an unset
# cache, a failed seek, or a short read — the training loop cannot take an error
# return, and a stale buffer must never reach the weights.
fn stream_tok(i): i64 {
    if ((i < g_stream_lo) || (i >= g_stream_lo + g_stream_clen)) {
        if ((i < 0) || (i >= g_datalen)) { _ak_fatal("akshara: stream index out of range\n"); }
        if ((g_stream_buf == 0) || (g_stream_cap < 1)) { _ak_fatal("akshara: stream cache not set up\n"); }
        var lo = i;
        var want = g_datalen - lo;
        if (want > g_stream_cap) { want = g_stream_cap; }
        var nbytes = want * g_data_w;
        if (file_seek(g_stream_fd, g_stream_doff + lo * g_data_w) < 0) {
            _ak_fatal("akshara: stream seek failed -- corrupt/truncated shard\n");
        }
        var got = 0;
        while (got < nbytes) {
            var n = file_read(g_stream_fd, g_stream_buf + got, nbytes - got);
            if (n == 0 - 4) { continue; }       # EINTR: the read is retried
            if (n <= 0) { break; }
            got = got + n;
        }
        # open-time validation (ntokens vs the real file size) guarantees a full
        # read; a short read here means the shard was truncated AFTER open (TOCTOU)
        # or an I/O error — unrecoverable, so fail loud rather than set clen to the
        # full window and train on a stale buffer tail.
        if (got < nbytes) {
            _ak_fatal("akshara: stream read short -- corrupt/truncated shard\n");
        }
        g_stream_lo = lo; g_stream_clen = want;
    }
    return _tw_ld(g_stream_buf, i - g_stream_lo, g_data_w);
}

# Token `i` of the corpus at the active width (a token index, not a byte
# offset). Routes through the streamed shard when g_stream != 0. Unchecked: `i`
# in [0, g_datalen) is the caller's contract (the sampler's hot path).
fn gd_ld(i): i64 {
    if (g_stream != 0) { return stream_tok(i); }
    if (g_data_w == 2) { return load16(g_data + i * 2); }
    if (g_data_w == 1) { return load8(g_data + i); }
    return load64(g_data + i * 8);
}

# Store token `v` at index `i` of the in-memory store at the active width.
# Unchecked, like gd_ld.
fn gd_st(i, v): i64 {
    if (g_data_w == 2) { store16(g_data + i * 2, v); }
    elif (g_data_w == 1) { store8(g_data + i, v); }
    else { store64(g_data + i * 8, v); }
    return 0;
}

# Byte-level tokenize+encode of an arbitrary `len`-byte buffer. Builds the
# adaptive vocab (only the byte values that actually occur, in first-occurrence
# order) and the packed id stream at g_data_w. Handles any of the 256 byte
# values. Retains `text` (not copied) as g_text and resets BPE state. Returns
# the vocab size, or -5 (len < 1, or the store allocation refused) or -6
# (g_data_w not 1, 2 or 8). Every refusal leaves the loaded corpus untouched.
fn corpus_set(text, len): i64 {
    var w = g_data_w;
    if ((w != 1) && (w != 2) && (w != 8)) { return 0 - 6; }
    if ((len < 1) || (len > _CORPUS_LEN_MAX())) { return 0 - 5; }
    var data = alloc(len * w);
    if (data == 0) { return 0 - 5; }
    # validated and allocated: only now replace the loaded corpus. Retain the
    # raw bytes (the BPE checkpoint loader re-encodes from them) and reset any
    # prior tokenizer state — a fresh corpus starts byte-level.
    g_text = text; g_textlen = len;
    g_bpe_on = 0; g_bpe_nmerges = 0; g_bpe_base = 0;
    g_datalen = len;
    var c2i = t_alloc(256);
    var i = 0;
    while (i < 256) { store64(c2i + i * 8, 0 - 1); i = i + 1; }
    g_char2id = c2i;
    g_vocab = t_alloc(256);
    var V = 0;
    i = 0;
    while (i < len) {
        var ch = load8(text + i);
        if (load64(c2i + ch * 8) < 0) {
            store64(c2i + ch * 8, V);
            store64(g_vocab + V * 8, ch);
            V = V + 1;
        }
        i = i + 1;
    }
    # the fill covers all of [0, len), so the raw alloc needs no zeroing
    g_data = data;
    i = 0;
    if (w == 2) {
        while (i < len) { store16(data + i * 2, load64(c2i + load8(text + i) * 8)); i = i + 1; }
    } elif (w == 1) {
        while (i < len) { store8(data + i, load64(c2i + load8(text + i) * 8)); i = i + 1; }
    } else {
        while (i < len) { store64(data + i * 8, load64(c2i + load8(text + i) * 8)); i = i + 1; }
    }
    g_corpus_vlen = V;
    return V;
}

# Default: the embedded corpus. Returns its vocab size, -4 if the 1 KiB buffer
# allocation is refused, or corpus_set's errors.
fn build_corpus(): i64 {
    var text = alloc(1024);
    if (text == 0) { return 0 - 4; }
    var len = corpus_build(text);
    return corpus_set(text, len);
}

# Load a corpus from a file through the consumer's secure_read_file (which owns
# O_NOFOLLOW and the size check). Returns the vocab size, or a negative error:
# the hook's own (e.g. an open errno), -2 if the file exceeds MAX_CORPUS_BYTES
# (from the hook, or a hook count past the cap), -3 empty, -4 buffer allocation
# refused, or corpus_set's -5 / -6.
fn corpus_load_file(path): i64 {
    var buf = alloc(MAX_CORPUS_BYTES());
    if (buf == 0) { return 0 - 4; }
    var len = secure_read_file(path, buf, MAX_CORPUS_BYTES());
    if (len < 0) { return len; }
    if (len > MAX_CORPUS_BYTES()) { return 0 - 2; }
    if (len < 1) { return 0 - 3; }
    return corpus_set(buf, len);
}

# Load a corpus from stdin through the consumer's read_stdin (size-capped).
# Reads up to MAX+1 bytes so an input larger than the cap is rejected (-2)
# rather than silently truncated — matching the file path. Other returns as
# corpus_load_file.
fn corpus_load_stdin(): i64 {
    var cap = MAX_CORPUS_BYTES();
    var buf = alloc(cap + 1);
    if (buf == 0) { return 0 - 4; }
    var len = read_stdin(buf, cap + 1);
    if (len < 0) { return len; }
    if (len > cap) { return 0 - 2; }
    if (len < 1) { return 0 - 3; }
    return corpus_set(buf, len);
}

# Base id -> its byte value. Unchecked: `id` in [0, 256) is the caller's
# contract (legal only for id < g_bpe_base in BPE mode; tok_emit checks).
fn decode_char(id): i64 { return load64(g_vocab + id * 8); }

# ---- BPE tokenizer (opt-in; byte-level stays the default) -------------------
# Simple byte-pair encoding, Sennrich et al. 2016 (arXiv:1508.07909) — see
# docs/sources.md. Layered ON TOP of the byte-level tokenizer: layer 0 is the
# adaptive byte vocab above (g_vocab/g_char2id, ids 0..B-1); each merge mints
# id B+m for an adjacent pair. Pure i64 arithmetic throughout — no f64, no
# PRNG — so the whole pipeline is bit-reproducible across x86_64 and aarch64.

# Cap on the merge count (bpe_learn's K, a checkpoint's table).
fn BPE_MAX_MERGES(): i64 { return 512; }
# Maximum vocab: 256 base bytes + 512 merges.
fn BPE_VMAX(): i64 { return 768; }
# Cap on a token's byte expansion (the anti-bomb bound; also the span stride).
fn BPE_MAX_TOKLEN(): i64 { return 64; }
# bpe_learn stops when no eligible pair occurs at least this often.
fn BPE_MIN_FREQ(): i64 { return 2; }
# Size of the g_enc_buf prompt-encode scratch, in ids.
fn ENC_MAX(): i64 { return 8192; }

# One-time, cap-sized allocations, reused for the process lifetime — the
# checkpoint loader must not grow the arena per accepted load (fuzz loads
# the loader hundreds of times). Exits (stderr) if the allocator refuses.
fn bpe_alloc_once(): i64 {
    if (g_merges == 0) {
        g_merges = t_alloc(2 * BPE_MAX_MERGES());
        g_tok_len = t_alloc(BPE_VMAX());
        g_tok_bytes = alloc(BPE_VMAX() * BPE_MAX_TOKLEN());   # raw BYTES
        if (g_tok_bytes == 0) { _ak_fatal("akshara: bpe alloc failed\n"); }
        g_enc_buf = t_alloc(ENC_MAX());
    }
    return 0;
}

# Precompute every id's byte expansion. Decode is a flat table, NOT recursion:
# merge m may reference only ids < B+m, so one forward pass fills everything in
# minting order. The whole table (g_bpe_base, g_bpe_nmerges, g_merges) is
# validated first — base in [1, 256], count in [0, BPE_MAX_MERGES], every merge
# well-founded and its span within BPE_MAX_TOKLEN — so a table a consumer
# installs from a checkpoint or shard can never write past the span buffers.
# Returns 0, or -1 with every span unchanged.
fn bpe_build_spans(): i64 {
    var B = g_bpe_base; var K = g_bpe_nmerges;
    if ((B < 1) || (B > 256) || (g_vocab == 0)) { return 0 - 1; }
    if ((K < 0) || (K > BPE_MAX_MERGES())) { return 0 - 1; }
    bpe_alloc_once();
    var TL = BPE_MAX_TOKLEN();
    var lens[6144];                  # fn-local: 6144 BYTES = BPE_VMAX i64 slots
    var t = 0;
    while (t < B) { store64(&lens + t * 8, 1); t = t + 1; }
    var m = 0;
    while (m < K) {
        var vl = load64(g_merges + (2 * m) * 8);
        var vr = load64(g_merges + (2 * m + 1) * 8);
        if ((vl < 0) || (vl >= B + m) || (vr < 0) || (vr >= B + m)) { return 0 - 1; }
        var e = load64(&lens + vl * 8) + load64(&lens + vr * 8);
        if (e > TL) { return 0 - 1; }
        store64(&lens + (B + m) * 8, e);
        m = m + 1;
    }
    # validated: build exactly as 1.1.1 did
    t = 0;
    while (t < B) {
        store64(g_tok_len + t * 8, 1);
        store8(g_tok_bytes + t * TL, load64(g_vocab + t * 8));
        t = t + 1;
    }
    m = 0;
    while (m < K) {
        var nid = B + m;
        var l = load64(g_merges + (2 * m) * 8);
        var r = load64(g_merges + (2 * m + 1) * 8);
        var ll = load64(g_tok_len + l * 8);
        var rl = load64(g_tok_len + r * 8);
        var dst = g_tok_bytes + nid * TL;
        var i = 0;
        while (i < ll) { store8(dst + i, load8(g_tok_bytes + l * TL + i)); i = i + 1; }
        i = 0;
        while (i < rl) { store8(dst + ll + i, load8(g_tok_bytes + r * TL + i)); i = i + 1; }
        store64(g_tok_len + nid * 8, ll + rl);
        m = m + 1;
    }
    return 0;
}

# Count every adjacent pair of the u16 stream d[0, n) into g_paircnt (whose
# live region the caller zeroed).
fn _bpe_count16(d, n): i64 {
    var P = g_paircnt; var S = BPE_VMAX();
    if (n < 2) { return 0; }
    var prev = load16(d);
    var i = 1;
    while (i < n) {
        var nx = load16(d + i * 2);
        var c = P + (prev * S + nx) * 8;
        store64(c, load64(c) + 1);
        prev = nx;
        i = i + 1;
    }
    return 0;
}

# One merge pass of bpe_learn over the u16 stream d[0, n), in place: every
# (ba, bb) becomes nid, greedy left to right, non-overlapping — exactly the 1.1.1
# rewrite. Safe in place only because wr <= rd invariantly (the stream only
# shrinks). Instead of recounting, the pass updates g_paircnt by exactly the
# pairs it destroys and creates, so the counts stay those of the current stream:
#   - a hit at old positions (rd, rd+1) destroys (old[rd-1], ba) unless the
#     previous hit ended at rd-1 (then that pair was already counted out),
#     (ba, bb), and (bb, old[rd+2]);
#   - it creates (new[wr-1], nid); a copied token t right after a hit creates
#     (nid, t).
# Reads of old[rd-1] are safe: before the first hit nothing has moved, and
# after it wr < rd, so position rd-1 is not yet rewritten. Nothing is written
# before the first hit (the prefix is unchanged). Returns the new length.
fn _bpe_merge16(d, n, ba, bb, nid): i64 {
    var P = g_paircnt; var S = BPE_VMAX();
    var last = n - 1;
    var rd = 0;
    while (rd < last) {
        if (load16(d + rd * 2) == ba) { if (load16(d + rd * 2 + 2) == bb) { break; } }
        rd = rd + 1;
    }
    if (rd >= last) { return n; }
    var wr = rd;
    var lastend = 0 - 2;     # old index of the right half of the previous hit
    var prevhit = 0;         # 1 when the last token written is nid
    while (rd < n) {
        var t = load16(d + rd * 2);
        var hit = 0;
        if (t == ba) { if (rd < last) { if (load16(d + rd * 2 + 2) == bb) { hit = 1; } } }
        if (hit == 1) {
            if ((rd > 0) && (lastend != rd - 1)) {
                var cl = P + (load16(d + (rd - 1) * 2) * S + ba) * 8;
                store64(cl, load64(cl) - 1);
            }
            var cm = P + (ba * S + bb) * 8;
            store64(cm, load64(cm) - 1);
            if (rd + 2 < n) {
                var cr = P + (bb * S + load16(d + (rd + 2) * 2)) * 8;
                store64(cr, load64(cr) - 1);
            }
            if (wr > 0) {
                var cn = P + (load16(d + (wr - 1) * 2) * S + nid) * 8;
                store64(cn, load64(cn) + 1);
            }
            store16(d + wr * 2, nid);
            lastend = rd + 1; prevhit = 1;
            rd = rd + 2;
        } else {
            if (prevhit == 1) {
                var cp = P + (nid * S + t) * 8;
                store64(cp, load64(cp) + 1);
                prevhit = 0;
            }
            store16(d + wr * 2, t);
            rd = rd + 1;
        }
        wr = wr + 1;
    }
    return wr;
}

# Learn up to K merges over the byte-level encoded corpus (g_data), in place.
# Per iteration: take the most frequent adjacent pair (overlaps included —
# frozen semantics), record the merge, re-encode. The argmax scans row-major
# ascending with strict > — the scan order IS the deterministic tie-break
# (highest count, then smallest left id, then smallest right id). NEVER reorder
# this scan: checkpoints store the resulting merges and every encode replays
# them. The TOKLEN eligibility test sits INSIDE the (c > best) body so an
# oversized pair can never shadow an eligible one. Stops early when no pair
# reaches BPE_MIN_FREQ(). The pair counts are kept incrementally by
# _bpe_merge16 (exactly what 1.1.1's per-merge recount produced).
#
# Returns the model vocab V = B + merges, or: -1 K outside [1, BPE_MAX_MERGES];
# -2 no byte-level corpus (none loaded, < 2 tokens, or a base vocab outside
# [1, 256]); -3 an allocation refused; -4 the tokenizer is already BPE (learn
# again only after a fresh corpus_set); -5 g_data_w not 1, 2 or 8. Every
# refusal leaves the tokenizer unchanged.
fn bpe_learn(K): i64 {
    if ((K < 1) || (K > BPE_MAX_MERGES())) { return 0 - 1; }
    if ((g_data == 0) || (g_datalen < 2)) { return 0 - 2; }
    if (g_bpe_on != 0) { return 0 - 4; }
    var w = g_data_w;
    if ((w != 1) && (w != 2) && (w != 8)) { return 0 - 5; }
    var B = g_corpus_vlen;
    if ((B < 1) || (B > 256)) { return 0 - 2; }
    var n = g_datalen;
    # BPE mints ids up to B+K-1 (<= 767), which overflow a u8 store, so the
    # kernels run on u16. A u8 store is widened ONCE into a new u16 store (a
    # one-time setup copy; the old buffer is not reclaimed by the bump
    # allocator). An i64 store is narrowed into a u16 scratch and written back
    # whole at the end, so g_data keeps its width and every byte of it ends up
    # as the 1.1.1 in-place rewrite left it.
    var d = g_data;
    if (w == 1) {
        var wide = alloc(n * 2);
        if (wide == 0) { return 0 - 3; }
        var wi = 0;
        while (wi < n) { store16(wide + wi * 2, load8(g_data + wi)); wi = wi + 1; }
        g_data = wide; g_data_w = 2;
        d = wide;
    } elif (w == 8) {
        d = alloc(n * 2);
        if (d == 0) { return 0 - 3; }
        var ni = 0;
        while (ni < n) { store16(d + ni * 2, load64(g_data + ni * 8)); ni = ni + 1; }
    }
    bpe_alloc_once();
    if (g_paircnt == 0) { g_paircnt = t_alloc(BPE_VMAX() * BPE_VMAX()); }
    var P = g_paircnt; var S = BPE_VMAX(); var TL = BPE_MAX_TOKLEN();
    g_bpe_base = B;
    var i = 0;
    while (i < B) { store64(g_tok_len + i * 8, 1); i = i + 1; }
    var a = 0;
    while (a < B) { t_zero(P + (a * S) * 8, B); a = a + 1; }
    _bpe_count16(d, n);
    var Vcur = B;
    var m = 0;
    while (m < K) {
        var best = 0; var ba = 0 - 1; var bb = 0 - 1;
        a = 0;
        while (a < Vcur) {
            var la = load64(g_tok_len + a * 8);
            var row = P + (a * S) * 8;
            var b = 0;
            while (b < Vcur) {
                var c = load64(row + b * 8);
                if (c > best) {
                    if (la + load64(g_tok_len + b * 8) <= TL) {
                        best = c; ba = a; bb = b;
                    }
                }
                b = b + 1;
            }
            a = a + 1;
        }
        if (best < BPE_MIN_FREQ()) { break; }
        store64(g_merges + (2 * m) * 8, ba);
        store64(g_merges + (2 * m + 1) * 8, bb);
        # the new id's row and column start at zero; the pass fills them
        t_zero(P + (Vcur * S) * 8, Vcur + 1);
        a = 0;
        while (a < Vcur) { store64(P + (a * S + Vcur) * 8, 0); a = a + 1; }
        n = _bpe_merge16(d, n, ba, bb, Vcur);
        store64(g_tok_len + Vcur * 8, load64(g_tok_len + ba * 8) + load64(g_tok_len + bb * 8));
        Vcur = Vcur + 1;
        m = m + 1;
    }
    if (w == 8) {
        i = 0;
        while (i < g_datalen) { store64(g_data + i * 8, load16(d + i * 2)); i = i + 1; }
    }
    g_bpe_nmerges = m;
    g_datalen = n;
    g_bpe_on = 1;
    bpe_build_spans();
    return B + m;
}

# 1 if the u8 stream out[0, n) holds the adjacent pair (ba, bb).
fn _enc_find8(out, n, ba, bb): i64 {
    var last = n - 1;
    var rd = 0;
    while (rd < last) {
        if (load8(out + rd) == ba) { if (load8(out + rd + 1) == bb) { return 1; } }
        rd = rd + 1;
    }
    return 0;
}

# One tok_encode merge pass over out[0, n), at u8 / u16 / i64: every (ba, bb)
# becomes nid, greedy left to right, non-overlapping — the 1.1.1 rewrite with
# the width dispatch hoisted out of the loop and no writes before the first hit
# (the prefix is unchanged). Returns the new count. The three bodies must stay
# identical apart from the access width.
fn _enc_pass8(out, n, ba, bb, nid): i64 {
    var last = n - 1;
    var rd = 0;
    while (rd < last) {
        if (load8(out + rd) == ba) { if (load8(out + rd + 1) == bb) { break; } }
        rd = rd + 1;
    }
    if (rd >= last) { return n; }
    var wr = rd;
    while (rd < n) {
        var t = load8(out + rd);
        if ((t == ba) && (rd < last)) {
            if (load8(out + rd + 1) == bb) { store8(out + wr, nid); rd = rd + 2; wr = wr + 1; continue; }
        }
        store8(out + wr, t); rd = rd + 1; wr = wr + 1;
    }
    return wr;
}
fn _enc_pass16(out, n, ba, bb, nid): i64 {
    var last = n - 1;
    var rd = 0;
    while (rd < last) {
        if (load16(out + rd * 2) == ba) { if (load16(out + rd * 2 + 2) == bb) { break; } }
        rd = rd + 1;
    }
    if (rd >= last) { return n; }
    var wr = rd;
    while (rd < n) {
        var t = load16(out + rd * 2);
        if ((t == ba) && (rd < last)) {
            if (load16(out + rd * 2 + 2) == bb) { store16(out + wr * 2, nid); rd = rd + 2; wr = wr + 1; continue; }
        }
        store16(out + wr * 2, t); rd = rd + 1; wr = wr + 1;
    }
    return wr;
}
fn _enc_pass64(out, n, ba, bb, nid): i64 {
    var last = n - 1;
    var rd = 0;
    while (rd < last) {
        if (load64(out + rd * 8) == ba) { if (load64(out + rd * 8 + 8) == bb) { break; } }
        rd = rd + 1;
    }
    if (rd >= last) { return n; }
    var wr = rd;
    while (rd < n) {
        var t = load64(out + rd * 8);
        if ((t == ba) && (rd < last)) {
            if (load64(out + rd * 8 + 8) == bb) { store64(out + wr * 8, nid); rd = rd + 2; wr = wr + 1; continue; }
        }
        store64(out + wr * 8, t); rd = rd + 1; wr = wr + 1;
    }
    return wr;
}

# Encode len raw bytes into out at output width `ow` bytes/token (caller
# guarantees >= len*ow bytes; ow = 8 for the i64 g_enc_buf prompt scratch, or
# g_data_w for the packed corpus rebuild): bytes -> base ids via g_char2id
# (unseen byte -> id 0, matching generate()'s fallback), then each learned merge
# applied in order with the same greedy left-to-right replace as bpe_learn. That
# is EXACTLY the pass sequence bpe_learn performed on the corpus, so encoding the
# original corpus bytes reproduces g_data bit-for-bit — the property the
# checkpoint loader's corpus rebuild relies on. Output count <= len: never
# grows. Returns the id count, or -1 when ow is not 1, 2 or 8, no tokenizer is
# loaded, or ow = 1 and a merge that mints an id past 255 applies to this text
# (a u8 cannot hold it; 1.1.1 stored it truncated). At ow = 1 every text whose
# encoding stays below 256 ids encodes exactly as before, whatever the vocab.
fn tok_encode(text, len, out, ow): i64 {
    if ((ow != 1) && (ow != 2) && (ow != 8)) { return 0 - 1; }
    var c2i = g_char2id;
    if (c2i == 0) { return 0 - 1; }
    var K = 0;
    if (g_bpe_on != 0) {
        K = g_bpe_nmerges;
        if ((K < 0) || (K > BPE_MAX_MERGES()) || ((K > 0) && (g_merges == 0))) { return 0 - 1; }
    }
    var n = 0;
    if (len > 0) { n = len; }
    var i = 0;
    while (i < n) {
        var id = load64(c2i + load8(text + i) * 8);
        if (id < 0) { id = 0; }
        if (ow == 8) { store64(out + i * 8, id); }
        elif (ow == 2) { store16(out + i * 2, id); }
        else { store8(out + i, id); }
        i = i + 1;
    }
    if (g_bpe_on == 0) { return n; }
    var base = g_bpe_base;
    var m = 0;
    while (m < K) {
        var ba = load64(g_merges + (2 * m) * 8);
        var bb = load64(g_merges + (2 * m + 1) * 8);
        if (ow == 8) { n = _enc_pass64(out, n, ba, bb, base + m); }
        elif (ow == 2) { n = _enc_pass16(out, n, ba, bb, base + m); }
        elif (base + m <= 255) { n = _enc_pass8(out, n, ba, bb, base + m); }
        elif (_enc_find8(out, n, ba, bb) == 1) { return 0 - 1; }   # would mint id > 255
        # else: the pair never occurs, so this merge changes nothing (as in 1.1.1)
        m = m + 1;
    }
    return n;
}

# Emit one sampled id's bytes. Byte mode: the single vocab byte, through the
# consumer's _putc. BPE: the precomputed span through print() — which counts
# BYTES, exactly right: spans may hold partial UTF-8 sequences and
# byte-level-underneath BPE reassembles them across tokens. Returns 0, or -1
# (nothing emitted) for an id outside the table: < 0, >= 256 at byte level, or
# >= g_bpe_base + g_bpe_nmerges (or BPE_VMAX) under BPE.
fn tok_emit(id): i64 {
    if (id < 0) { return 0 - 1; }
    if (g_bpe_on == 0) {
        if (id >= 256) { return 0 - 1; }
        _putc(decode_char(id));
        return 0;
    }
    if ((id >= g_bpe_base + g_bpe_nmerges) || (id >= BPE_VMAX())) { return 0 - 1; }
    print(g_tok_bytes + id * BPE_MAX_TOKLEN(), load64(g_tok_len + id * 8));
    return 0;
}
