# rosnet.cyr -- bundled distribution
# Version: 1.4.1
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/rosnet.deps):
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/simd.cyr"

# --- tensor.cyr ---

# rosnet — tensor storage + element-wise / BLAS-1 layer.
#
# Cyrius has no float type: an f64 is its 64-bit IEEE-754 pattern carried in an
# i64. A "tensor" here is a heap pointer to a flat, row-major run of f64 values;
# shapes live in the calling code. Element i sits at byte offset i*8.
#
# Stdlib (math/alloc/fmt/io) is auto-included via cyrius.cyml. The PRNG sampler
# (rng_seed / rng_normal) comes from the tyche dependency — see t_randn.

# Convenience: f64 from a small integer literal.
fn ff(n): i64 { return f64_from(n); }

# ---- element access --------------------------------------------------------
# A tensor is a raw pointer; element i is an f64 bit pattern at p + i*8.
fn tget(p, i): i64 { return load64(p + i * 8); }
# Store the f64 bit pattern v as element i of p.
fn tset(p, i, v): i64 { store64(p + i * 8, v); return 0; }

# ---- allocation ------------------------------------------------------------
# Print "rosnet: t_alloc: <why> <n>" to stderr and exit 1. t_alloc never
# returns 0: a null tensor would turn into pointer arithmetic from address 0.
fn _t_alloc_fail(why, n): i64 {
    var pre = "rosnet: t_alloc: ";
    sys_write(2, pre, strlen(pre));
    sys_write(2, why, strlen(why));
    fmt_int_fd(2, n);
    sys_write(2, "\n", 1);
    sys_exit(1);
    return 0;
}

# Allocate n f64 elements, zero-initialised (alloc returns zeroed pages, but be
# explicit so callers can rely on it after reuse). Fail-loud, never null:
#   n < 0, or n * 8 past 2^63 (it would wrap to a small size and the zero-fill
#   would run off the block)   -> "invalid size", exit 1
#   alloc() returns 0 (past the allocator's cap / out of memory) -> exit 1
#   n == 0 -> a valid, distinct pointer to one zeroed slot (an empty tensor;
#   every op given n = 0 touches no element). Before 1.2.2 alloc(0) returned 0
#   and t_alloc(0) exited as "out of memory".
fn t_alloc(n): i64 {
    if (n < 0) { _t_alloc_fail("invalid size, f64s: ", n); }
    if (n > 1152921504606846975) { _t_alloc_fail("invalid size, f64s: ", n); }   # 2^60 - 1
    var slots = n;
    if (slots == 0) { slots = 1; }
    var p = alloc(slots * 8);
    if (p == 0) { _t_alloc_fail("out of memory, f64s: ", n); }
    var i = 0;
    while (i < slots) { store64(p + i * 8, 0); i = i + 1; }
    return p;
}

# p[0..n) = +0.0 (all-zero bits).
fn t_zero(p, n): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, 0); i = i + 1; }
    return 0;
}

# p[0..n) = v (an f64 bit pattern).
fn t_fill(p, n, v): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, v); i = i + 1; }
    return 0;
}

# dst[0..n) = src[0..n), bit for bit (NaN payloads included). Forward order:
# for overlapping ranges only dst <= src is safe.
fn t_copy(dst, src, n): i64 {
    var i = 0;
    while (i < n) { store64(dst + i * 8, load64(src + i * 8)); i = i + 1; }
    return 0;
}

# ---- BLAS-1 (vector) ops ---------------------------------------------------
# Test-only switch: 1 forces the SSE2 paths even on an AVX2 CPU, so CI's AVX2
# runners still check them (tests/rosnet.tcyr, tests/rosnet.fcyr). Not API.
var _rosnet_force_sse2 = 0;

# 1 when the 4-lane AVX2 kernels may run: the CPU has AVX2 (cached CPUID probe;
# always 0 on aarch64, where the probe compiles out) and no test forced SSE2.
fn _rosnet_avx2(): i64 {
    if (_rosnet_force_sse2 == 1) { return 0; }
    return simd_has_avx2();
}

# dst[i] += a * src[i]   (a is an f64 bit pattern)
fn t_axpy(dst, src, a, n): i64 {
    var i = 0;
    while (i < n) {
        var y = f64_add(load64(dst + i * 8), f64_mul(a, load64(src + i * 8)));
        store64(dst + i * 8, y);
        i = i + 1;
    }
    return 0;
}

# dst[i] += src[i]
# Packed over a prefix: f64v_add is one addpd / fadd per element on every target
# and f64v256_add one vaddpd (a single rounding, as f64_add), so the result is
# bit-identical to the scalar loop wherever the split falls. The f64v builtins
# have no scalar tail — they write whole lane groups — so the count passed is a
# multiple of the lanes (2, or 4 on the AVX2 path, 1.4.1: ~1.6× at n = 768) and
# the rest is added alone.
fn t_add_into(dst, src, n): i64 {
    var n2 = n - (n % 2);
    if (_rosnet_avx2() == 1) {
        n2 = n - (n % 4);
        f64v256_add(dst, dst, src, n2);
    } else {
        f64v_add(dst, dst, src, n2);
    }
    var i = n2;
    while (i < n) {
        store64(dst + i * 8, f64_add(load64(dst + i * 8), load64(src + i * 8)));
        i = i + 1;
    }
    return 0;
}

# dst[i] *= s
# Packed over a prefix like t_add_into: f64v_scale is one mulpd / fmul per
# element on every target and f64v256_scale one vmulpd, so the result is
# bit-identical to f64_mul (AVX2 path 1.4.1: ~1.7× at n = 768).
fn t_scale(dst, n, s): i64 {
    var n2 = n - (n % 2);
    if (_rosnet_avx2() == 1) {
        n2 = n - (n % 4);
        f64v256_scale(dst, dst, s, n2);
    } else {
        f64v_scale(dst, dst, s, n2);
    }
    var i = n2;
    while (i < n) {
        store64(dst + i * 8, f64_mul(load64(dst + i * 8), s));
        i = i + 1;
    }
    return 0;
}

# sum of all elements (f64 bit pattern)
fn t_sum(p, n): i64 {
    var acc = f64_from(0);
    var i = 0;
    while (i < n) { acc = f64_add(acc, load64(p + i * 8)); i = i + 1; }
    return acc;
}

# ---- robustness guard ------------------------------------------------------
# 1 if x is a finite f64, 0 if it is NaN or +-Inf. Checked on the bit pattern
# (exponent all-ones == Inf/NaN), since this toolchain's f64 comparisons are not
# NaN-correct. Training/sims should stop, not silently corrupt, on a blow-up.
fn f64_is_finite(x): i64 {
    if (((x >> 52) & 0x7FF) == 0x7FF) { return 0; }
    return 1;
}

# ---- random fill (bridges tyche -> tensor) ---------------------------------
# Fill p[0..n) with standard-normal samples scaled by std (an f64 bit pattern).
# rng_normal / rng_seed come from the tyche dependency; seed the stream via
# tyche's rng_seed before calling for reproducible fills. This is the one
# rosnet symbol that depends on tyche — consumers using it need [deps.tyche].
fn t_randn(p, n, std): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, f64_mul(rng_normal(), std)); i = i + 1; }
    return 0;
}

# --- linear.cyr ---

# rosnet — dense matmul (the BLAS-3 op) and its gradient.
#
# Conventions:
#   * tensors are flat row-major f64 arrays (see tensor.cyr)
#   * forward writes outputs; backward *accumulates* into parameter gradients
#     (dW, db) so callers zero them once per step, and *writes* the input
#     gradient (dx) fresh.
#   * `b == 0` (null pointer) means "no bias".
#
# matmul AND its backward are pure linear algebra: dx = dy·Wᵀ, dW = xᵀ·dy. There
# is nothing model-specific here — that is why they live in the tensor lib and
# not in a neural-net layer. The backward is validated against central finite
# differences in tests/rosnet.tcyr (ported from attn11's grad-check).

# ===========================================================================
# Linear:  y(M,N) = x(M,K) @ W(K,N) [+ b(N)]
# ===========================================================================
# SIMD note: matmul is ~80% of a training step. We vectorize over the
# contiguous output dim N (W is row-major (K,N), so W[k, n..] is contiguous).
# Loop order is (m, k, n): y[m,:] is initialised to the bias then accumulated
# as y[m, 0..n4) += x[m,k] * W[k, 0..n4) by ONE f64v_axpy per (m, k) — the
# packed y += alpha*x builtin with a scalar alpha (the AVX2 path below builds a
# 128-lane broadcast instead, since there is no 256-bit axpy).
# The per-element += sequence over k is the scalar one, so on x86_64 the result
# is BIT-IDENTICAL to scalar f64_mul+f64_add (f64v_axpy lowers to mulpd+addpd:
# two roundings). On aarch64 every packed multiply-add (f64v_axpy, f64v_fmadd)
# lowers to a fused FMLA — one rounding — so there the vector body and the
# scalar tail round differently and results differ from x86_64 in the last bits.
# n4 = N rounded down to a multiple of 4 (the 1.2.1 split, kept so every element
# takes the same path as before); the f64v builtins have no scalar tail and
# write whole 2-lane pairs, so the count passed must stay even.
# 1.4.1: on an AVX2 CPU the AXPY runs 4 lanes wide (see _ln_ones_init) — same bits.

# Ones for the AVX2 broadcast (module scope: 128 slots = 1 KB), filled on first use.
var _ln_ones[128];
var _ln_ones_ready = 0;
# (_rosnet_force_sse2, the test-only switch to the SSE2 path, is in tensor.cyr.)

# The AVX2 row step (1.4.1), written out in linear_fwd and in _ln_bwd_dW:
# y[0..n4) += a·w[0..n4) as a 128-lane broadcast of a, made by one f64v256_scale
# of the ones row (a·1 = a exactly), then one f64v256_fmadd per 128-lane chunk,
# y = a·w + y. That lowers to vmulpd then vaddpd — two roundings, not a fused op —
# so it is bit-identical to f64v_axpy's mulpd + addpd. (As everywhere, a NaN made
# from two NaN operands may carry the other operand's payload.) The path is chosen
# once per call; without AVX2, and always on aarch64 (simd_has_avx2() is 0 there),
# it is f64v_axpy. The f64v256 builtins write whole 4-lane groups, which n4 is.
fn _ln_ones_init(): i64 {
    if (_ln_ones_ready == 0) {
        var q = 0;
        while (q < 128) { store64(&_ln_ones + q * 8, f64_from(1)); q = q + 1; }
        _ln_ones_ready = 1;
    }
    return 0;
}

# y(M,N) = x(M,K) @ W(K,N) [+ b(N)] — see the SIMD note at the top of this section.
fn linear_fwd(x, W, b, y, M, K, N): i64 {
    var n4 = N - (N % 4);           # vector body; scalar tail for 0..3
    var avx = _rosnet_avx2();
    var bc[1024];                   # AVX2 broadcast: 128 f64 (bytes, fn-local)
    var bl = n4;
    if (bl > 128) { bl = 128; }
    if (avx == 1) { _ln_ones_init(); }
    var m = 0;
    while (m < M) {
        var yrow = y + m * N * 8;
        var n = 0;
        while (n < N) {
            if (b != 0) { store64(yrow + n * 8, load64(b + n * 8)); }
            else { store64(yrow + n * 8, f64_from(0)); }
            n = n + 1;
        }
        var xrow = x + m * K * 8;
        var k = 0;
        while (k < K) {
            var xmk = load64(xrow + k * 8);
            var Wrow = W + k * N * 8;
            if (avx == 1) {
                f64v256_scale(&bc, &_ln_ones, xmk, bl);
                var c0 = 0;
                while (c0 < n4) {
                    var cn = n4 - c0;
                    if (cn > 128) { cn = 128; }
                    f64v256_fmadd(yrow + c0 * 8, &bc, Wrow + c0 * 8, yrow + c0 * 8, cn);
                    c0 = c0 + cn;
                }
            } else {
                f64v_axpy(yrow, Wrow, xmk, n4);
            }
            n = n4;
            while (n < N) {
                store64(yrow + n * 8, f64_add(load64(yrow + n * 8),
                    f64_mul(xmk, load64(Wrow + n * 8))));
                n = n + 1;
            }
            k = k + 1;
        }
        m = m + 1;
    }
    return 0;
}

# linear_bwd's dW pass: dW[k,n] += Σ_m x[m,k]·dy[m,n], the linear_fwd row step per (k, m).
# Its own function so its locals do not crowd the dx loop's registers (1.4.1).
fn _ln_bwd_dW(x, dy, dW, M, K, N, n4): i64 {
    var avx = _rosnet_avx2();
    var bc[1024];                   # AVX2 broadcast: 128 f64 (bytes, fn-local)
    var bl = n4;
    if (bl > 128) { bl = 128; }
    if (avx == 1) { _ln_ones_init(); }
    var kk = 0;
    while (kk < K) {
        var dWrow = dW + kk * N * 8;
        var mm = 0;
        while (mm < M) {
            var xmk = load64(x + (mm * K + kk) * 8);
            var dyrow = dy + mm * N * 8;
            if (avx == 1) {
                f64v256_scale(&bc, &_ln_ones, xmk, bl);
                var c0 = 0;
                while (c0 < n4) {
                    var cn = n4 - c0;
                    if (cn > 128) { cn = 128; }
                    f64v256_fmadd(dWrow + c0 * 8, &bc, dyrow + c0 * 8, dWrow + c0 * 8, cn);
                    c0 = c0 + cn;
                }
            } else {
                f64v_axpy(dWrow, dyrow, xmk, n4);
            }
            var n = n4;
            while (n < N) {
                store64(dWrow + n * 8, f64_add(load64(dWrow + n * 8),
                    f64_mul(xmk, load64(dyrow + n * 8))));
                n = n + 1;
            }
            mm = mm + 1;
        }
        kk = kk + 1;
    }
    return 0;
}

# Given dy(M,N): write dx(M,K); accumulate dW(K,N), db(N) (db may be 0).
# Vectorized over the contiguous N dim (dy[m,:] and W[k,:] are both row-major):
#   dx[m,k] = sum_n dy[m,n]*W[k,n]   -> 4-lane partial sums + tree horizontal sum
#   dW[k,n] += sum_m x[m,k]*dy[m,n]  -> packed axpy over n, summed over m
# dW (axpy) preserves the scalar accumulation order exactly -> bit-identical.
# dx uses a 4-lane partial-sum reduction, so its summation ORDER differs from a
# sequential scalar dot; results match only within floating-point rounding
# (~1e-16, far inside the grad-check tolerance) — gradients are unchanged.
fn linear_bwd(x, W, dy, dx, dW, db, M, K, N): i64 {
    var n4 = N - (N % 4);
    var acc[32];                    # 4-lane dot accumulator (32 bytes, fn-local)
    # dx[m,k] = sum_n dy[m,n] * W[k,n]
    var m = 0;
    while (m < M) {
        var dyrow = dy + m * N * 8;
        var k = 0;
        while (k < K) {
            var Wrow = W + k * N * 8;
            store64(&acc, f64_from(0)); store64(&acc + 8, f64_from(0));
            store64(&acc + 16, f64_from(0)); store64(&acc + 24, f64_from(0));
            # lane j sums the n ≡ j (mod 4) terms in order; that 4-chain shape IS the
            # result's bits, so the call stays 4-wide (a wider call = more chains)
            var n = 0;
            while (n < n4) {
                f64v_fmadd(&acc, dyrow + n * 8, Wrow + n * 8, &acc, 4);
                n = n + 4;
            }
            var s = f64_add(f64_add(load64(&acc), load64(&acc + 8)),
              f64_add(load64(&acc + 16), load64(&acc + 24)));
            while (n < N) {
                s = f64_add(s, f64_mul(load64(dyrow + n * 8), load64(Wrow + n * 8)));
                n = n + 1;
            }
            store64(dx + (m * K + k) * 8, s);
            k = k + 1;
        }
        m = m + 1;
    }
    _ln_bwd_dW(x, dy, dW, M, K, N, n4);
    if (db != 0) {
        var nb = 0;
        while (nb < N) {
            var accb = f64_from(0);
            var mm = 0;
            while (mm < M) { accb = f64_add(accb, load64(dy + (mm * N + nb) * 8)); mm = mm + 1; }
            store64(db + nb * 8, f64_add(load64(db + nb * 8), accb));
            nb = nb + 1;
        }
    }
    return 0;
}

# --- conv.cyr ---

# rosnet — 2D/1D convolution with hand-derived gradients (the 1.1 additive).
#
# THE substrate primitive gating the modality axis (sight + hearing) AND the
# Type-4 diffusion reference (agnosticos planning/multimodal-substrate.md +
# generative-paradigms.md) — the last new LEARNED primitive either needed.
#
# Conventions (rosnet contract: flat row-major f64, shapes live in the caller,
# caller-guarantees, no bounds checks):
#   x  (N, Cin, H, W)        input   — index ((n*Cin+ci)*H+ih)*W+iw
#   Wf (Cout, Cin, KH, KW)   filters — index ((co*Cin+ci)*KH+kh)*KW+kw
#   b  (Cout) or 0           bias
#   y  (N, Cout, OH, OW)     output  — Odim = (dim + 2·Pdim − Kdim)/Sdim + 1
# Stride/padding are PER-AXIS (SH,SW / PH,PW ≥ 0, strides ≥ 1) — so the 1D
# wrappers are exact (no phantom padding on the dummy H axis) and audio stems
# can stride along time only.
#
# Backward follows the linear_bwd convention: dx is WRITTEN (zeroed then
# scatter-accumulated internally; pass 0 to skip — e.g. a first layer whose x
# is data), dW/db are ACCUMULATED (caller zeroes once per step). Hand-derived:
#   db[co]           += Σ_{n,oh,ow} dy
#   dW[co,ci,kh,kw]  += Σ_{n,oh,ow} x[n,ci,oh·SH−PH+kh,ow·SW−PW+kw] · dy[n,co,oh,ow]
#   dx[n,ci,ih,iw]   += Σ_{co,kh,kw} Wf[co,ci,kh,kw] · dy[n,co,oh,ow]
#                        (scattered from each dy position — the transpose conv)
# Validated against central finite differences in tests/rosnet.tcyr (the same
# gate linear_bwd carries), incl. stride > 1, padding > 0, non-square kernels.
#
# Implementation: DIRECT convolution loops — correctness-first, deterministic
# accumulation order, no scratch (im2col+matmul / SIMD lanes are the later
# optimization; see docs/benchmarks.md's honest framing). Each output sums its
# in-bounds taps in (ci, kh, kw) order; the loops visit exactly those taps in
# exactly that order, so the result is the plain nested-loop sum bit for bit.
# The in-bounds tap window is computed once per output position — kh in
# [kh_lo, kh_hi) keeps 0 <= oh·SH − PH + kh < H, kw in [kw_lo, kw_hi) keeps
# 0 <= ow·SW − PW + kw < W — instead of bounds-testing every multiply-add, and
# row base pointers are hoisted out of the tap loops (1.2.2).

# Output length of a K-tap window, stride S, zero padding P, over inn inputs.
fn conv2d_out_dim(inn, K, S, P): i64 { return (inn + 2 * P - K) / S + 1; }

# The first in-bounds tap index for a window starting at input index i0.
fn _conv_lo(i0): i64 {
    if (i0 < 0) { return 0 - i0; }
    return 0;
}

# One past the last in-bounds tap index (a window of K taps from i0, input of
# length L). May be <= _conv_lo when the window misses the input entirely.
fn _conv_hi(i0, K, L): i64 {
    if (L - i0 < K) { return L - i0; }
    return K;
}

# conv2d_fwd for SW == 1: vectorized ALONG the output row. For one tap
# (ci, kh, kw), every output ow whose input column ow − PW + kw is in range gains
# x·w — a contiguous run of x — so the run is done as tmp = x·w (f64v_scale) then
# acc += tmp (f64v_add). Both are a single rounding per element on every target,
# exactly f64_mul then f64_add, and each output still sums its taps in
# (ci, kh, kw) order, so the result is bit-identical to the scalar loops. The row
# is processed in chunks of up to 128 outputs (two 1 KB fn-local buffers); the
# f64v builtins write whole 2-lane pairs, so each call gets an even count and an
# odd last element is done alone.
fn _conv2d_fwd_s1(x, Wf, b, y, N, Cin, H, W, Cout, KH, KW, SH, PH, PW, OH, OW): i64 {
    var acc[1024];                    # 128 f64 output accumulators (bytes, fn-local)
    var tmp[1024];                    # 128 f64 products
    var xstride = H * W * 8;
    var wstride = KH * KW * 8;
    var n = 0;
    while (n < N) {
        var xn = x + n * Cin * xstride;
        var co = 0;
        while (co < Cout) {
            var wco = Wf + co * Cin * wstride;
            var bias = f64_from(0);
            if (b != 0) { bias = load64(b + co * 8); }
            var oh = 0;
            while (oh < OH) {
                var ih0 = oh * SH - PH;       # SH is free; only SW is 1 here
                var kh_lo = _conv_lo(ih0);
                var kh_hi = _conv_hi(ih0, KH, H);
                var yrow = y + (((n * Cout + co) * OH + oh) * OW) * 8;
                var c0 = 0;
                while (c0 < OW) {
                    var c1 = c0 + 128;
                    if (c1 > OW) { c1 = OW; }
                    var j = 0;
                    while (j < c1 - c0) { store64(&acc + j * 8, bias); j = j + 1; }
                    var xc = xn;
                    var wc = wco;
                    var ci = 0;
                    while (ci < Cin) {
                        var kh = kh_lo;
                        while (kh < kh_hi) {
                            var xrow = xc + (ih0 + kh) * W * 8;
                            var wr = wc + kh * KW * 8;
                            var kw = 0;
                            while (kw < KW) {
                                var wv = load64(wr + kw * 8);
                                var lo = PW - kw;             # input column ow − PW + kw >= 0
                                if (lo < c0) { lo = c0; }
                                var hi = W + PW - kw;         # ... and < W
                                if (hi > c1) { hi = c1; }
                                if (lo < hi) {
                                    var cnt = hi - lo;
                                    var c2 = cnt - (cnt % 2);
                                    var src = xrow + (lo - PW + kw) * 8;
                                    var dst = &acc + (lo - c0) * 8;
                                    f64v_scale(&tmp, src, wv, c2);
                                    f64v_add(dst, dst, &tmp, c2);
                                    if (c2 < cnt) {
                                        store64(dst + c2 * 8, f64_add(load64(dst + c2 * 8),
                                            f64_mul(load64(src + c2 * 8), wv)));
                                    }
                                }
                                kw = kw + 1;
                            }
                            kh = kh + 1;
                        }
                        xc = xc + xstride;
                        wc = wc + wstride;
                        ci = ci + 1;
                    }
                    j = 0;
                    while (j < c1 - c0) { store64(yrow + (c0 + j) * 8, load64(&acc + j * 8)); j = j + 1; }
                    c0 = c1;
                }
                oh = oh + 1;
            }
            co = co + 1;
        }
        n = n + 1;
    }
    return 0;
}

# y(N,Cout,OH,OW) = x ⊛ Wf [+ b]; b == 0 means no bias.
fn conv2d_fwd(x, Wf, b, y, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW): i64 {
    var OH = conv2d_out_dim(H, KH, SH, PH);
    var OW = conv2d_out_dim(W, KW, SW, PW);
    if (SW == 1) { return _conv2d_fwd_s1(x, Wf, b, y, N, Cin, H, W, Cout, KH, KW, SH, PH, PW, OH, OW); }
    var xstride = H * W * 8;          # bytes per input channel plane
    var wstride = KH * KW * 8;        # bytes per filter channel plane
    var yp = y;                       # y is written in (n, co, oh, ow) order
    var n = 0;
    while (n < N) {
        var xn = x + n * Cin * xstride;
        var co = 0;
        while (co < Cout) {
            var wco = Wf + co * Cin * wstride;
            var bias = f64_from(0);
            if (b != 0) { bias = load64(b + co * 8); }
            var oh = 0;
            while (oh < OH) {
                var ih0 = oh * SH - PH;
                var kh_lo = _conv_lo(ih0);
                var kh_hi = _conv_hi(ih0, KH, H);
                var ow = 0;
                while (ow < OW) {
                    var iw0 = ow * SW - PW;
                    var kw_lo = _conv_lo(iw0);
                    var kw_hi = _conv_hi(iw0, KW, W);
                    var acc = bias;
                    var xc = xn;
                    var wc = wco;
                    var ci = 0;
                    while (ci < Cin) {
                        var kh = kh_lo;
                        while (kh < kh_hi) {
                            var xr = xc + ((ih0 + kh) * W + iw0) * 8;   # x[n, ci, ih0+kh, iw0 + ·]
                            var wr = wc + kh * KW * 8;                  # Wf[co, ci, kh, ·]
                            var kw = kw_lo;
                            while (kw < kw_hi) {
                                acc = f64_add(acc, f64_mul(load64(xr + kw * 8), load64(wr + kw * 8)));
                                kw = kw + 1;
                            }
                            kh = kh + 1;
                        }
                        xc = xc + xstride;
                        wc = wc + wstride;
                        ci = ci + 1;
                    }
                    store64(yp, acc);
                    yp = yp + 8;
                    ow = ow + 1;
                }
                oh = oh + 1;
            }
            co = co + 1;
        }
        n = n + 1;
    }
    return 0;
}

# conv2d_bwd for SW == 1 (dx already zeroed by the caller). The scalar loops add
# into each gradient element in a fixed order, and this keeps every order:
#   db[co]          += dy over (n, oh, ow) ascending — a scalar running sum.
#   dW[co,ci,kh,kw] += x·dy over (n, oh, ow) ascending. A sequential chain, so the
#                      adds stay scalar; only the products are packed (f64v_mul,
#                      x·g in the scalar's operand order, one rounding each).
#   dx[n,ci,ih,iw]  += w·dy over (co, oh, ow) ascending. Within one (co, oh) row
#                      the contributing taps are ow = iw + PW − kw, so walking kw
#                      DOWN visits ow UP; each run is then tmp = dy·w (f64v_scale)
#                      and dx += tmp (f64v_add), a single rounding each.
# So every value is bit-identical to the scalar loops, except that a NaN made
# from two NaN operands may carry the other operand's payload (dy·w for w·dy).
fn _conv2d_bwd_s1(x, Wf, dy, dx, dW, db, N, Cin, H, W, Cout, KH, KW, SH, PH, PW, OH, OW): i64 {
    var tmp[1024];                    # 128 f64 products (bytes, fn-local)
    var xstride = H * W * 8;
    var wstride = KH * KW * 8;
    var n = 0;
    while (n < N) {
        var xoff_n = n * Cin * xstride;   # byte offset of x[n] / dx[n]
        var co = 0;
        while (co < Cout) {
            var woff_co = co * Cin * wstride;   # byte offset of Wf[co] / dW[co]
            var oh = 0;
            while (oh < OH) {
                var ih0 = oh * SH - PH;
                var kh_lo = _conv_lo(ih0);
                var kh_hi = _conv_hi(ih0, KH, H);
                var dyrow = dy + (((n * Cout + co) * OH + oh) * OW) * 8;
                if (db != 0) {
                    var bacc = load64(db + co * 8);
                    var j = 0;
                    while (j < OW) { bacc = f64_add(bacc, load64(dyrow + j * 8)); j = j + 1; }
                    store64(db + co * 8, bacc);
                }
                var c0 = 0;
                while (c0 < OW) {
                    var c1 = c0 + 128;
                    if (c1 > OW) { c1 = OW; }
                    var xc = xoff_n;
                    var wc = woff_co;
                    var ci = 0;
                    while (ci < Cin) {
                        var kh = kh_lo;
                        while (kh < kh_hi) {
                            var roff = xc + (ih0 + kh) * W * 8;   # x / dx row (ih0 + kh)
                            var toff = wc + kh * KW * 8;          # Wf / dW row kh
                            var kw = KW - 1;
                            while (kw >= 0) {
                                var lo = PW - kw;
                                if (lo < c0) { lo = c0; }
                                var hi = W + PW - kw;
                                if (hi > c1) { hi = c1; }
                                if (lo < hi) {
                                    var cnt = hi - lo;
                                    var c2 = cnt - (cnt % 2);
                                    var col = roff + (lo - PW + kw) * 8;
                                    var gs = dyrow + lo * 8;
                                    f64v_mul(&tmp, x + col, gs, c2);
                                    if (c2 < cnt) {
                                        store64(&tmp + c2 * 8, f64_mul(load64(x + col + c2 * 8), load64(gs + c2 * 8)));
                                    }
                                    var wacc = load64(dW + toff + kw * 8);
                                    var t = 0;
                                    while (t < cnt) { wacc = f64_add(wacc, load64(&tmp + t * 8)); t = t + 1; }
                                    store64(dW + toff + kw * 8, wacc);
                                    if (dx != 0) {
                                        var wv = load64(Wf + toff + kw * 8);
                                        var ds = dx + col;
                                        f64v_scale(&tmp, gs, wv, c2);
                                        f64v_add(ds, ds, &tmp, c2);
                                        if (c2 < cnt) {
                                            store64(ds + c2 * 8, f64_add(load64(ds + c2 * 8),
                                                f64_mul(wv, load64(gs + c2 * 8))));
                                        }
                                    }
                                }
                                kw = kw - 1;
                            }
                            kh = kh + 1;
                        }
                        xc = xc + xstride;
                        wc = wc + wstride;
                        ci = ci + 1;
                    }
                    c0 = c1;
                }
                oh = oh + 1;
            }
            co = co + 1;
        }
        n = n + 1;
    }
    return 0;
}

# Given dy(N,Cout,OH,OW): write dx(N,Cin,H,W); accumulate dW(Cout,Cin,KH,KW),
# db(Cout). db may be 0 (no bias grad); dx may be 0 (skip the input gradient).
fn conv2d_bwd(x, Wf, dy, dx, dW, db, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW): i64 {
    var OH = conv2d_out_dim(H, KH, SH, PH);
    var OW = conv2d_out_dim(W, KW, SW, PW);
    if (dx != 0) { t_zero(dx, N * Cin * H * W); }
    if (SW == 1) { return _conv2d_bwd_s1(x, Wf, dy, dx, dW, db, N, Cin, H, W, Cout, KH, KW, SH, PH, PW, OH, OW); }
    var xstride = H * W * 8;
    var wstride = KH * KW * 8;
    var dyp = dy;                     # dy is read in (n, co, oh, ow) order
    var n = 0;
    while (n < N) {
        var xoff_n = n * Cin * xstride;   # byte offset of x[n] (and of dx[n])
        var co = 0;
        while (co < Cout) {
            var woff_co = co * Cin * wstride;   # byte offset of Wf[co] (and of dW[co])
            var oh = 0;
            while (oh < OH) {
                var ih0 = oh * SH - PH;
                var kh_lo = _conv_lo(ih0);
                var kh_hi = _conv_hi(ih0, KH, H);
                var ow = 0;
                while (ow < OW) {
                    var iw0 = ow * SW - PW;
                    var kw_lo = _conv_lo(iw0);
                    var kw_hi = _conv_hi(iw0, KW, W);
                    var g = load64(dyp);
                    dyp = dyp + 8;
                    if (db != 0) {
                        store64(db + co * 8, f64_add(load64(db + co * 8), g));
                    }
                    var xc = xoff_n;
                    var wc = woff_co;
                    var ci = 0;
                    while (ci < Cin) {
                        var kh = kh_lo;
                        while (kh < kh_hi) {
                            var xr = xc + ((ih0 + kh) * W + iw0) * 8;
                            var wr = wc + kh * KW * 8;
                            var kw = kw_lo;
                            while (kw < kw_hi) {
                                var xi = xr + kw * 8;
                                var wi = wr + kw * 8;
                                store64(dW + wi,
                                  f64_add(load64(dW + wi), f64_mul(load64(x + xi), g)));
                                if (dx != 0) {
                                    store64(dx + xi,
                                      f64_add(load64(dx + xi), f64_mul(load64(Wf + wi), g)));
                                }
                                kw = kw + 1;
                            }
                            kh = kh + 1;
                        }
                        xc = xc + xstride;
                        wc = wc + wstride;
                        ci = ci + 1;
                    }
                    ow = ow + 1;
                }
                oh = oh + 1;
            }
            co = co + 1;
        }
        n = n + 1;
    }
    return 0;
}

# ---- conv1d: the H=1 specialization (audio stems, sequence convs) ------------
# x(N,Cin,L), Wf(Cout,Cin,K), y(N,Cout,OL) — exact wrappers over conv2d with
# H = KH = 1 and NO padding/stride on the dummy axis (bit-identical to the 2D
# path by construction).
fn conv1d_fwd(x, Wf, b, y, N, Cin, L, Cout, K, S, P): i64 {
    return conv2d_fwd(x, Wf, b, y, N, Cin, 1, L, Cout, 1, K, 1, S, 0, P);
}

# conv1d backward: conv2d_bwd with H = KH = 1 (dx written, dW / db accumulated).
fn conv1d_bwd(x, Wf, dy, dx, dW, db, N, Cin, L, Cout, K, S, P): i64 {
    return conv2d_bwd(x, Wf, dy, dx, dW, db, N, Cin, 1, L, Cout, 1, K, 1, S, 0, P);
}
