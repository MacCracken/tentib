# Requires (compile-verified; the leaves of dist/tentib.deps):
include "lib/math.cyr"

# --- ternary.cyr ---

# tentib — ternary quantization core (M0).
#
# The BitNet b1.58 weight quantizer and the matmul-free signed-accumulate dot,
# on raw f64. A weight is quantized to {-1, 0, +1} (log2(3) ~ 1.58 bits), so the
# weight*activation path has NO multiply left — only add / subtract / skip. This
# is attn11's everything-is-i64 thesis applied to the weights themselves.
#
# f64 values live as i64 bit patterns (the sovereign convention); arrays are
# 8-byte slots indexed the rosnet way: load64(p + i*8) / store64(p + i*8, v).

# Element i of a flat f64 tensor (its i64 bit pattern).
fn tload(p, i): i64 { return load64(p + i * 8); }
# Store the f64 bit pattern v as element i of a flat tensor.
fn tstore(p, i, v): i64 { store64(p + i * 8, v); return 0; }

# Write a NUL-terminated string to stderr (fd 2). Library code reports through
# this, not through a consumer-defined puts / _putc on stdout (1.1.2).
fn _tentib_err(s): i64 {
    var n = 0;
    while (load8(s + n) != 0) { n = n + 1; }
    sys_write(2, s, n);
    return 0;
}

# Fail-loud precondition guard (the tarka convention): Cyrius has no bounds
# checks, so a violated public-API precondition means silent heap corruption or
# silently-wrong numerics — print and stop instead. Cold paths only (pack-time /
# call-entry); never inside a hot loop. 0.8.0 hardening; since 1.1.2 the message
# goes to stderr and the exit status is 1.
fn guard(cond, msg): i64 {
    if (cond == 1) { return 0; }
    _tentib_err("tentib guard: "); _tentib_err(msg); _tentib_err("\n");
    sys_exit(1);
    return 0;
}

# 1 when each of the n i64 ids at ids[0..n) lies in [0, V), else 0. Token and
# target ids are DATA (a tokenized corpus, a serving prompt) that every
# whole-model path uses as a row offset, so they are checked at call entry —
# O(n) per call, never inside a kernel loop (1.1.2).
fn _ids_in_range(ids, n, V): i64 {
    var i = 0;
    while (i < n) {
        var v = load64(ids + i * 8);
        if (v < 0) { return 0; }
        if (v >= V) { return 0; }
        i = i + 1;
    }
    return 1;
}

# absmean scale gamma = mean(|w_i|) — the b1.58 per-tensor ternary scale.
# An empty tensor (n <= 0) has gamma = +0, the "all-zero tensor" value that
# ternary_one maps to 0; it used to return 0/0 = NaN (1.1.2).
fn absmean(w, n): i64 {
    if (n <= 0) { return f64_from(0); }
    var s = f64_from(0);
    var i = 0;
    while (i < n) {
        s = f64_add(s, f64_abs(load64(w + i * 8)));     # sequential: the sum's bits depend on order
        i = i + 1;
    }
    return f64_div(s, f64_from(n));
}

# quantize one weight to a ternary integer in {-1, 0, +1}:
#   clip(round(w / gamma), -1, +1)
# gamma == 0 (an all-zero tensor) => 0: w/0 is Inf/NaN, whose f64_to is INT_MIN,
# which the clip turned into -1 — an all-zero vector silently quantized to all
# -1 (0.8.0 audit fix). The b1.58 semantic is gamma==0 <=> every weight is 0.
fn ternary_one(w, gamma): i64 {
    if (f64_eq(gamma, f64_from(0)) == 1) { return 0; }
    var r = f64_to(f64_round(f64_div(w, gamma)));
    if (r > 1) { r = 1; }
    if (r < (0 - 1)) { r = 0 - 1; }
    return r;
}

# quantize a weight vector w[n] (f64) into tw[n] (i64 ternary). Returns gamma
# (f64 bits) — the scale that reconstructs the weight as ~ gamma * ternary.
fn ternary_quantize(w, n, tw): i64 {
    var g = absmean(w, n);
    var i = 0;
    while (i < n) {
        tstore(tw, i, ternary_one(tload(w, i), g));
        i = i + 1;
    }
    return g;
}

# matmul-free dot: sum over i of (tw==+1 ? +x : tw==-1 ? -x : skip), then * gamma.
# The accumulate has NO f64 multiply — only add / subtract / skip. Reconstructs
# the dequantized W . x (the matmul-free claim, made concrete).
fn ternary_dot(tw, x, n, gamma): i64 {
    var acc = f64_from(0);
    var i = 0;
    while (i < n) {
        var t = tload(tw, i);
        if (t == 1) { acc = f64_add(acc, tload(x, i)); }
        if (t == (0 - 1)) { acc = f64_sub(acc, tload(x, i)); }
        i = i + 1;
    }
    return f64_mul(acc, gamma);
}

# full-precision reference dot W . x (with f64 multiplies) — the baseline the
# matmul-free path is judged against.
fn ref_dot(w, x, n): i64 {
    var acc = f64_from(0);
    var i = 0;
    while (i < n) {
        acc = f64_add(acc, f64_mul(tload(w, i), tload(x, i)));
        i = i + 1;
    }
    return acc;
}

# --- bitlinear.cyr ---

# tentib — BitLinear (M1): a BitNet b1.58 quantization wrapper around rosnet's
# plain f64 matmul. Weights quantize to ternary {-1,0,+1} via a per-tensor absmean
# scale gamma; the forward runs on the DEQUANTIZED effective weight Weff = gamma*Wq
# through rosnet's linear_fwd, so y is numerically identical (up to f64 rounding) to
# the matmul-free packed kernel (M2) while reusing the exact (M,K,N) layout the
# gradient is checked against. The STE backward re-routes the quantizer's gradient
# straight through to the LATENT weight.
#
# THE STE, precisely. The weight path is  W -> r=W/gamma -> round -> clip -> Wq
# -> Weff=gamma*Wq.  With gamma DETACHED (stop-gradient) and round'/clip-interior
# STE'd to 1, the chain dWeff/dW = gamma*(1/gamma)*mask = mask: the gamma (from
# Weff=gamma*Wq) and the 1/gamma (from r=W/gamma) EXACTLY CANCEL, so dW carries NO
# gamma factor — only the clip-mask (zero where |W/gamma|>=1). That cancellation is
# exactly why the analytic dW equals the gradient of the un-quantized (plain-linear-
# in-latent-W) surrogate, which is what the finite-difference gate validates. You
# cannot FD through round/clip (flat between steps, undefined at them); you FD the
# SURROGATE. Keeping a gamma factor would fail the gate by exactly gamma.
#
# Depends, in the includer's scope and IN THIS ORDER: src/ternary.cyr (absmean,
# ternary_one, tload, tstore) then lib/rosnet.cyr (t_alloc, t_zero, linear_fwd,
# linear_bwd, f64_is_finite). bitlinear.cyr self-includes nothing to avoid a
# double-include of ternary.cyr in the test/main consumers.

# ---- forward ---------------------------------------------------------------

# Dequantize latent weight W(K*N) -> ternary Wq + effective Weff = gamma*Wq.
# Returns gamma (f64 bits). gamma==0 (fresh / all-zero init W) guard: zero both,
# skip the divide (never divide by zero); the backward mask then contributes nothing.
fn bl_weight_effective(W, KN, Wq, Weff): i64 {
    var g = absmean(W, KN);
    if (f64_eq(g, f64_from(0)) == 1) {
        var i = 0;
        while (i < KN) { tstore(Wq, i, 0); tstore(Weff, i, f64_from(0)); i = i + 1; }
        return f64_from(0);
    }
    # The loop is ternary_one inlined (g != 0 here, so its per-weight gamma == 0 test
    # is dead) plus a 3-entry table of the dequantized values: Weff = q*g for q in
    # {-1, 0, +1} is the same f64_mul whether it runs per weight or once up front, so
    # the bits are the same (1.1.2; golden-dump verified).
    var tab[24];
    store64(&tab, f64_mul(f64_from(0 - 1), g));
    store64(&tab + 8, f64_mul(f64_from(0), g));
    store64(&tab + 16, f64_mul(f64_from(1), g));
    var i = 0;
    while (i < KN) {
        var q = f64_to(f64_round(f64_div(load64(W + i * 8), g)));   # clip(round(W/g),-1,+1)
        if (q > 1) { q = 1; }
        if (q < (0 - 1)) { q = 0 - 1; }
        store64(Wq + i * 8, q);
        store64(Weff + i * 8, load64(&tab + (q + 1) * 8));        # gamma*Wq, dequantized
        i = i + 1;
    }
    return g;
}

# Weight-only BitLinear forward (M1 first cut, no activation quant): y = x @ Weff + b.
# Returns gamma (needed by the backward STE mask). Wq/Weff are caller-allocated
# scratch buffers of K*N f64 slots each. Pass b = 0 for no bias.
fn bl_forward_wonly(x, W, b, y, M, K, N, Wq, Weff): i64 {
    var g = bl_weight_effective(W, K * N, Wq, Weff);
    linear_fwd(x, Weff, b, y, M, K, N);
    return g;
}

# ---- backward (STE) --------------------------------------------------------

# STE weight clip-mask: dW += dWeff where |W/gamma| < 1 (unsaturated), else nothing
# (saturated entries are pinned at +-gamma -> no gradient signal). NO gamma factor
# (gamma cancels, see header). dW ACCUMULATES (caller zeroes it once per step).
# gamma==0 short-circuits (|W/gamma| is Inf/NaN, and dWeff is ~0 anyway): add nothing.
fn bl_ste_mask_w(W, dWeff, dW, KN, gamma): i64 {
    if (f64_eq(gamma, f64_from(0)) == 1) { return 0; }
    var one = f64_from(1);
    var i = 0;
    while (i < KN) {
        if (f64_lt(f64_abs(f64_div(load64(W + i * 8), gamma)), one) == 1) {
            store64(dW + i * 8, f64_add(load64(dW + i * 8), load64(dWeff + i * 8)));
        }
        i = i + 1;
    }
    return 0;
}

# Weight-only BitLinear backward, given upstream dy(M*N).
#   dx  = dy . (Weff)^T   — flows through the REAL forward weight Weff (NOT latent W)
#   dW  = (x^T . dy) clip-masked to the latent W   — the STE
#   db  = sum_m dy        — identity (linear_bwd accumulates it)
# dWeff_scratch (K*N) receives linear_bwd's raw dW=x^T.dy and MUST be t_zero'd first
# (linear_bwd accumulates). dW/db are caller-zeroed once per step; dx is written fresh.
# Passing Weff (not latent W) is load-bearing: latent W silently corrupts dx while dW
# still passes — the dx gate catches that.
fn bl_backward_wonly(x, Weff, dy, dx, dW, db, M, K, N, W, gamma, dWeff_scratch): i64 {
    t_zero(dWeff_scratch, K * N);
    linear_bwd(x, Weff, dy, dx, dWeff_scratch, db, M, K, N);
    bl_ste_mask_w(W, dWeff_scratch, dW, K * N, gamma);
    return 0;
}

# ---- losses for the finite-difference gate ---------------------------------

# Full quantized forward loss = 1/2 * sum y^2, y = x @ Weff(W) with gamma + round/clip
# RECOMPUTED live each call. This is the FALSIFIER target: FD through it must DIVERGE
# from the analytic STE dW (perturbing W barely moves Weff except through gamma, so the
# true quantized gradient differs from the surrogate the STE follows).
fn bl_quant_loss_wonly(x, W, b, M, K, N, Wq, Weff, y): i64 {
    bl_forward_wonly(x, W, b, y, M, K, N, Wq, Weff);
    var acc = f64_from(0);
    var i = 0; var MN = M * N;
    while (i < MN) { var v = tload(y, i); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# Loss as a function of x with Weff FIXED: 1/2 * sum (x @ Weff)^2. The forward is
# smooth (linear) in x, so FD of this wrt x exactly matches the analytic dx. Used by
# the dx gate (Weff is passed in, NOT recomputed — x-perturbation never re-quantizes W).
fn bl_loss_of_x(x, Weff, M, K, N, yscr): i64 {
    linear_fwd(x, Weff, 0, yscr, M, K, N);
    var acc = f64_from(0);
    var i = 0; var MN = M * N;
    while (i < MN) { var v = tload(yscr, i); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# The STE SURROGATE loss, linearized: L_lin(W) = <dy_frozen, x @ W>, raw latent W,
# dy_frozen held constant (= the quantized output at the operating point). Its gradient
# dL_lin/dW = x^T . dy_frozen is EXACTLY the analytic STE dW (before masking). FD of
# this (smooth, linear in W) is what the dW gate checks the analytic STE dW against.
# (With activation quant on, pass x = the FROZEN quantized activations x_eff.)
fn bl_surr_lin_loss(x, W, dyf, M, K, N, yscr): i64 {
    linear_fwd(x, W, 0, yscr, M, K, N);
    var acc = f64_from(0);
    var i = 0; var MN = M * N;
    while (i < MN) { acc = f64_add(acc, f64_mul(tload(dyf, i), tload(yscr, i))); i = i + 1; }
    return acc;
}

# ---- activation int8 quant (the second quantizer; completes b1.58) ---------

# Per-token (per-ROW, since each row of x is one token's K-vector) absmax int8 quant.
# xeff = round(x * 127/absmax) clamped to [-127,+127], times s = absmax/127 (dequant).
# sx[m] = s (the per-row scale, kept for the backward activation STE mask). The clamp
# is SYMMETRIC (+-127, NOT -128) so s is a symmetric reciprocal. absmax==0 (zero token
# row) guard: s=0, xeff row=0 (skip 127/0 = Inf).
#
# The absmax compares f64_abs bit patterns as integers. For non-negative doubles the
# i64 order of the bits IS the numeric order (+0 < subnormals < normals < +Inf), so
# every NaN-free row gets the same absmax bits as an f64_gt compare. A NaN's bits sort
# above +Inf, so a NaN in the row becomes the absmax and the row's scale is NaN, where
# f64_gt skipped it. act_quant_int (kernel.cyr) uses the same rule (1.1.2).
fn bl_act_quant(x, M, K, xeff, sx): i64 {
    var m = 0;
    while (m < M) {
        var a = f64_from(0); var k = 0;
        while (k < K) { var v = f64_abs(tload(x, m * K + k)); if (v > a) { a = v; } k = k + 1; }
        if (f64_eq(a, f64_from(0)) == 1) {
            tstore(sx, m, f64_from(0));
            k = 0;
            while (k < K) { tstore(xeff, m * K + k, f64_from(0)); k = k + 1; }
        } else {
            var s = f64_div(a, f64_from(127));
            tstore(sx, m, s);
            var inv = f64_div(f64_from(127), a);
            k = 0;
            while (k < K) {
                var q = f64_round(f64_mul(tload(x, m * K + k), inv));
                if (f64_gt(q, f64_from(127)) == 1) { q = f64_from(127); }
                if (f64_lt(q, f64_from(0 - 127)) == 1) { q = f64_from(0 - 127); }
                tstore(xeff, m * K + k, f64_mul(q, s));
                k = k + 1;
            }
        }
        m = m + 1;
    }
    return 0;
}

# Activation STE clip-mask: zero dx where the int8 quant saturated, i.e. where the
# forward's clamp changed the code: |round(x/s)| > 127, which is |x/s| >= 127.5 under
# either rounding rule (127.5 rounds to 128 half-away AND half-even). s==0 row -> skip.
# With s from bl_act_quant's per-row absmax nothing saturates (|x| <= absmax puts
# |x/s| at most 127 plus rounding), so the mask is the identity there and only bites
# for a caller-supplied smaller scale. Until 1.1.2 the test was |x/s| > 127, and at
# the row's max element a/(a/127) rounds to 127.00000000000001 for about 14% of
# absmax values (a = 1.1, 2.2, 0.01, ...): that zeroed the max element's gradient
# although the forward never clamped it.
fn bl_ste_mask_x(dx, x, M, K, sx): i64 {
    var lim = f64_div(f64_from(255), f64_from(2));    # 127.5, exact
    var m = 0;
    while (m < M) {
        var s = tload(sx, m);
        if (f64_eq(s, f64_from(0)) == 0) {
            var k = 0;
            while (k < K) {
                if (f64_ge(f64_abs(f64_div(tload(x, m * K + k), s)), lim) == 1) {
                    tstore(dx, m * K + k, f64_from(0));
                }
                k = k + 1;
            }
        }
        m = m + 1;
    }
    return 0;
}

# Full BitLinear forward (b1.58): ternary weights AND int8 activations.
# y = x_eff @ W_eff + b, with both scales baked into the dequantized operands (no
# trailing rescale). Returns gamma. Backward: bl_backward_wonly(xeff, Weff, ...) then
# bl_ste_mask_x(dx, x_real, M, K, sx) — dW = xeff^T.dy masked, dx through Weff masked.
fn bl_forward_full(x, W, b, y, M, K, N, Wq, Weff, xeff, sx): i64 {
    var g = bl_weight_effective(W, K * N, Wq, Weff);
    bl_act_quant(x, M, K, xeff, sx);
    linear_fwd(xeff, Weff, b, y, M, K, N);
    return g;
}

# --- layers.cyr ---

# tentib — differentiable layers (M2). RMSNorm now; GELU (bite-C), attention
# (bite-D) follow here. Pure f64 array math (load64/store64 + f64 builtins) — no
# rosnet linear needed. Depends only on f64 builtins being in scope.
#
# RMSNorm (Zhang & Sennrich 2019, arXiv:1910.07467) — the BitNet/Llama pre-norm:
# no mean-subtraction, no bias.  y[i] = x[i] * rstd * g[i],  rstd = 1/sqrt(mean(x^2)+eps).
# It is exactly LayerNorm without the centering term, so the backward is attn11's
# ln_bwd MINUS the mean(dxhat) term:
#   dxhat = dy*g ; xhat = x*rstd
#   dx[j] = rstd * (dxhat[j] - xhat[j] * mean_i(dxhat[i]*xhat[i]))
#   dg[j] = dy[j] * xhat[j]

# f64_exp (GELU's tanh, the attention softmax) runs lib/math.cyr's polyfill on aarch64,
# so this module includes it: the dist/tentib.cyr bundle then compiles on every target
# from its own requires block (1.3.0). tentib's own builds prepend it anyway.
include "lib/math.cyr"

fn _rms_eps(): i64 { return f64_div(f64_from(1), f64_from(100000)); }   # 1e-5

# Forward over a single D-vector. Returns rstd (cache it for the backward).
fn rmsnorm_fwd(x, g, y, D): i64 {
    var ss = f64_from(0);
    var i = 0;
    while (i < D) { var v = load64(x + i * 8); ss = f64_add(ss, f64_mul(v, v)); i = i + 1; }
    var ms = f64_div(ss, f64_from(D));
    var rstd = f64_div(f64_from(1), f64_sqrt(f64_add(ms, _rms_eps())));
    i = 0;
    while (i < D) {
        store64(y + i * 8, f64_mul(f64_mul(load64(x + i * 8), rstd), load64(g + i * 8)));
        i = i + 1;
    }
    return rstd;
}

# Backward. dx written FRESH; dg ACCUMULATES (+=, caller-zeroed — the gain is a
# trained parameter summed over the batch). rstd is the value returned by the fwd.
fn rmsnorm_bwd(x, g, dy, dx, dg, D, rstd): i64 {
    var mdx = f64_from(0);   # mean_i(dxhat[i] * xhat[i])
    var i = 0;
    while (i < D) {
        var dxh = f64_mul(load64(dy + i * 8), load64(g + i * 8));
        var xh = f64_mul(load64(x + i * 8), rstd);
        mdx = f64_add(mdx, f64_mul(dxh, xh));
        i = i + 1;
    }
    mdx = f64_div(mdx, f64_from(D));
    i = 0;
    while (i < D) {
        var dxh2 = f64_mul(load64(dy + i * 8), load64(g + i * 8));
        var xh2 = f64_mul(load64(x + i * 8), rstd);
        store64(dx + i * 8, f64_mul(rstd, f64_sub(dxh2, f64_mul(xh2, mdx))));
        store64(dg + i * 8, f64_add(load64(dg + i * 8), f64_mul(load64(dy + i * 8), xh2)));
        i = i + 1;
    }
    return 0;
}

# 1/2 * ||rmsnorm(x,g)||^2 — the scalar the FD gate differentiates (dy = y).
fn rms_loss(x, g, D, yscr): i64 {
    rmsnorm_fwd(x, g, yscr, D);
    var acc = f64_from(0);
    var i = 0;
    while (i < D) { var v = load64(yscr + i * 8); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# ---- GELU (tanh approximation; Hendrycks & Gimpel 2016) --------------------
# gelu(x) = 0.5*x*(1 + tanh(c*(x + a*x^3))), c = sqrt(2/pi), a = 0.044715.
# Ported from attn11/src/ops.cyr (GPU branches dropped). The MLP nonlinearity.

# tanh from f64_exp (f64_tanh is not a builtin in this toolchain). Stable form:
# tanh(x) = sign(x) * (1 - e^(-2|x|)) / (1 + e^(-2|x|)), with e^(-2|x|) in (0,1].
fn _tanh(x): i64 {
    var neg = (x >> 63) & 1;
    var e = f64_exp(f64_mul(f64_from(0 - 2), f64_abs(x)));
    var t = f64_div(f64_sub(f64_from(1), e), f64_add(f64_from(1), e));
    if (neg == 1) { return f64_neg(t); }
    return t;
}

fn _gelu_c(): i64 { return f64_div(f64_from(7978845608), f64_from(10000000000)); }  # sqrt(2/pi)
fn _gelu_a(): i64 { return f64_div(f64_from(44715), f64_from(1000000)); }           # 0.044715

# y[i] = gelu(x[i]) over n elements (tanh form).
fn gelu_fwd(x, y, n): i64 {
    var c = _gelu_c(); var a = _gelu_a();
    var half = f64_div(f64_from(1), f64_from(2)); var one = f64_from(1);
    var i = 0;
    while (i < n) {
        var xv = load64(x + i * 8);
        var x3 = f64_mul(f64_mul(xv, xv), xv);
        var t = _tanh(f64_mul(c, f64_add(xv, f64_mul(a, x3))));
        store64(y + i * 8, f64_mul(f64_mul(half, xv), f64_add(one, t)));
        i = i + 1;
    }
    return 0;
}

# dy -> dx (length n); needs the original x. dx = dy * d(gelu)/dx, written FRESH.
fn gelu_bwd(x, dy, dx, n): i64 {
    var c = _gelu_c(); var a = _gelu_a();
    var half = f64_div(f64_from(1), f64_from(2)); var one = f64_from(1); var three = f64_from(3);
    var i = 0;
    while (i < n) {
        var xv = load64(x + i * 8);
        var x2 = f64_mul(xv, xv);
        var x3 = f64_mul(x2, xv);
        var t = _tanh(f64_mul(c, f64_add(xv, f64_mul(a, x3))));
        var sech2 = f64_sub(one, f64_mul(t, t));                           # 1 - tanh^2
        var dinner = f64_mul(c, f64_add(one, f64_mul(f64_mul(three, a), x2)));
        var grad = f64_add(f64_mul(half, f64_add(one, t)),
          f64_mul(f64_mul(half, xv), f64_mul(sech2, dinner)));
        store64(dx + i * 8, f64_mul(load64(dy + i * 8), grad));
        i = i + 1;
    }
    return 0;
}

# 1/2 * ||gelu(x)||^2 — the scalar the FD gate differentiates (dy = y).
fn gelu_loss(x, n, yscr): i64 {
    gelu_fwd(x, yscr, n);
    var acc = f64_from(0);
    var i = 0;
    while (i < n) { var v = load64(yscr + i * 8); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# ---- single-head causal scaled-dot-product attention (M2 bite-D) -----------
# Q,K,V are T x d (row-major, one token per row). Causal: query i attends keys
# j = 0..i. score[i,j] = (Q[i].K[j]) / sqrt(d); P[i,:] = softmax over j<=i;
# ctx[i] = sum_j P[i,j] V[j]. Math cross-checked vs attn11/src/attn_core_fwd/bwd
# (single head, nh=1). P is T x T (the upper triangle stays 0).

# The 1/sqrt(d) score scale.
fn _attn_scale(d): i64 { return f64_div(f64_from(1), f64_sqrt(f64_from(d))); }

# One query row of the causal attention: query qb (d values) against keys and values
# K[0..i], V[0..i] (rows of d). Writes the probabilities prow[0..i] and the context
# cb[0..d). attn_fwd runs it for every row; the incremental decode step (1.4.0,
# src/decode.cyr) runs it for the newest position against its cached keys and values.
# One function for both is what keeps the step bit-identical to the full forward's row.
fn _attn_row(qb, K, V, prow, cb, i, d, scale): i64 {
    var j = 0;
    while (j <= i) {                                    # raw scaled scores, j = 0..i
        var kb = K + j * d * 8;
        var dot = f64_from(0); var dd = 0;
        while (dd < d) { dot = f64_add(dot, f64_mul(load64(qb + dd * 8), load64(kb + dd * 8))); dd = dd + 1; }
        store64(prow + j * 8, f64_mul(dot, scale));
        j = j + 1;
    }
    var mx = load64(prow); j = 1;                        # softmax over j = 0..i (max-subtract)
    while (j <= i) { var s = load64(prow + j * 8); if (f64_gt(s, mx) == 1) { mx = s; } j = j + 1; }
    var sum = f64_from(0); j = 0;
    while (j <= i) {
        var e = f64_exp(f64_sub(load64(prow + j * 8), mx));
        store64(prow + j * 8, e); sum = f64_add(sum, e); j = j + 1;
    }
    var inv = f64_div(f64_from(1), sum); j = 0;
    while (j <= i) { store64(prow + j * 8, f64_mul(load64(prow + j * 8), inv)); j = j + 1; }
    var c0 = 0;                                          # ctx[i] = sum_j P[i,j] V[j]
    while (c0 < d) { store64(cb + c0 * 8, f64_from(0)); c0 = c0 + 1; }
    j = 0;
    while (j <= i) {
        var pij = load64(prow + j * 8); var vb = V + j * d * 8; var cd = 0;
        while (cd < d) {
            store64(cb + cd * 8, f64_add(load64(cb + cd * 8), f64_mul(pij, load64(vb + cd * 8))));
            cd = cd + 1;
        }
        j = j + 1;
    }
    return 0;
}

# Forward: writes the T x T probabilities P (zeroed first) and ctx (T x d).
fn attn_fwd(Q, K, V, P, ctx, T, d): i64 {
    var scale = _attn_scale(d);
    var Tsz = T * T; var z = 0;
    while (z < Tsz) { store64(P + z * 8, f64_from(0)); z = z + 1; }
    var i = 0;
    while (i < T) {
        _attn_row(Q + i * d * 8, K, V, P + i * T * 8, ctx + i * d * 8, i, d, scale);
        i = i + 1;
    }
    return 0;
}

# Backward: dctx(T,d) -> dQ,dK,dV (T,d, all written fresh/zeroed inside). dprow is a
# T-length per-row softmax-gradient scratch. P is the forward's probabilities.
#   dP[i,j] = dctx[i].V[j] ; dV[j] += P[i,j] dctx[i]
#   ds[i,j] = P[i,j] (dP[i,j] - sum_k P[i,k] dP[i,k])   (softmax backward)
#   dQ[i] += scale ds[i,j] K[j] ; dK[j] += scale ds[i,j] Q[i]
fn attn_bwd(Q, K, V, P, dctx, dQ, dK, dV, dprow, T, d): i64 {
    var scale = f64_div(f64_from(1), f64_sqrt(f64_from(d)));
    var Td = T * d; var z = 0;
    while (z < Td) {
        store64(dQ + z * 8, f64_from(0)); store64(dK + z * 8, f64_from(0)); store64(dV + z * 8, f64_from(0));
        z = z + 1;
    }
    var i = 0;
    while (i < T) {
        var prow = P + i * T * 8;
        var dcb = dctx + i * d * 8;
        var j = 0;
        while (j <= i) {                                    # dP[i,j] + dV accumulation
            var pij = load64(prow + j * 8); var vb = V + j * d * 8; var dvb = dV + j * d * 8;
            var dpj = f64_from(0); var dd = 0;
            while (dd < d) {
                var dc = load64(dcb + dd * 8);
                dpj = f64_add(dpj, f64_mul(dc, load64(vb + dd * 8)));
                store64(dvb + dd * 8, f64_add(load64(dvb + dd * 8), f64_mul(pij, dc)));
                dd = dd + 1;
            }
            store64(dprow + j * 8, dpj);
            j = j + 1;
        }
        var dotPdP = f64_from(0); j = 0;                     # sum_k P[k] dP[k]
        while (j <= i) { dotPdP = f64_add(dotPdP, f64_mul(load64(prow + j * 8), load64(dprow + j * 8))); j = j + 1; }
        var dqb = dQ + i * d * 8; var qb = Q + i * d * 8; j = 0;
        while (j <= i) {
            var ds = f64_mul(load64(prow + j * 8), f64_sub(load64(dprow + j * 8), dotPdP));
            var sds = f64_mul(scale, ds);
            var kb = K + j * d * 8; var dkb = dK + j * d * 8; var dd2 = 0;
            while (dd2 < d) {
                store64(dqb + dd2 * 8, f64_add(load64(dqb + dd2 * 8), f64_mul(sds, load64(kb + dd2 * 8))));
                store64(dkb + dd2 * 8, f64_add(load64(dkb + dd2 * 8), f64_mul(sds, load64(qb + dd2 * 8))));
                dd2 = dd2 + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

# 1/2 * ||attn(Q,K,V)||^2 — the scalar the FD gate differentiates (dctx = ctx).
fn attn_loss(Q, K, V, T, d, Pscr, cscr): i64 {
    attn_fwd(Q, K, V, Pscr, cscr, T, d);
    var acc = f64_from(0); var i = 0; var Td = T * d;
    while (i < Td) { var v = load64(cscr + i * 8); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# --- model.cyr ---

# tentib — minimal trainable ternary LM (M2 bite-A).
#
# token id -> embedding row (FULL-PRECISION f64 table) -> BitLinear head (TERNARY,
# weight-only) -> softmax cross-entropy. Trains from scratch by SGD on the LATENT
# (full-precision shadow) head weight + the embedding, the head quantized only in
# the forward (the BitNet latent-weight training loop): you train a full-precision
# shadow weight and quantize it in the forward; the STE routes the gradient back to
# the shadow. Proves a ternary-weight model learns end-to-end via the M1 STE.
#
# Gradient provenance: the ONLY STE seam is the head weight (dW_head, clip-masked,
# no-gamma — see bitlinear.cyr). The loss gradient (dlogits), the embedding gradient
# (demb), the bias, and the embedding-table scatter are ALL exact full-precision.
# Embeddings stay full-precision: BitNet b1.58 ternarizes ONLY linear layers.
#
# f64_exp / f64_ln run lib/math.cyr's polyfills on aarch64 (see layers.cyr), so this
# module includes it too.
include "lib/math.cyr"

# softmax_xent_fwd/bwd are PORTED from attn11/src/ops.cyr (rosnet has no softmax).
# Depends, in the includer's scope and IN ORDER: src/ternary.cyr + lib/rosnet.cyr
# + src/bitlinear.cyr. Self-includes nothing.

# ---- softmax cross-entropy (ported from attn11 ops.cyr:217/254) ------------

# Forward: per row, max-subtract softmax into probs(M*V); returns mean NLL over M.
# targets(M) are RAW i64 class indices (load64, used as offset tgt*8) — NOT f64.
# A target outside [0, V) used to read past the probs row (silently-wrong loss);
# it fails loud since 1.1.2.
fn softmax_xent_fwd(logits, targets, probs, M, V): i64 {
    guard(_ids_in_range(targets, M, V), "softmax_xent_fwd: target id outside [0, V)");
    var total = f64_from(0);
    var m = 0;
    while (m < M) {
        var row = logits + m * V * 8;
        var prow = probs + m * V * 8;
        var mx = load64(row);
        var i = 1;
        while (i < V) { var lv = load64(row + i * 8); if (f64_gt(lv, mx) == 1) { mx = lv; } i = i + 1; }
        var sum = f64_from(0);
        i = 0;
        while (i < V) {
            var e = f64_exp(f64_sub(load64(row + i * 8), mx));
            store64(prow + i * 8, e);
            sum = f64_add(sum, e);
            i = i + 1;
        }
        var inv = f64_div(f64_from(1), sum);
        i = 0;
        while (i < V) { store64(prow + i * 8, f64_mul(load64(prow + i * 8), inv)); i = i + 1; }
        var tgt = load64(targets + m * 8);
        total = f64_sub(total, f64_ln(load64(prow + tgt * 8)));
        m = m + 1;
    }
    return f64_div(total, f64_from(M));
}

# Backward: dlogits(M*V) = (probs - onehot(targets)) / M. Consumes normalized probs.
# An out-of-range target used to drop the onehot term (silently-wrong gradient);
# it fails loud since 1.1.2.
fn softmax_xent_bwd(probs, targets, dlogits, M, V): i64 {
    guard(_ids_in_range(targets, M, V), "softmax_xent_bwd: target id outside [0, V)");
    var invM = f64_div(f64_from(1), f64_from(M));
    var m = 0;
    while (m < M) {
        var tgt = load64(targets + m * 8);
        var i = 0;
        while (i < V) {
            var g = load64(probs + (m * V + i) * 8);
            if (i == tgt) { g = f64_sub(g, f64_from(1)); }
            store64(dlogits + (m * V + i) * 8, f64_mul(g, invM));
            i = i + 1;
        }
        m = m + 1;
    }
    return 0;
}

# Quantized softmax-CE loss as a function of (embx, W_head): the full forward
# (W re-quantized live) + softmax cross-entropy. Used by the FD gates — FD over an
# embedding entry is EXACT (embx is the smooth input), FD over a head weight is the
# FALSIFIER (round/clip is flat between steps → diverges from the STE).
fn bl_xent_loss(embx, W, b, tgt_buf, D, V, Wq, Weff, logits, probs): i64 {
    bl_forward_wonly(embx, W, b, logits, 1, D, V, Wq, Weff);
    return softmax_xent_fwd(logits, tgt_buf, probs, 1, V);
}

# ---- minimal ternary LM (embedding + BitLinear head) -----------------------

# init: full-precision embedding + latent head ~ N(0, 0.1); zero bias.
fn lm_init(E, W_head, b_head, V, D, seed): i64 {
    rng_seed(seed);
    var std = f64_div(f64_from(1), f64_from(10));
    t_randn(E, V * D, std);
    t_randn(W_head, D * V, std);
    t_zero(b_head, V);
    return 0;
}

# mean cross-entropy over the whole alphabet on the successor bigram tgt=(x+1)%V.
fn lm_eval_sweep(E, W_head, b_head, V, D, logits, probs, tgt_buf, Wq, Weff): i64 {
    var acc = f64_from(0);
    var x = 0;
    while (x < V) {
        store64(tgt_buf, (x + 1) % V);
        bl_forward_wonly(E + x * D * 8, W_head, b_head, logits, 1, D, V, Wq, Weff);
        acc = f64_add(acc, softmax_xent_fwd(logits, tgt_buf, probs, 1, V));
        x = x + 1;
    }
    return f64_div(acc, f64_from(V));
}

# count tokens whose argmax prediction == the true successor (memorization metric).
fn lm_correct(E, W_head, b_head, V, D, logits, probs, tgt_buf, Wq, Weff): i64 {
    var n = 0;
    var x = 0;
    while (x < V) {
        bl_forward_wonly(E + x * D * 8, W_head, b_head, logits, 1, D, V, Wq, Weff);
        var best = 0; var bestv = load64(logits);
        var i = 1;
        while (i < V) {
            var lv = load64(logits + i * 8);
            if (f64_gt(lv, bestv) == 1) { bestv = lv; best = i; }
            i = i + 1;
        }
        if (best == ((x + 1) % V)) { n = n + 1; }
        x = x + 1;
    }
    return n;
}

# Train the ternary LM by SGD for `steps` over the full V-token sweep each step.
# Writes stats[0]=loss_initial, stats[1]=loss_final, stats[2]=argmax-correct (i64).
fn lm_train(V, D, steps, seed, stats): i64 {
    var VD = V * D; var DV = D * V;
    var E = t_alloc(VD); var W_head = t_alloc(DV); var b_head = t_alloc(V);
    var GE = t_alloc(VD); var GW = t_alloc(DV); var Gb = t_alloc(V);
    var logits = t_alloc(V); var probs = t_alloc(V); var dlogits = t_alloc(V);
    var demb = t_alloc(D); var Wq = t_alloc(DV); var Weff = t_alloc(DV); var scr = t_alloc(DV);
    var tgt_buf = t_alloc(1);

    lm_init(E, W_head, b_head, V, D, seed);
    store64(stats + 0, lm_eval_sweep(E, W_head, b_head, V, D, logits, probs, tgt_buf, Wq, Weff));

    var neg_lr = f64_div(f64_from(0 - 1), f64_from(10));   # -0.1
    var invV = f64_div(f64_from(1), f64_from(V));
    var s = 0;
    while (s < steps) {
        t_zero(GE, VD); t_zero(GW, DV); t_zero(Gb, V);
        var x = 0;
        while (x < V) {
            store64(tgt_buf, (x + 1) % V);
            var g = bl_forward_wonly(E + x * D * 8, W_head, b_head, logits, 1, D, V, Wq, Weff);
            softmax_xent_fwd(logits, tgt_buf, probs, 1, V);
            softmax_xent_bwd(probs, tgt_buf, dlogits, 1, V);
            bl_backward_wonly(E + x * D * 8, Weff, dlogits, demb, GW, Gb, 1, D, V, W_head, g, scr);
            t_add_into(GE + x * D * 8, demb, D);
            x = x + 1;
        }
        t_scale(GE, VD, invV); t_scale(GW, DV, invV); t_scale(Gb, V, invV);
        t_axpy(W_head, GW, neg_lr, DV);     # SGD on the LATENT head weight (re-quantized next fwd)
        t_axpy(E, GE, neg_lr, VD);          # full-precision embedding
        t_axpy(b_head, Gb, neg_lr, V);      # full-precision bias
        s = s + 1;
    }
    store64(stats + 8, lm_eval_sweep(E, W_head, b_head, V, D, logits, probs, tgt_buf, Wq, Weff));
    store64(stats + 16, lm_correct(E, W_head, b_head, V, D, logits, probs, tgt_buf, Wq, Weff));
    return 0;
}

# --- block.cyr ---

# tentib — transformer block assembly (M2 bite-E). Composes the FD-gated components
# (BitLinear STE, RMSNorm, GELU, attention) into a pre-norm block. E1 = the attention
# sublayer (BitLinear Q/K/V/O around the bare attn core + pre-norm + residual);
# E2 (MLP sublayer), E3 (full block), E4 (multi-token LM) follow.
#
# Scratch + forward caches are MODULE-GLOBAL (attn11 pattern), allocated once by
# blk_init(T,C) — this keeps the fwd/bwd signatures small and avoids per-call
# allocation (the bump allocator never frees, so FD-gate re-calls must reuse).
# Depends (includer order): ternary + bitlinear + layers in scope.
#
# Single head: head dim d = C, so P is T*T and Q/K/V/ctx are each T*C. The 4
# projection weights are passed as one contiguous arena W (4*C*C): Wq|Wk|Wv|Wo.

var blk_a = 0; var blk_Q = 0; var blk_K = 0; var blk_V = 0;
var blk_P = 0; var blk_ctx = 0; var blk_attn_out = 0; var blk_out = 0;
var blk_Wqq = 0; var blk_Wqe = 0; var blk_Wkq = 0; var blk_Wke = 0;
var blk_Wvq = 0; var blk_Wve = 0; var blk_Woq = 0; var blk_Woe = 0;
var blk_rstd = 0; var blk_gam = 0;
var blk_dctx = 0; var blk_dQ = 0; var blk_dK = 0; var blk_dV = 0; var blk_dprow = 0;
var blk_da = 0; var blk_dnorm = 0; var blk_dxq = 0; var blk_dxk = 0; var blk_dxv = 0;
var blk_dWeff = 0;
# MLP sublayer scratch/caches (Wup: C*F, Wdn: F*C; fc/gg: T*F pre/post-GELU)
var mlp_b2 = 0; var mlp_fc = 0; var mlp_gg = 0; var mlp_branch = 0; var mlp_out = 0;
var mlp_Wupq = 0; var mlp_Wupe = 0; var mlp_Wdnq = 0; var mlp_Wdne = 0;
var mlp_rstd2 = 0; var mlp_gam = 0;
var mlp_dgg = 0; var mlp_dfc = 0; var mlp_db2 = 0; var mlp_dnorm2 = 0; var mlp_dWeff = 0;
# block-level (E3): the inter-sublayer residual stream
var blk_xmid = 0; var blk_dxmid = 0;
# the dims blk_init sized the scratch for (0 = not initialized) — 1.1.2
var blk_T0 = 0; var blk_C0 = 0; var blk_F0 = 0;

# Allocate the block scratch + forward caches for sequences of up to T tokens at
# width C and MLP width F. Every later block call must use the same C and F and a
# T in [1, T] (checked at entry since 1.1.2).
fn blk_init(T, C, F): i64 {
    guard((T >= 1) & (C >= 1) & (F >= 1), "blk_init: T, C, F must be >= 1");
    blk_T0 = T; blk_C0 = C; blk_F0 = F;
    var TC = T * C; var CC = C * C; var TF = T * F; var CF = C * F;
    blk_a = t_alloc(TC); blk_Q = t_alloc(TC); blk_K = t_alloc(TC); blk_V = t_alloc(TC);
    blk_P = t_alloc(T * T); blk_ctx = t_alloc(TC); blk_attn_out = t_alloc(TC); blk_out = t_alloc(TC);
    blk_Wqq = t_alloc(CC); blk_Wqe = t_alloc(CC); blk_Wkq = t_alloc(CC); blk_Wke = t_alloc(CC);
    blk_Wvq = t_alloc(CC); blk_Wve = t_alloc(CC); blk_Woq = t_alloc(CC); blk_Woe = t_alloc(CC);
    blk_rstd = t_alloc(T); blk_gam = t_alloc(4);
    blk_dctx = t_alloc(TC); blk_dQ = t_alloc(TC); blk_dK = t_alloc(TC); blk_dV = t_alloc(TC); blk_dprow = t_alloc(T);
    blk_da = t_alloc(TC); blk_dnorm = t_alloc(TC); blk_dxq = t_alloc(TC); blk_dxk = t_alloc(TC); blk_dxv = t_alloc(TC);
    blk_dWeff = t_alloc(CC);
    mlp_b2 = t_alloc(TC); mlp_fc = t_alloc(TF); mlp_gg = t_alloc(TF); mlp_branch = t_alloc(TC); mlp_out = t_alloc(TC);
    mlp_Wupq = t_alloc(CF); mlp_Wupe = t_alloc(CF); mlp_Wdnq = t_alloc(CF); mlp_Wdne = t_alloc(CF);
    mlp_rstd2 = t_alloc(T); mlp_gam = t_alloc(2);
    mlp_dgg = t_alloc(TF); mlp_dfc = t_alloc(TF); mlp_db2 = t_alloc(TC); mlp_dnorm2 = t_alloc(TC);
    mlp_dWeff = t_alloc(CF);
    blk_xmid = t_alloc(TC); blk_dxmid = t_alloc(TC);
    return 0;
}

# Entry check for the public block calls: the scratch exists, C and F are the
# blk_init ones, and T fits. The scratch is sized by blk_init's dims, so a larger
# T, C or F would read and write past it (1.1.2).
fn _blk_dims(T, C, F): i64 {
    guard(blk_T0 != 0, "block: call blk_init (or tx_init) first");
    guard((C == blk_C0) & (F == blk_F0), "block: C, F differ from blk_init");
    guard((T >= 1) & (T <= blk_T0), "block: T outside [1, blk_init T]");
    return 0;
}

# Attention sublayer forward: blk_out = x + Oproj(attn(Qproj(a),Kproj(a),Vproj(a))),
# a = RMSNorm(x, g1). W is the 4*C*C weight arena (Wq|Wk|Wv|Wo). Caches everything
# the backward needs in module globals (blk_a/Q/K/V/P/ctx, the 4 Weff, blk_gam, blk_rstd).
fn attn_sublayer_fwd(x, g1, W, T, C): i64 {
    var TC = T * C; var CC = C * C;
    var Wq = W; var Wk = W + CC * 8; var Wv = W + 2 * CC * 8; var Wo = W + 3 * CC * 8;
    var t = 0;
    while (t < T) { store64(blk_rstd + t * 8, rmsnorm_fwd(x + t * C * 8, g1, blk_a + t * C * 8, C)); t = t + 1; }
    store64(blk_gam + 0,  bl_forward_wonly(blk_a, Wq, 0, blk_Q, T, C, C, blk_Wqq, blk_Wqe));
    store64(blk_gam + 8,  bl_forward_wonly(blk_a, Wk, 0, blk_K, T, C, C, blk_Wkq, blk_Wke));
    store64(blk_gam + 16, bl_forward_wonly(blk_a, Wv, 0, blk_V, T, C, C, blk_Wvq, blk_Wve));
    attn_fwd(blk_Q, blk_K, blk_V, blk_P, blk_ctx, T, C);
    store64(blk_gam + 24, bl_forward_wonly(blk_ctx, Wo, 0, blk_attn_out, T, C, C, blk_Woq, blk_Woe));
    t_copy(blk_out, x, TC); t_add_into(blk_out, blk_attn_out, TC);
    return 0;
}

# 1/2 ||blk_out||^2 — smooth in x (every quantizer is frozen under an x-perturbation:
# round/clip fire only on W-perturbation), so central FD of this wrt x is EXACT and
# equals the analytic dx — the end-to-end gate over the whole fwd+bwd chain.
fn attn_sublayer_loss(x, g1, W, T, C): i64 {
    attn_sublayer_fwd(x, g1, W, T, C);
    var acc = f64_from(0); var i = 0; var TC = T * C;
    while (i < TC) { var v = load64(blk_out + i * 8); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# The six projections here and in the MLP backward carry no bias, so they pass
# db = 0 and rosnet's linear_bwd skips the bias-gradient pass. Until 1.1.2 they
# passed scratch accumulators (blk_db / mlp_db) that were summed into and never read.
# Attention sublayer backward. dout = d(blk_out). dW is the 4*C*C grad arena (ACCUMULATES,
# STE); dg1 ACCUMULATES; dx fresh = dout (skip) + d(RMSNorm-through-branch). Caller zeroes
# dW + dg1 once per step. Uses the forward's module-global caches.
fn attn_sublayer_bwd(dout, x, g1, W, dx, dg1, dW, T, C): i64 {
    var TC = T * C; var CC = C * C;
    var Wq = W; var Wk = W + CC * 8; var Wv = W + 2 * CC * 8; var Wo = W + 3 * CC * 8;
    var dWq = dW; var dWk = dW + CC * 8; var dWv = dW + 2 * CC * 8; var dWo = dW + 3 * CC * 8;
    bl_backward_wonly(blk_ctx, blk_Woe, dout, blk_dctx, dWo, 0, T, C, C, Wo, load64(blk_gam + 24), blk_dWeff);
    attn_bwd(blk_Q, blk_K, blk_V, blk_P, blk_dctx, blk_dQ, blk_dK, blk_dV, blk_dprow, T, C);
    bl_backward_wonly(blk_a, blk_Wqe, blk_dQ, blk_dxq, dWq, 0, T, C, C, Wq, load64(blk_gam + 0), blk_dWeff);
    bl_backward_wonly(blk_a, blk_Wke, blk_dK, blk_dxk, dWk, 0, T, C, C, Wk, load64(blk_gam + 8), blk_dWeff);
    bl_backward_wonly(blk_a, blk_Wve, blk_dV, blk_dxv, dWv, 0, T, C, C, Wv, load64(blk_gam + 16), blk_dWeff);
    t_copy(blk_da, blk_dxq, TC); t_add_into(blk_da, blk_dxk, TC); t_add_into(blk_da, blk_dxv, TC);
    var t = 0;
    while (t < T) {
        var o1 = t * C * 8;
        rmsnorm_bwd(x + o1, g1, blk_da + o1, blk_dnorm + o1, dg1, C, load64(blk_rstd + t * 8));
        t = t + 1;
    }
    t_copy(dx, dout, TC); t_add_into(dx, blk_dnorm, TC);
    return 0;
}

# ---- E2: MLP sublayer (RMSNorm -> BitLinear up -> GELU -> BitLinear down -> +res) --
# mlp_out = x + down(GELU(up(RMSNorm(x,g2)))). W is the 2*C*F arena (Wup C*F | Wdn F*C).

# MLP sublayer forward: mlp_out = x + down(GELU(up(RMSNorm(x, g2)))); caches for the bwd.
fn mlp_sublayer_fwd(x, g2, W, T, C, F): i64 {
    var TC = T * C; var TF = T * F; var CF = C * F;
    var Wup = W; var Wdn = W + CF * 8;
    var t = 0;
    while (t < T) { store64(mlp_rstd2 + t * 8, rmsnorm_fwd(x + t * C * 8, g2, mlp_b2 + t * C * 8, C)); t = t + 1; }
    store64(mlp_gam + 0, bl_forward_wonly(mlp_b2, Wup, 0, mlp_fc, T, C, F, mlp_Wupq, mlp_Wupe));
    gelu_fwd(mlp_fc, mlp_gg, TF);
    store64(mlp_gam + 8, bl_forward_wonly(mlp_gg, Wdn, 0, mlp_branch, T, F, C, mlp_Wdnq, mlp_Wdne));
    t_copy(mlp_out, x, TC); t_add_into(mlp_out, mlp_branch, TC);
    return 0;
}

# 1/2 ||mlp_out||^2, the scalar the E2 dx gate differentiates.
fn mlp_sublayer_loss(x, g2, W, T, C, F): i64 {
    mlp_sublayer_fwd(x, g2, W, T, C, F);
    var acc = f64_from(0); var i = 0; var TC = T * C;
    while (i < TC) { var v = load64(mlp_out + i * 8); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# MLP sublayer backward: dx fresh; dW (the 2*C*F arena) and dg2 ACCUMULATE (STE).
fn mlp_sublayer_bwd(dout, x, g2, W, dx, dg2, dW, T, C, F): i64 {
    var TC = T * C; var TF = T * F; var CF = C * F;
    var Wup = W; var Wdn = W + CF * 8;
    var dWup = dW; var dWdn = dW + CF * 8;
    bl_backward_wonly(mlp_gg, mlp_Wdne, dout, mlp_dgg, dWdn, 0, T, F, C, Wdn, load64(mlp_gam + 8), mlp_dWeff);
    gelu_bwd(mlp_fc, mlp_dgg, mlp_dfc, TF);
    bl_backward_wonly(mlp_b2, mlp_Wupe, mlp_dfc, mlp_db2, dWup, 0, T, C, F, Wup, load64(mlp_gam + 0), mlp_dWeff);
    var t = 0;
    while (t < T) {
        var o2 = t * C * 8;
        rmsnorm_bwd(x + o2, g2, mlp_db2 + o2, mlp_dnorm2 + o2, dg2, C, load64(mlp_rstd2 + t * 8));
        t = t + 1;
    }
    t_copy(dx, dout, TC); t_add_into(dx, mlp_dnorm2, TC);
    return 0;
}

# ---- E3: full pre-norm block = attention sublayer then MLP sublayer ----------
# out (= mlp_out) = block(x). gns = [g1|g2] (2*C). Wa = 4*C*C attn arena, Wm = 2*C*F.
# Each sublayer folds its own residual, so the block just threads x -> xmid -> out.

# Full pre-norm block forward over T tokens; the output lands in mlp_out.
fn block_fwd(x, gns, Wa, Wm, T, C, F): i64 {
    _blk_dims(T, C, F);
    var TC = T * C;
    attn_sublayer_fwd(x, gns, Wa, T, C);            # blk_out = x + attn(RMSNorm(x,g1))
    t_copy(blk_xmid, blk_out, TC);                  # xmid persists as the MLP input (for bwd)
    mlp_sublayer_fwd(blk_xmid, gns + C * 8, Wm, T, C, F);   # mlp_out = xmid + mlp(RMSNorm(xmid,g2))
    return 0;
}

# 1/2 ||block(x)||^2, the scalar the E3 dx gate differentiates.
fn block_loss(x, gns, Wa, Wm, T, C, F): i64 {
    block_fwd(x, gns, Wa, Wm, T, C, F);
    var acc = f64_from(0); var i = 0; var TC = T * C;
    while (i < TC) { var v = load64(mlp_out + i * 8); acc = f64_add(acc, f64_mul(v, v)); i = i + 1; }
    return f64_mul(f64_div(f64_from(1), f64_from(2)), acc);
}

# Reversed order (MLP was last forward). Each sublayer_bwd folds the skip internally,
# so the block just threads dout -> dxmid -> dx. dgns=[dg1|dg2], dWa/dWm ACCUMULATE.
fn block_bwd(dout, x, gns, Wa, Wm, dx, dgns, dWa, dWm, T, C, F): i64 {
    _blk_dims(T, C, F);
    mlp_sublayer_bwd(dout, blk_xmid, gns + C * 8, Wm, blk_dxmid, dgns + C * 8, dWm, T, C, F);
    attn_sublayer_bwd(blk_dxmid, x, gns, Wa, dx, dgns, dWa, T, C);
    return 0;
}

# ---- E4: the multi-token ternary transformer LM -----------------------------
# token-embed (full-precision V*C) + learned absolute pos-embed (full-precision T*C)
# -> block (E3) -> final RMSNorm -> SEPARATE ternary BitLinear head (C->V) -> per-
# position softmax cross-entropy (target[t] = next token). SGD trains the latent
# weights + full-precision embeds/gains; b1.58 ternarizes only the linear layers.
# All params + grads + scratch are module-global (tx_*), allocated by tx_init.

var tx_tokemb = 0; var tx_posemb = 0; var tx_gns = 0; var tx_gf = 0;
var tx_Wa = 0; var tx_Wm = 0; var tx_Whead = 0; var tx_bhead = 0;
var tx_dtokemb = 0; var tx_dposemb = 0; var tx_dgns = 0; var tx_dgf = 0;
var tx_dWa = 0; var tx_dWm = 0; var tx_dWhead = 0; var tx_dbhead = 0;
var tx_resid0 = 0; var tx_fnorm = 0; var tx_rstdf = 0;
var tx_logits = 0; var tx_probs = 0; var tx_dlogits = 0;
var tx_dfnorm = 0; var tx_dresid1 = 0; var tx_dresid0 = 0;
var tx_Whq = 0; var tx_Whe = 0; var tx_hdWeff = 0; var tx_ghead = 0;
# the dims tx_init sized the model for (0 = not initialized) — 1.1.2
var tx_V0 = 0; var tx_T0 = 0; var tx_C0 = 0; var tx_F0 = 0;
# 1 while the model came from tx_pack_deserialize (src/serial.cyr): it holds the packed
# store and the f64 embeddings / gains / bias, but no latent weights (1.2.0).
var tx_packed_only = 0;
# The model's revision (1.4.0): bumped by every call that changes what serving reads
# (tx_init, tx_param_init, tx_sgd here; tx_pack_init, tx_pack and a successful
# tx_pack_deserialize). The incremental decoder (src/decode.cyr) records it at
# tx_dec_reset and refuses to step a cache built against an older revision.
var tx_rev = 0;

# Allocate the transformer's parameters, gradients and scratch (tx_*), plus the
# block scratch (blk_init): vocabulary V, up to T positions, width C, MLP width F.
# Every later tx_* call must pass the same V, C, F and a T in [1, T] (checked at
# entry since 1.1.2).
fn tx_init(V, T, C, F): i64 {
    guard(V >= 1, "tx_init: V must be >= 1");
    blk_init(T, C, F);
    tx_V0 = V; tx_T0 = T; tx_C0 = C; tx_F0 = F;
    tx_packed_only = 0;
    tx_rev = tx_rev + 1;
    var TC = T * C; var CC = C * C; var CF = C * F; var CV = C * V; var VC = V * C; var TV = T * V;
    tx_tokemb = t_alloc(VC); tx_posemb = t_alloc(TC); tx_gns = t_alloc(2 * C); tx_gf = t_alloc(C);
    tx_Wa = t_alloc(4 * CC); tx_Wm = t_alloc(2 * CF); tx_Whead = t_alloc(CV); tx_bhead = t_alloc(V);
    tx_dtokemb = t_alloc(VC); tx_dposemb = t_alloc(TC); tx_dgns = t_alloc(2 * C); tx_dgf = t_alloc(C);
    tx_dWa = t_alloc(4 * CC); tx_dWm = t_alloc(2 * CF); tx_dWhead = t_alloc(CV); tx_dbhead = t_alloc(V);
    tx_resid0 = t_alloc(TC); tx_fnorm = t_alloc(TC); tx_rstdf = t_alloc(T);
    tx_logits = t_alloc(TV); tx_probs = t_alloc(TV); tx_dlogits = t_alloc(TV);
    tx_dfnorm = t_alloc(TC); tx_dresid1 = t_alloc(TC); tx_dresid0 = t_alloc(TC);
    tx_Whq = t_alloc(CV); tx_Whe = t_alloc(CV); tx_hdWeff = t_alloc(CV);
    return 0;
}

# Entry check for the public tx_* calls: the model exists, V, C, F are the tx_init
# ones, and T fits. Every tx_* buffer is sized by tx_init's dims, so a larger value
# would read and write past it (1.1.2).
fn _tx_dims(V, T, C, F): i64 {
    guard(tx_T0 != 0, "tx: call tx_init first");
    guard((V == tx_V0) & (C == tx_C0) & (F == tx_F0), "tx: V, C, F differ from tx_init");
    guard((T >= 1) & (T <= tx_T0), "tx: T outside [1, tx_init T]");
    return 0;
}

# Entry check for the calls that read the latent weights (tx_fwd, tx_bwd, tx_sgd,
# tx_fwd_q, tx_pack). A deserialized model has none — its latent buffers are the zeros
# tx_init allocated — so those calls would compute with zero weights (1.2.0).
fn _tx_latents(): i64 {
    guard(tx_packed_only == 0, "tx: a deserialized model has no latent weights; serve it with tx_fwd_packed");
    return 0;
}

# The token + position embedding every whole-model forward starts with:
# tx_resid0[t] = tokemb[tokens[t]] + posemb[t]. A token id is a row offset into
# tokemb, so ids outside [0, V) are refused here, once per call (1.1.2).
fn _tx_embed(tokens, V, T, C): i64 {
    guard(_ids_in_range(tokens, T, V), "tx: token id outside [0, V)");
    var C8 = C * 8;
    var t = 0;
    while (t < T) {
        var tok = load64(tokens + t * 8);
        t_copy(tx_resid0 + t * C8, tx_tokemb + tok * C8, C);
        t_add_into(tx_resid0 + t * C8, tx_posemb + t * C8, C);
        t = t + 1;
    }
    return 0;
}

# Random init: every latent weight and embedding ~ N(0, 0.1) from `seed`, the norm
# gains 1, the head bias 0.
fn tx_param_init(V, T, C, F, seed): i64 {
    _tx_dims(V, T, C, F);
    tx_packed_only = 0;              # every parameter is re-drawn: an ordinary in-process model again
    tx_rev = tx_rev + 1;
    rng_seed(seed);
    var std = f64_div(f64_from(1), f64_from(10));   # 0.1
    t_randn(tx_tokemb, V * C, std); t_randn(tx_posemb, T * C, std);
    t_randn(tx_Wa, 4 * C * C, std); t_randn(tx_Wm, 2 * C * F, std); t_randn(tx_Whead, C * V, std);
    t_fill(tx_gns, 2 * C, f64_from(1)); t_fill(tx_gf, C, f64_from(1)); t_zero(tx_bhead, V);
    return 0;
}

# Whole-model f64 forward (weight-only-quant linears) over tokens[0..T): logits
# land in tx_logits (T x V).
fn tx_fwd(tokens, V, T, C, F): i64 {
    _tx_dims(V, T, C, F);
    _tx_latents();
    var C8 = C * 8;
    _tx_embed(tokens, V, T, C);                       # resid0[t] = tokemb[tok] + posemb[t]
    block_fwd(tx_resid0, tx_gns, tx_Wa, tx_Wm, T, C, F);   # mlp_out = block(resid0)
    var t = 0;
    while (t < T) { store64(tx_rstdf + t * 8, rmsnorm_fwd(mlp_out + t * C8, tx_gf, tx_fnorm + t * C8, C)); t = t + 1; }
    tx_ghead = bl_forward_wonly(tx_fnorm, tx_Whead, tx_bhead, tx_logits, T, C, V, tx_Whq, tx_Whe);
    return 0;
}

# tx_fwd, then the mean next-token cross-entropy against targets[0..T) (fills tx_probs).
fn tx_loss(tokens, targets, V, T, C, F): i64 {
    tx_fwd(tokens, V, T, C, F);
    return softmax_xent_fwd(tx_logits, targets, tx_probs, T, V);
}

# Zero every gradient tx_bwd accumulates into (call once per step, before tx_bwd).
fn tx_zero_grads(V, T, C, F): i64 {
    _tx_dims(V, T, C, F);
    t_zero(tx_dtokemb, V * C); t_zero(tx_dposemb, T * C); t_zero(tx_dgns, 2 * C); t_zero(tx_dgf, C);
    t_zero(tx_dWa, 4 * C * C); t_zero(tx_dWm, 2 * C * F); t_zero(tx_dWhead, C * V); t_zero(tx_dbhead, V);
    return 0;
}

# Full LM backward (grads zeroed once by the caller). Consumes tx_probs from tx_loss.
# The embedding scatter below WRITES row tokens[t] of tx_dtokemb, so the ids are
# checked again here (tx_bwd may be handed other tokens than tx_loss saw): an id
# outside [0, V) used to add C f64s into whatever followed tx_dtokemb on the heap.
fn tx_bwd(tokens, targets, V, T, C, F): i64 {
    _tx_dims(V, T, C, F);
    _tx_latents();
    guard(_ids_in_range(tokens, T, V), "tx_bwd: token id outside [0, V)");
    var C8 = C * 8;
    softmax_xent_bwd(tx_probs, targets, tx_dlogits, T, V);
    bl_backward_wonly(tx_fnorm, tx_Whe, tx_dlogits, tx_dfnorm, tx_dWhead, tx_dbhead, T, C, V,
      tx_Whead, tx_ghead, tx_hdWeff);
    var t = 0;
    while (t < T) {
        var o = t * C8;
        rmsnorm_bwd(mlp_out + o, tx_gf, tx_dfnorm + o, tx_dresid1 + o, tx_dgf, C, load64(tx_rstdf + t * 8));
        t = t + 1;
    }
    block_bwd(tx_dresid1, tx_resid0, tx_gns, tx_Wa, tx_Wm, tx_dresid0, tx_dgns, tx_dWa, tx_dWm, T, C, F);
    t = 0;
    while (t < T) {                                   # embed scatter (accumulate): tok + pos
        var tok = load64(tokens + t * 8);
        t_add_into(tx_dtokemb + tok * C8, tx_dresid0 + t * C8, C);
        t_add_into(tx_dposemb + t * C8, tx_dresid0 + t * C8, C);
        t = t + 1;
    }
    return 0;
}

# SGD on the LATENT weights (re-quantized next fwd) + full-precision embeds/gains/bias.
fn tx_sgd(V, T, C, F, nlr): i64 {
    _tx_dims(V, T, C, F);
    _tx_latents();
    t_axpy(tx_Wa, tx_dWa, nlr, 4 * C * C);
    t_axpy(tx_Wm, tx_dWm, nlr, 2 * C * F);
    t_axpy(tx_Whead, tx_dWhead, nlr, C * V);
    t_axpy(tx_tokemb, tx_dtokemb, nlr, V * C); t_axpy(tx_posemb, tx_dposemb, nlr, T * C);
    t_axpy(tx_gns, tx_dgns, nlr, 2 * C); t_axpy(tx_gf, tx_dgf, nlr, C); t_axpy(tx_bhead, tx_dbhead, nlr, V);
    tx_rev = tx_rev + 1;             # the embeddings, gains and bias serving reads moved
    return 0;
}

# Train the ternary transformer LM by SGD for `steps`; stats[0]=loss_initial,
# stats[1]=loss_final (mean next-token CE over the T positions of the sequence).
fn tx_train(tokens, targets, V, T, C, F, steps, seed, stats): i64 {
    tx_init(V, T, C, F);
    tx_param_init(V, T, C, F, seed);
    store64(stats + 0, tx_loss(tokens, targets, V, T, C, F));
    var nlr = f64_div(f64_from(0 - 1), f64_from(10));   # -0.1
    var s = 0;
    while (s < steps) {
        tx_zero_grads(V, T, C, F);
        tx_loss(tokens, targets, V, T, C, F);
        tx_bwd(tokens, targets, V, T, C, F);
        tx_sgd(V, T, C, F, nlr);
        s = s + 1;
    }
    store64(stats + 8, tx_loss(tokens, targets, V, T, C, F));
    return 0;
}

# --- kernel.cyr ---

# tentib — the matmul-free inference kernel (M3). The payoff: ternary weights +
# int8 activations, INTEGER signed-accumulate (the inner loop is add / subtract /
# skip over i64 — NO multiply), then a single dequant per output by gamma * the
# per-row activation scale. y[m,n] = gamma * sx[m] * SUM_k qx[m,k] * Wq[k,n], with
# Wq in {-1,0,+1} so the product is +qx / -qx / 0. This is the M0 ternary_dot
# generalized to a full layer + carried to genuine integers; it reproduces
# bl_forward_full's f64 logits exactly (the integer accumulate has no rounding;
# the f64 path does, so they agree to ~f64 epsilon). Depends: src/ternary.cyr +
# lib/rosnet.cyr in scope.

# Per-row absmax int8 quant -> INTEGER codes qx (i64 in [-127,+127]) + per-row
# scale sx = absmax/127. Same q as bl_act_quant (M1), but keeps the integer code
# instead of dequantizing — so the kernel can accumulate in pure integer.
#
# The absmax compares f64_abs bit patterns as integers, as bl_act_quant does: the
# same bits as an f64_gt compare on every NaN-free row (for non-negative doubles the
# i64 order is the numeric order), but a NaN in the row now becomes the absmax, so
# sx[m] is NaN and every output of that row is NaN. Before 1.1.2, f64_gt skipped the
# NaN, sx stayed finite, and f64_to(NaN) became a valid-looking code (-127 on x86_64,
# 0 on aarch64): the integer path turned a NaN activation into a plausible logit
# while the f64 reference (mode 1) returned NaN.
fn act_quant_int(x, M, K, qx, sx): i64 {
    var m = 0;
    while (m < M) {
        var xr = x + m * K * 8;                   # this row's activations and codes
        var qr = qx + m * K * 8;
        var a = f64_from(0); var k = 0;
        while (k < K) { var v = f64_abs(load64(xr + k * 8)); if (v > a) { a = v; } k = k + 1; }
        if (f64_eq(a, f64_from(0)) == 1) {
            store64(sx + m * 8, f64_from(0));
            k = 0; while (k < K) { store64(qr + k * 8, 0); k = k + 1; }
        } else {
            store64(sx + m * 8, f64_div(a, f64_from(127)));
            var inv = f64_div(f64_from(127), a);
            k = 0;
            while (k < K) {
                var q = f64_to(f64_round(f64_mul(load64(xr + k * 8), inv)));
                if (q > 127) { q = 127; }
                if (q < (0 - 127)) { q = 0 - 127; }
                store64(qr + k * 8, q);           # i64 int8 code
                k = k + 1;
            }
        }
        m = m + 1;
    }
    return 0;
}

# The matmul-free kernel. Inner loop: i64 add / subtract / skip — no multiply.
# The only f64 multiplies are the M*N dequant scalings (vs M*K*N in a real matmul).
# y[m,n] = gamma*sx[m] * (signed-acc) + b[n]  (pass b = 0 for no bias).
fn ternary_matmul_free(qx, sx, Wq, gamma, b, y, M, K, N): i64 {
    var m = 0;
    while (m < M) {
        var scale = f64_mul(load64(sx + m * 8), gamma);
        var qrow = qx + m * K * 8;
        var n = 0;
        while (n < N) {
            var acc = 0;                          # i64 INTEGER accumulator
            var k = 0;
            while (k < K) {
                var w = load64(Wq + (k * N + n) * 8);
                if (w == 1) { acc = acc + load64(qrow + k * 8); }
                if (w == (0 - 1)) { acc = acc - load64(qrow + k * 8); }
                k = k + 1;
            }
            var yv = f64_mul(f64_from(acc), scale);                       # integer -> dequant f64
            if (b != 0) { yv = f64_add(yv, load64(b + n * 8)); }
            store64(y + (m * N + n) * 8, yv);
            n = n + 1;
        }
        m = m + 1;
    }
    return 0;
}

# ---- M3b: branchless variant (the throughput lever, scalar) ------------------
# The same matmul-free accumulate, but the data-dependent `if (w==+1)/(w==-1)`
# branches — UNPREDICTABLE on random ternary weights (~1/3 each of -1/0/+1), so
# the predictor misses constantly — are replaced by mask arithmetic:
#   pm = -(w==+1)  -> all-ones (i64 -1) when w==+1 else 0
#   nm = -(w==-1)  -> all-ones when w==-1 else 0
#   acc += (qv & pm) - (qv & nm)      # +qv / -qv / 0, NO branch, NO multiply
# Still genuinely multiply-free (the spirit of the kernel): only AND / ADD / SUB.
# Bit-identical output to ternary_matmul_free (the integer accumulate is the same
# value, reordered). History: this was the throughput lever on cyrius 6.2.x, which
# had f64 SIMD only. cyrius 6.4.6/6.4.7 shipped integer SIMD (iv_dp8), and the 0.4.1
# kernel below is the fast path; this scalar variant stays as a reference and as the
# SIMD kernel's K % 16 tail arithmetic.
fn ternary_matmul_free_bl(qx, sx, Wq, gamma, b, y, M, K, N): i64 {
    var m = 0;
    while (m < M) {
        var scale = f64_mul(load64(sx + m * 8), gamma);
        var qrow = qx + m * K * 8;
        var n = 0;
        while (n < N) {
            var acc = 0;                          # i64 INTEGER accumulator
            var k = 0;
            while (k < K) {
                var w = load64(Wq + (k * N + n) * 8);
                var qv = load64(qrow + k * 8);
                var pm = 0 - (w == 1);            # 0 or -1 (all-ones) — no branch
                var nm = 0 - (w == (0 - 1));
                acc = acc + (qv & pm) - (qv & nm);
                k = k + 1;
            }
            var yv = f64_mul(f64_from(acc), scale);
            if (b != 0) { yv = f64_add(yv, load64(b + n * 8)); }
            store64(y + (m * N + n) * 8, yv);
            n = n + 1;
        }
        m = m + 1;
    }
    return 0;
}

# ---- 2-bit packed ternary storage (the memory payoff: log2(3)~1.58 -> 2 bits) ---
# Pack n ternary weights {-1,0,+1} -> 2-bit codes (0->0, +1->1, -1->2), 4 per byte.
# 2 bits/weight is 32x smaller than an f64 slot; trit-packing (5/byte) reaches ~1.6.

# Pack Wq[0..n) into packed[0..(n+3)/4) bytes; a non-ternary weight fails loud.
fn tpack2(Wq, n, packed): i64 {
    var nbytes = (n + 3) / 4;
    var b = 0; while (b < nbytes) { store8(packed + b, 0); b = b + 1; }
    var i = 0;
    while (i < n) {
        var w = load64(Wq + i * 8);
        # a non-ternary weight would silently pack as 0 (data corruption on
        # round-trip) — fail loud instead (0.8.0; pack is a cold path)
        guard((w == 0) | (w == 1) | (w == (0 - 1)), "tpack2: weight not in {-1,0,+1}");
        var code = 0;
        if (w == 1) { code = 1; }
        if (w == (0 - 1)) { code = 2; }
        var bi = i / 4; var sh = (i % 4) * 2;
        store8(packed + bi, load8(packed + bi) | (code << sh));
        i = i + 1;
    }
    return 0;
}

# Weight i of a tpack2 store, back as -1, 0 or +1.
fn tunpack2(packed, i): i64 {
    var code = (load8(packed + i / 4) >> ((i % 4) * 2)) & 3;
    if (code == 1) { return 1; }
    if (code == 2) { return 0 - 1; }
    return 0;
}

# ---- M3c: whole-model integer inference -------------------------------------
# Run the matmul-free kernel through EVERY BitLinear of the TRAINED transformer:
# the 6 projections (attention Q/K/V/O + MLP up/down) and the head all go integer
# (act_quant_int -> ternary_matmul_free). RMSNorm / GELU / attention stay f64 —
# b1.58 ternarizes ONLY the linear layers; norms + the attention core keep higher
# precision. This is INFERENCE: no backward, so it is leaner than block.cyr's
# training forward (no caches), and it reuses block.cyr's f64 scratch (blk_*/mlp_*/
# tx_fnorm) for the shared f64 ops + the trained weights (tx_Wa/tx_Wm/tx_Whead/...).
#
# `mode` selects the BitLinear kernel so the SAME chain serves both roles:
#   mode 0 = integer  (the payoff: ternary W + int8 acts, integer signed-accumulate)
#   mode 1 = full-quant f64 (bl_forward_full per layer — the EXACT reference the
#            integer path must reproduce whole-model, extending the M3a per-layer gate)
# Both write logits to ki_logits; the caller copies between calls to compare.

var ki_Wq = 0; var ki_We = 0; var ki_q = 0; var ki_xe = 0; var ki_sx = 0; var ki_logits = 0;
var ki_w8t = 0; var ki_wsum = 0; var ki_xu8 = 0;
# what tx_int_init sized the scratch for (0 = not initialized) — 1.1.2. A BitLinear
# through it may use M <= ki_T0 rows, K <= ki_cap_k, N <= ki_cap_n, K*N <= ki_cap_kn.
var ki_V0 = 0; var ki_T0 = 0; var ki_cap_k = 0; var ki_cap_n = 0; var ki_cap_kn = 0;

# Allocate the integer-inference scratch (call AFTER tx_init). ki_Wq/ki_We size to
# the largest single projection (max of C*C, C*F, C*V); ki_q/ki_xe to T*max(C,F)
# (the down-proj reads F-wide rows); ki_sx per-token; ki_logits = T*V. The SIMD
# path (mode 2) adds ki_w8t (packed i8 weights, mkn bytes), ki_wsum (offset
# correction, max-N slots) and ki_xu8 (the u8 activation row, max-K bytes).
fn tx_int_init(V, T, C, F): i64 {
    guard((V >= 1) & (T >= 1) & (C >= 1) & (F >= 1), "tx_int_init: V, T, C, F must be >= 1");
    var mkn = C * C;
    if (C * F > mkn) { mkn = C * F; }
    if (C * V > mkn) { mkn = C * V; }
    var kf = C; if (F > kf) { kf = F; }
    var nmax = C; if (F > nmax) { nmax = F; } if (V > nmax) { nmax = V; }
    ki_Wq = t_alloc(mkn); ki_We = t_alloc(mkn);
    ki_q = t_alloc(T * kf); ki_xe = t_alloc(T * kf); ki_sx = t_alloc(T);
    ki_logits = t_alloc(T * V);
    ki_w8t = t_alloc((mkn + 7) / 8); ki_wsum = t_alloc(nmax); ki_xu8 = t_alloc((kf + 7) / 8);
    ki_V0 = V; ki_T0 = T; ki_cap_k = kf; ki_cap_n = nmax; ki_cap_kn = mkn;
    return 0;
}

# Entry check for a BitLinear that runs through the ki_* scratch: tx_int_init ran
# and its sizing covers M rows of K inputs and N outputs (1.1.2).
fn _ki_fits(M, K, N): i64 {
    guard(ki_T0 != 0, "integer path: call tx_int_init first");
    guard((M >= 1) & (M <= ki_T0) & (K >= 1) & (K <= ki_cap_k) & (N >= 1) & (N <= ki_cap_n),
      "integer path: M, K or N exceeds the tx_int_init sizing");
    guard(K * N <= ki_cap_kn, "integer path: K*N exceeds the tx_int_init sizing");
    return 0;
}

# One BitLinear, integer (mode 0), full-quant-f64 reference (mode 1), or integer
# SIMD (mode 2 — the 0.4.1 iv_dp8 kernel, re-packing per call like mode 0
# re-quantizes). The latent weight W re-quantizes to ternary each call (deployment
# pre-quantizes once; here we match the f64 forward's per-call cost for a fair
# benchmark). Returns gamma.
fn bl_forward_q(mode, x, W, b, y, M, K, N): i64 {
    _ki_fits(M, K, N);
    if (mode == 0) {
        var g = bl_weight_effective(W, K * N, ki_Wq, ki_We);   # ternary ki_Wq + gamma (ki_We unused)
        act_quant_int(x, M, K, ki_q, ki_sx);
        ternary_matmul_free(ki_q, ki_sx, ki_Wq, g, b, y, M, K, N);
        return g;
    }
    if (mode == 2) {
        var g2 = bl_weight_effective(W, K * N, ki_Wq, ki_We);
        tsimd_pack_w(ki_Wq, K, N, ki_w8t, ki_wsum);
        act_quant_int(x, M, K, ki_q, ki_sx);
        ternary_matmul_free_simd(ki_q, ki_sx, ki_w8t, ki_wsum, g2, b, y, M, K, N, ki_xu8);
        return g2;
    }
    return bl_forward_full(x, W, b, y, M, K, N, ki_Wq, ki_We, ki_xe, ki_sx);
}

# Attention sublayer, inference only, every projection through bl_forward_q(mode).
fn attn_sublayer_q(mode, x, g1, W, T, C): i64 {
    var TC = T * C; var CC = C * C;
    var Wq = W; var Wk = W + CC * 8; var Wv = W + 2 * CC * 8; var Wo = W + 3 * CC * 8;
    var t = 0;
    while (t < T) { rmsnorm_fwd(x + t * C * 8, g1, blk_a + t * C * 8, C); t = t + 1; }
    bl_forward_q(mode, blk_a, Wq, 0, blk_Q, T, C, C);
    bl_forward_q(mode, blk_a, Wk, 0, blk_K, T, C, C);
    bl_forward_q(mode, blk_a, Wv, 0, blk_V, T, C, C);
    attn_fwd(blk_Q, blk_K, blk_V, blk_P, blk_ctx, T, C);
    bl_forward_q(mode, blk_ctx, Wo, 0, blk_attn_out, T, C, C);
    t_copy(blk_out, x, TC); t_add_into(blk_out, blk_attn_out, TC);
    return 0;
}

# MLP sublayer, inference only, both projections through bl_forward_q(mode).
fn mlp_sublayer_q(mode, x, g2, W, T, C, F): i64 {
    var TC = T * C; var CF = C * F;
    var Wup = W; var Wdn = W + CF * 8;
    var t = 0;
    while (t < T) { rmsnorm_fwd(x + t * C * 8, g2, mlp_b2 + t * C * 8, C); t = t + 1; }
    bl_forward_q(mode, mlp_b2, Wup, 0, mlp_fc, T, C, F);
    gelu_fwd(mlp_fc, mlp_gg, T * F);
    bl_forward_q(mode, mlp_gg, Wdn, 0, mlp_branch, T, F, C);
    t_copy(mlp_out, x, TC); t_add_into(mlp_out, mlp_branch, TC);
    return 0;
}

# Full block, inference only (attn then MLP sublayer); the output lands in mlp_out.
fn block_q(mode, x, gns, Wa, Wm, T, C, F): i64 {
    var TC = T * C;
    attn_sublayer_q(mode, x, gns, Wa, T, C);
    t_copy(blk_xmid, blk_out, TC);
    mlp_sublayer_q(mode, blk_xmid, gns + C * 8, Wm, T, C, F);
    return 0;
}

# Whole-model forward over `tokens` using the TRAINED weights. Writes logits to
# ki_logits. mode 0 = matmul-free integer kernel; mode 1 = full-quant f64 reference;
# mode 2 = integer SIMD.
fn tx_fwd_q(mode, tokens, V, T, C, F): i64 {
    _tx_dims(V, T, C, F);
    _tx_latents();
    guard(ki_T0 != 0, "tx_fwd_q: call tx_int_init first");
    guard((T <= ki_T0) & (V <= ki_V0), "tx_fwd_q: T or V exceeds the tx_int_init sizing");
    var C8 = C * 8;
    _tx_embed(tokens, V, T, C);                       # resid0[t] = tokemb[tok] + posemb[t]
    block_q(mode, tx_resid0, tx_gns, tx_Wa, tx_Wm, T, C, F);
    var t = 0;
    while (t < T) { rmsnorm_fwd(mlp_out + t * C8, tx_gf, tx_fnorm + t * C8, C); t = t + 1; }
    bl_forward_q(mode, tx_fnorm, tx_Whead, tx_bhead, ki_logits, T, C, V);   # head carries bias
    return 0;
}

# ---- 0.4.1: integer-SIMD kernel (iv_dp8) — the b1.58 throughput lever ---------
# The M3b gate lifted: cyrius 6.4.6/6.4.7 (SIMD arc Phase 3) shipped integer SIMD,
# including iv_dp8(a, b, n) — the widening u8·i8 -> i32 dot (pmaddubsw -> pmaddwd ->
# paddd, 16 lanes/iteration; n a multiple of 16). That is exactly this kernel's
# inner loop, with two integer-exact rearrangements:
#
#   1. LAYOUT: the scalar kernel walks Wq [K,N] down a COLUMN (stride N) per output;
#      iv_dp8 needs 16 contiguous bytes. tsimd_pack_w transposes once to w8t [N,K]
#      i8 bytes (ternary {-1,0,+1} IS i8) — the "quantize + pack once" deployment
#      step, the i8 sibling of tpack2.
#   2. SIGNEDNESS: pmaddubsw is u8 x i8 — the FIRST operand is unsigned, but our
#      activation codes are signed [-127,+127]. Offset them: xu = qx + 128 in
#      [1,255], then dot(xu, w) = dot(qx, w) + 128*sum(w), so the true accumulate
#      is iv_dp8(xu, w, K16) - 128*wsum[n], with wsum precomputed at pack time.
#
# Exactness (why the SIMD path stays BIT-IDENTICAL to the scalar kernel): with
# ternary weights each pmaddubsw pair-sum is bounded by 2*255 = 510 << 32767, so
# the i16 stage NEVER saturates. iv_dp8 keeps four i32 lanes and folds them IN i32
# before sign-extending (x86 phaddd, aarch64 addv), so the whole dot must fit i32:
# |iv_dp8| <= 255*K16 < 2^31 holds for K < ~8.4M, and the kernel guards K <= 2^22
# (a 2x margin). The +128 offset correction is exact integer algebra. Same acc
# value, same dequant expression => the same f64 bits out. (Until 1.1.2 this
# comment said "~64*K, safe to K ~ 2^24", which is the per-lane bound, not the
# folded sum's: at K = 2^24 the fold would overflow. The guard was always right.)
#
# CALLER CONTRACT: the codes qx must fit the u8 offset. qx + 128 is stored with
# store8, so a code outside [-128, +127] wraps (128 -> 0) and the dot is silently
# wrong. act_quant_int's codes are [-127, +127] (fuzz property P2), and -128 is also
# exact (it offsets to byte 0). The scalar kernels accept any i64 code. A per-row
# check in the u8 loop below was measured in 1.1.2 at 4-10% of this kernel at M = 1
# and not adopted: hot loops carry no checks (the 0.8.0 posture), and every caller
# in the repo passes act_quant_int's codes.
#
# The K % 16 tail (whole-model dims C=4/F=8 are below one lane-group) runs the M3b
# branchless mask arithmetic on the SAME w8t bytes; wsum covers only the SIMD span
# [0, K16) so the tail needs no offset correction.

# Pack once per quantized weight: Wq [K,N] (i64 {-1,0,+1}) -> w8t [N,K] (i8 bytes,
# transposed so each output's weights are contiguous) + wsum[n] (i64) = the weight
# sum over the SIMD-covered span k < K16 (the +128 offset correction term).
#
# A non-ternary weight would store8-truncate to a wrong i8 AND void the kernel's
# no-saturation exactness bound (pair-sums <= 510 only holds for |w| <= 1) —
# silently-wrong dots. Fail loud (0.8.0). Since 1.1.2 the pass walks Wq in its own
# row-major order (sequential 8-byte reads, byte writes strided by K) instead of
# down each column, and checks each row once: (w + 1) | (1 - w) has its sign bit
# set exactly when w < -1 or w > 1. The integer wsum sums do not depend on order,
# so w8t and wsum are the same bytes as before.
fn tsimd_pack_w(Wq, K, N, w8t, wsum): i64 {
    var K16 = (K / 16) * 16;
    var n = 0;
    while (n < N) { store64(wsum + n * 8, 0); n = n + 1; }
    var k = 0;
    while (k < K) {
        var row = Wq + k * N * 8;
        var bad = 0;
        n = 0;
        while (n < N) {
            var w = load64(row + n * 8);
            bad = bad | (w + 1) | (1 - w);
            store8(w8t + n * K + k, w);           # i64 -1 truncates to the i8 0xFF
            n = n + 1;
        }
        guard(bad >= 0, "tsimd_pack_w: weight not in {-1,0,+1}");
        if (k < K16) {
            n = 0;
            while (n < N) { store64(wsum + n * 8, load64(wsum + n * 8) + load64(row + n * 8)); n = n + 1; }
        }
        k = k + 1;
    }
    return 0;
}

# The SIMD matmul-free kernel. Same contract as ternary_matmul_free (and
# bit-identical output), but consuming the packed w8t/wsum instead of Wq, plus a
# K-byte u8 scratch xu8 for the offset activation row. Inner loop: one iv_dp8 per
# 16 weights (widening dot, still multiply-free in spirit — pmaddubsw against
# {-1,0,+1} only sign-selects) + the branchless scalar tail for K % 16.
fn ternary_matmul_free_simd(qx, sx, w8t, wsum, gamma, b, y, M, K, N, xu8): i64 {
    # the bit-identity contract rests on the i32 accumulate never overflowing:
    # |acc| <= 255*K must stay < 2^31, so K < ~8.4M — enforce a comfortable
    # bound (once per call, not per element). 0.8.0 hardening.
    guard(K <= 4194304, "ternary_matmul_free_simd: K > 2^22 voids the i32 exactness bound");
    var K16 = (K / 16) * 16;
    var m = 0;
    while (m < M) {
        var scale = f64_mul(load64(sx + m * 8), gamma);
        var qrow = qx + m * K * 8;
        var k = 0;
        while (k < K) { store8(xu8 + k, load64(qrow + k * 8) + 128); k = k + 1; }   # u8 in [1,255]
        var n = 0;
        while (n < N) {
            var wrow = w8t + n * K;
            var acc = 0;
            if (K16 > 0) { acc = iv_dp8(xu8, wrow, K16) - 128 * load64(wsum + n * 8); }
            k = K16;                              # branchless tail on the same i8 bytes
            while (k < K) {
                var w = load8(wrow + k);          # 0 / 1 / 255 (load8 zero-extends)
                var qv = load64(qrow + k * 8);
                var pm = 0 - (w == 1);
                var nm = 0 - (w == 255);
                acc = acc + (qv & pm) - (qv & nm);
                k = k + 1;
            }
            var yv = f64_mul(f64_from(acc), scale);
            if (b != 0) { yv = f64_add(yv, load64(b + n * 8)); }
            store64(y + (m * N + n) * 8, yv);
            n = n + 1;
        }
        m = m + 1;
    }
    return 0;
}

# ---- 0.7.0: pack-once deployment inference --------------------------------------
# The consumer-facing serving path. tx_fwd_q re-quantizes (and mode 2 re-packs)
# every forward by reference-fairness design; a deployment quantizes + packs ONCE
# and then serves. tx_pack_init/tx_pack build a packed store for the trained
# model's 7 BitLinears (attn Q/K/V/O + MLP up/down + head); tx_fwd_packed serves
# forwards from it — per call only the per-token activation quant runs, the
# weights are never touched again. Bit-identical to tx_fwd_q modes 0/2 (same
# quantize -> same pack -> same kernel, just hoisted out of the call).
# Contract: call AFTER tx_init (weights live) + tx_int_init (ki_* scratch —
# tx_pack quantizes through ki_Wq/ki_We; serving quantizes acts into ki_q/ki_sx).
# Layer index: 0..3 = attn Q/K/V/O (K=C,N=C) · 4 = up (C,F) · 5 = down (F,C) ·
# 6 = head (C,V; carries tx_bhead).

var pk_w8t = 0; var pk_wsum = 0; var pk_gamma = 0; var pk_ready = 0;
var pk_V0 = 0; var pk_C0 = 0; var pk_F0 = 0;     # the dims the store is laid out for (1.1.2)
# The vocabulary the packed model declares (1.4.0; src/serial.cyr): 0 = none, the
# consumer's own convention; 1 = bytes. tx_pack_init resets it, tx_pack keeps it.
var pk_vocab = 0;

# Allocate the packed store (pointer tables + per-layer buffers).
fn tx_pack_init(V, T, C, F): i64 {
    guard((V >= 1) & (C >= 1) & (F >= 1), "tx_pack_init: V, C, F must be >= 1");
    pk_V0 = V; pk_C0 = C; pk_F0 = F;
    pk_w8t = t_alloc(7); pk_wsum = t_alloc(7); pk_gamma = t_alloc(7);
    var i = 0;
    while (i < 7) {
        var K = C; var N = C;
        if (i == 4) { N = F; }
        if (i == 5) { K = F; N = C; }
        if (i == 6) { N = V; }
        store64(pk_w8t + i * 8, t_alloc((K * N + 7) / 8));   # K*N i8 bytes
        store64(pk_wsum + i * 8, t_alloc(N));
        i = i + 1;
    }
    pk_ready = 0;
    pk_vocab = 0;
    tx_rev = tx_rev + 1;
    return 0;
}

# Quantize + pack all 7 BitLinears from the live tx_* latent weights. Once.
fn tx_pack(V, T, C, F): i64 {
    # without tx_pack_init the pointer tables are 0 — packing would write through
    # garbage pointers (silent heap corruption); without tx_init/tx_int_init the
    # weight/scratch pointers are 0 too. Fail loud (0.8.0).
    guard(pk_w8t != 0, "tx_pack: call tx_pack_init first");
    guard((tx_Wa != 0) & (ki_Wq != 0), "tx_pack: call tx_init + tx_int_init first");
    _tx_dims(V, T, C, F);
    _tx_latents();
    guard((V == pk_V0) & (C == pk_C0) & (F == pk_F0), "tx_pack: V, C, F differ from tx_pack_init");
    var CC = C * C; var CF = C * F;
    # packing quantizes each layer through ki_Wq / ki_We (K*N slots)
    guard((CC <= ki_cap_kn) & (CF <= ki_cap_kn) & (C * V <= ki_cap_kn),
      "tx_pack: a layer exceeds the tx_int_init sizing");
    var i = 0;
    while (i < 7) {
        var W = tx_Wa + i * CC * 8;                          # 0..3: Q/K/V/O
        var K = C; var N = C;
        if (i == 4) { W = tx_Wm; N = F; }
        if (i == 5) { W = tx_Wm + CF * 8; K = F; N = C; }
        if (i == 6) { W = tx_Whead; N = V; }
        var g = bl_weight_effective(W, K * N, ki_Wq, ki_We);
        tsimd_pack_w(ki_Wq, K, N, load64(pk_w8t + i * 8), load64(pk_wsum + i * 8));
        store64(pk_gamma + i * 8, g);
        i = i + 1;
    }
    pk_ready = 1;
    tx_rev = tx_rev + 1;
    return 0;
}

# One packed BitLinear (internal): activation quant + the SIMD kernel against the
# pre-packed layer `i`. The only per-call work besides the matmul is act quant.
fn bl_forward_pk(i, x, b, y, M, K, N): i64 {
    act_quant_int(x, M, K, ki_q, ki_sx);
    ternary_matmul_free_simd(ki_q, ki_sx, load64(pk_w8t + i * 8), load64(pk_wsum + i * 8),
      load64(pk_gamma + i * 8), b, y, M, K, N, ki_xu8);
    return 0;
}

# Attention sublayer on the packed store (layers 0..3 = Q/K/V/O).
fn attn_sublayer_pk(x, g1, T, C): i64 {
    var TC = T * C;
    var t = 0;
    while (t < T) { rmsnorm_fwd(x + t * C * 8, g1, blk_a + t * C * 8, C); t = t + 1; }
    bl_forward_pk(0, blk_a, 0, blk_Q, T, C, C);
    bl_forward_pk(1, blk_a, 0, blk_K, T, C, C);
    bl_forward_pk(2, blk_a, 0, blk_V, T, C, C);
    attn_fwd(blk_Q, blk_K, blk_V, blk_P, blk_ctx, T, C);
    bl_forward_pk(3, blk_ctx, 0, blk_attn_out, T, C, C);
    t_copy(blk_out, x, TC); t_add_into(blk_out, blk_attn_out, TC);
    return 0;
}

# MLP sublayer on the packed store (layers 4 = up, 5 = down).
fn mlp_sublayer_pk(x, g2, T, C, F): i64 {
    var TC = T * C;
    var t = 0;
    while (t < T) { rmsnorm_fwd(x + t * C * 8, g2, mlp_b2 + t * C * 8, C); t = t + 1; }
    bl_forward_pk(4, mlp_b2, 0, mlp_fc, T, C, F);
    gelu_fwd(mlp_fc, mlp_gg, T * F);
    bl_forward_pk(5, mlp_gg, 0, mlp_branch, T, F, C);
    t_copy(mlp_out, x, TC); t_add_into(mlp_out, mlp_branch, TC);
    return 0;
}

# Whole-model packed forward — the deployment serving path. Writes ki_logits.
# Token ids are checked against [0, V) on every call: on the serving path they come
# from a consumer's tokenizer, and an id past the vocabulary would read beyond the
# embedding table (1.1.2).
fn tx_fwd_packed(tokens, V, T, C, F): i64 {
    guard(pk_ready == 1, "tx_fwd_packed: call tx_pack first");
    _tx_dims(V, T, C, F);
    guard((V == pk_V0) & (C == pk_C0) & (F == pk_F0), "tx_fwd_packed: V, C, F differ from tx_pack_init");
    guard((T <= ki_T0) & (V <= ki_V0) & (C <= ki_cap_k) & (F <= ki_cap_k),
      "tx_fwd_packed: T or V exceeds the tx_int_init sizing");
    var C8 = C * 8;
    _tx_embed(tokens, V, T, C);
    attn_sublayer_pk(tx_resid0, tx_gns, T, C);
    t_copy(blk_xmid, blk_out, T * C);
    mlp_sublayer_pk(blk_xmid, tx_gns + C * 8, T, C, F);
    var t = 0;
    while (t < T) { rmsnorm_fwd(mlp_out + t * C8, tx_gf, tx_fnorm + t * C8, C); t = t + 1; }
    bl_forward_pk(6, tx_fnorm, tx_bhead, ki_logits, T, C, V);
    return 0;
}

# argmax over a V-length logits row (the next-token prediction). Ties -> first index.
fn logits_argmax(logits, V): i64 {
    var best = 0; var bv = load64(logits + 0); var i = 1;
    while (i < V) { var v = load64(logits + i * 8); if (f64_gt(v, bv) == 1) { bv = v; best = i; } i = i + 1; }
    return best;
}

# --- serial.cyr ---

# tentib — packed-model serialization (1.2.0).
#
# A trained, packed model as bytes a consumer can store and serve later without the
# latent weights or retraining: tx_pack_serialize writes the live packed store (the 7
# BitLinears' ternary weights + gammas) and the f64 parameters serving reads (token +
# position embeddings, the RMSNorm gains, the head bias); tx_pack_deserialize rebuilds a
# model that tx_fwd_packed serves bit-identically. tentib does no file I/O: the consumer
# owns the bytes. The format is specified in docs/architecture/001-packed-model-format.md.
#
# DECODING IS AN UNTRUSTED-INPUT SURFACE. tx_pack_deserialize validates every field before
# it allocates or changes anything, so a refused buffer leaves the current model as it
# was, and it reports bad data with a status code rather than guard() (guard is for
# programmer errors). Derived data is recomputed, not trusted (the SIMD wsum offsets).
# The caller caps the memory a load may allocate (max_bytes): rosnet's t_alloc exits the
# process when an allocation fails, so a header must not be able to ask for more than the
# consumer agreed to.
#
# The format is canonical: any buffer the decoder accepts re-serializes to the same bytes,
# and every buffer tx_pack_serialize writes, the decoder accepts.
#
# 1.4.0 (additive): the flags word defines its first bit, the byte vocabulary
# (tx_pack_set_vocab / tx_pack_vocab); tx_pack_peek reads a header without loading; and
# a load that replaces a loaded model of the same dims reuses its buffers (_pk_reusable).
#
# Depends (includer order): ternary + bitlinear + layers + model + block + kernel.

# ---- format constants ----------------------------------------------------------

# "TENTIBPK" read as a little-endian u64 (the first 8 bytes of every artifact).
fn _pk_magic(): i64 { return load64("TENTIBPK"); }
# The format version this decoder reads and this encoder writes.
fn _pk_version(): i64 { return 1; }
# Each of V, T, C, F must lie in [1, 2^20]: products of two dims then fit easily in i64.
fn _pk_maxdim(): i64 { return 1048576; }
# Flags bit 0 (1.4.0): the byte vocabulary, token id = byte value, so V must be 256. It
# is the only bit defined; a decoder refuses any other (1.2.0 through 1.3.1 refuse all).
fn _pk_flag_bytes(): i64 { return 1; }

# The vocabulary a packed model declares (1.4.0): tx_pack_vocab returns one of these.
# None: format version 1's default; the token ids mean what the consumer says they mean.
fn pk_vocab_none(): i64 { return 0; }
# Bytes: token id = byte value, V = 256 (the flags word's bit 0).
fn pk_vocab_bytes(): i64 { return 1; }

# Status codes of tx_pack_deserialize (0 = loaded; each code is negative).
# Buffer too short, or its length is not the artifact's.
fn pk_err_length(): i64 { return 0 - 1; }
# Not a tentib packed model.
fn pk_err_magic(): i64 { return 0 - 2; }
# A format version this decoder does not read.
fn pk_err_version(): i64 { return 0 - 3; }
# A dim outside [1, 2^20], or a flags word this decoder does not accept (an undefined
# bit, or the byte vocabulary with V other than 256).
fn pk_err_header(): i64 { return 0 - 4; }
# The bytes do not match their FNV-1a checksum.
fn pk_err_checksum(): i64 { return 0 - 5; }
# Loading would allocate more than max_bytes.
fn pk_err_too_big(): i64 { return 0 - 6; }
# A weight code of 3, or nonzero padding.
fn pk_err_weights(): i64 { return 0 - 7; }
# A layer scale that is negative, NaN or infinite.
fn pk_err_gamma(): i64 { return 0 - 8; }
# An f64 parameter that is NaN or infinite.
fn pk_err_param(): i64 { return 0 - 9; }

# K (inputs) of BitLinear layer i: 0..3 = attn Q/K/V/O, 4 = up, 5 = down, 6 = head.
fn _pk_layer_k(i, C, F): i64 {
    if (i == 5) { return F; }
    return C;
}
# N (outputs) of BitLinear layer i.
fn _pk_layer_n(i, C, F, V): i64 {
    if (i == 4) { return F; }
    if (i == 6) { return V; }
    return C;
}
# Bytes of a layer's 2-bit code block: K*N codes, 4 per byte, padded to 8 bytes.
fn _pk_code_bytes(KN): i64 { return ((KN + 3) / 4 + 7) / 8 * 8; }

# The artifact's exact length for dims V, T, C, F (dims already range-checked).
fn _pk_size(V, T, C, F): i64 {
    var s = 64;                                           # header: 8 u64 words
    var i = 0;
    while (i < 7) {
        s = s + 8 + _pk_code_bytes(_pk_layer_k(i, C, F) * _pk_layer_n(i, C, F, V));
        i = i + 1;
    }
    s = s + 8 * (V * C + T * C + 3 * C + V);              # tokemb, posemb, gns (2C), gf (C), bhead
    return s + 8;                                         # FNV-1a checksum
}

# FNV-1a 64-bit over p[0..n). An integrity check against accidental corruption, not an
# authentication tag: anyone can recompute it, which is why every field is validated too.
fn _pk_fnv(p, n): i64 {
    var h = 0xCBF29CE484222325;
    var i = 0;
    while (i < n) {
        h = (h ^ load8(p + i)) * 0x100000001B3;
        i = i + 1;
    }
    return h;
}

# 1 when the f64 bit pattern v is finite (exponent not all ones).
fn _pk_finite(v): i64 {
    if (((v >> 52) & 0x7FF) == 0x7FF) { return 0; }
    return 1;
}

# 1 when every f64 at p[0..n) is finite.
fn _pk_all_finite(p, n): i64 {
    var i = 0;
    while (i < n) { if (_pk_finite(load64(p + i * 8)) == 0) { return 0; } i = i + 1; }
    return 1;
}

# 1 when gamma bits g are a valid layer scale: finite and not negative (absmean >= +0).
fn _pk_gamma_ok(g): i64 {
    if (g < 0) { return 0; }                              # sign bit set
    return _pk_finite(g);
}

# Bytes blk_init + tx_init + tx_int_init + tx_pack_init allocate for a model of dims
# V, T, C, F — exactly what tx_pack_deserialize allocates to load one. -1 for a dim
# outside [1, 2^20]. (It mirrors those four functions; the suite checks it against
# alloc_used().)
fn tx_model_alloc_bytes(V, T, C, F): i64 {
    if ((V < 1) | (T < 1) | (C < 1) | (F < 1)) { return 0 - 1; }
    var M = _pk_maxdim();
    if ((V > M) | (T > M) | (C > M) | (F > M)) { return 0 - 1; }
    var TC = T * C; var CC = C * C; var TF = T * F; var CF = C * F; var CV = C * V; var TV = T * V;
    var s = 23 * TC + 9 * CC + 5 * CF + 4 * TF + T * T + 3 * T + 6;           # blk_init
    s = s + 8 * CC + 4 * CF + 7 * CV + 7 * TC + 3 * TV + 6 * C + 2 * V + T;   # tx_init
    var mkn = CC;
    if (CF > mkn) { mkn = CF; }
    if (CV > mkn) { mkn = CV; }
    var kf = C; if (F > kf) { kf = F; }
    var nmax = C; if (F > nmax) { nmax = F; } if (V > nmax) { nmax = V; }
    s = s + 2 * mkn + (mkn + 7) / 8 + 2 * T * kf + (kf + 7) / 8 + TV + T + nmax;   # tx_int_init
    s = s + 21;                                                                # tx_pack_init tables
    var i = 0;
    while (i < 7) {
        var KN = _pk_layer_k(i, C, F) * _pk_layer_n(i, C, F, V);
        s = s + (KN + 7) / 8 + _pk_layer_n(i, C, F, V);
        i = i + 1;
    }
    return s * 8;
}

# The live packed model's dims, for a consumer that loaded a model it did not size itself:
# dims[0..4) = V, T (the longest context it serves), C, F — the arguments tx_fwd_packed
# takes (1.3.0). Fails loud when no packed model is live.
fn tx_pack_dims(dims): i64 {
    guard(pk_ready == 1, "tx_pack_dims: no packed model (call tx_pack or tx_pack_deserialize first)");
    store64(dims, pk_V0); store64(dims + 8, tx_T0); store64(dims + 16, pk_C0); store64(dims + 24, pk_F0);
    return 0;
}

# The vocabulary the live packed model declares: pk_vocab_none() or pk_vocab_bytes()
# (1.4.0). A load sets it from the artifact's flags word. Fails loud when no packed model
# is live.
fn tx_pack_vocab(): i64 {
    guard(pk_ready == 1, "tx_pack_vocab: no packed model (call tx_pack or tx_pack_deserialize first)");
    return pk_vocab;
}

# Declare the vocabulary of the packed model, for tx_pack_serialize to record (1.4.0):
# pk_vocab_bytes() when the model was trained on token id = byte value, which needs
# V = 256; pk_vocab_none() to record none. tx_pack_init resets it to none, and tx_pack
# keeps it. Fails loud on another kind, on bytes with V other than 256, or before
# tx_pack_init.
fn tx_pack_set_vocab(kind): i64 {
    guard(pk_w8t != 0, "tx_pack_set_vocab: call tx_pack_init (or tx_pack_deserialize) first");
    guard((kind == pk_vocab_none()) | (kind == pk_vocab_bytes()), "tx_pack_set_vocab: unknown vocabulary kind");
    guard((kind == pk_vocab_none()) | (pk_V0 == 256), "tx_pack_set_vocab: the byte vocabulary needs V = 256");
    pk_vocab = kind;
    return 0;
}

# ---- encode ----------------------------------------------------------------------

# Bytes tx_pack_serialize needs for the live packed model.
fn tx_pack_serial_bytes(): i64 {
    guard(pk_ready == 1, "tx_pack_serial_bytes: call tx_pack (or tx_pack_deserialize) first");
    _tx_dims(pk_V0, tx_T0, pk_C0, pk_F0);
    return _pk_size(pk_V0, tx_T0, pk_C0, pk_F0);
}

# Write the live packed model to buf[0..cap). Returns the bytes written; -1 if cap is
# smaller than tx_pack_serial_bytes() (nothing written); -2 if the model holds a NaN /
# infinite parameter or an invalid gamma, which the decoder would refuse (nothing written).
fn tx_pack_serialize(buf, cap): i64 {
    var size = tx_pack_serial_bytes();
    if (cap < size) { return 0 - 1; }
    var V = pk_V0; var T = tx_T0; var C = pk_C0; var F = pk_F0;
    var i = 0;
    while (i < 7) { if (_pk_gamma_ok(load64(pk_gamma + i * 8)) == 0) { return 0 - 2; } i = i + 1; }
    if ((_pk_all_finite(tx_tokemb, V * C) & _pk_all_finite(tx_posemb, T * C)) == 0) { return 0 - 2; }
    if ((_pk_all_finite(tx_gns, 2 * C) & _pk_all_finite(tx_gf, C) & _pk_all_finite(tx_bhead, V)) == 0) {
        return 0 - 2;
    }
    store64(buf, _pk_magic()); store64(buf + 8, _pk_version()); store64(buf + 16, size);
    store64(buf + 24, V); store64(buf + 32, T); store64(buf + 40, C); store64(buf + 48, F);
    var flags = 0;
    if (pk_vocab == pk_vocab_bytes()) { flags = _pk_flag_bytes(); }
    store64(buf + 56, flags);                             # bit 0: the byte vocabulary (1.4.0)
    var p = buf + 64;
    i = 0;
    while (i < 7) {
        var KN = _pk_layer_k(i, C, F) * _pk_layer_n(i, C, F, V);
        store64(p, load64(pk_gamma + i * 8));
        p = p + 8;
        var cb = _pk_code_bytes(KN);
        var z = 0;
        while (z < cb) { store8(p + z, 0); z = z + 1; }
        var w8t = load64(pk_w8t + i * 8);             # [N,K] i8: 0, 1, or 0xFF for -1
        var j = 0;
        while (j < KN) {
            var b = load8(w8t + j);
            guard((b == 0) | (b == 1) | (b == 255), "tx_pack_serialize: packed store is not ternary");
            var code = 0;
            if (b == 1) { code = 1; }
            if (b == 255) { code = 2; }
            store8(p + j / 4, load8(p + j / 4) | (code << ((j % 4) * 2)));
            j = j + 1;
        }
        p = p + cb;
        i = i + 1;
    }
    t_copy(p, tx_tokemb, V * C); p = p + V * C * 8;
    t_copy(p, tx_posemb, T * C); p = p + T * C * 8;
    t_copy(p, tx_gns, 2 * C); p = p + 2 * C * 8;
    t_copy(p, tx_gf, C); p = p + C * 8;
    t_copy(p, tx_bhead, V); p = p + V * 8;
    store64(p, _pk_fnv(buf, size - 8));
    return size;
}

# ---- decode ----------------------------------------------------------------------

# 1 when a layer's code block at p holds KN valid 2-bit codes (none is 3) and every
# padding bit and byte is zero.
fn _pk_codes_ok(p, KN): i64 {
    var full = KN / 4; var rem = KN % 4;
    var j = 0;
    while (j < full) {
        var b = load8(p + j);
        if ((b & (b >> 1) & 0x55) != 0) { return 0; }  # a code of 3 sets both bits of a pair
        j = j + 1;
    }
    if (rem > 0) {
        var t = load8(p + full);
        if ((t >> (rem * 2)) != 0) { return 0; }        # bits past the last code
        if ((t & (t >> 1) & 0x55) != 0) { return 0; }
        j = full + 1;
    }
    var cb = _pk_code_bytes(KN);
    while (j < cb) { if (load8(p + j) != 0) { return 0; } j = j + 1; }
    return 1;
}

# The header checks, in the decoder's order: the length is at least a header's, the
# magic, the version, the dims, the flags, then the length word and n against the length
# the dims imply. Returns 0 or the first failure's pk_err_* code. Reads buf[0..64) only
# when n >= 72.
fn _pk_header(buf, n): i64 {
    if (n < 72) { return pk_err_length(); }
    if (load64(buf) != _pk_magic()) { return pk_err_magic(); }
    if (load64(buf + 8) != _pk_version()) { return pk_err_version(); }
    var V = load64(buf + 24); var T = load64(buf + 32); var C = load64(buf + 40); var F = load64(buf + 48);
    var M = _pk_maxdim();
    if ((V < 1) | (T < 1) | (C < 1) | (F < 1)) { return pk_err_header(); }
    if ((V > M) | (T > M) | (C > M) | (F > M)) { return pk_err_header(); }
    var flags = load64(buf + 56);
    if ((flags & (0 - 1 - _pk_flag_bytes())) != 0) { return pk_err_header(); }   # an undefined bit
    if ((flags == _pk_flag_bytes()) & (V != 256)) { return pk_err_header(); }
    var size = _pk_size(V, T, C, F);
    if ((load64(buf + 16) != size) | (n != size)) { return pk_err_length(); }
    return 0;
}

# Read an artifact's header without loading it (1.4.0): runs tx_pack_deserialize's header
# checks (length, magic, version, dims, flags, the length the dims imply) and, when they
# pass, writes info[0..5) = V, T, C, F and the declared vocabulary (pk_vocab_none() or
# pk_vocab_bytes()). Returns 0, or the pk_err_* code tx_pack_deserialize would return
# for the same header, writing nothing. It changes no state. A 0 is not a promise that
# the load succeeds: the load also checks max_bytes, the checksum and every field.
fn tx_pack_peek(buf, n, info): i64 {
    var r = _pk_header(buf, n);
    if (r != 0) { return r; }
    store64(info, load64(buf + 24)); store64(info + 8, load64(buf + 32));
    store64(info + 16, load64(buf + 40)); store64(info + 24, load64(buf + 48));
    store64(info + 32, load64(buf + 56) & _pk_flag_bytes());   # flag bit 0 = pk_vocab_bytes()
    return 0;
}

# 1 when a load of dims V, T, C, F can overwrite the live model's buffers instead of
# allocating new ones (1.4.0): the live model is itself a loaded one (tx_packed_only, so
# its latent and gradient buffers still hold the zeros a fresh tx_init would give), and
# every init family was last sized for exactly these dims. A model built in this process
# (tx_init, tx_param_init, tx_pack) is never overwritten: the load allocates as before.
fn _pk_reusable(V, T, C, F): i64 {
    if ((tx_packed_only != 1) | (pk_w8t == 0)) { return 0; }
    if ((tx_V0 != V) | (tx_T0 != T) | (tx_C0 != C) | (tx_F0 != F)) { return 0; }
    if ((blk_T0 != T) | (blk_C0 != C) | (blk_F0 != F)) { return 0; }
    if ((pk_V0 != V) | (pk_C0 != C) | (pk_F0 != F)) { return 0; }
    var mkn = C * C;                                      # tx_int_init's sizing
    if (C * F > mkn) { mkn = C * F; }
    if (C * V > mkn) { mkn = C * V; }
    var kf = C; if (F > kf) { kf = F; }
    var nmax = C; if (F > nmax) { nmax = F; } if (V > nmax) { nmax = V; }
    if ((ki_V0 != V) | (ki_T0 != T) | (ki_cap_k != kf) | (ki_cap_n != nmax) | (ki_cap_kn != mkn)) { return 0; }
    return 1;
}

# Load a packed model from buf[0..n), allocating at most max_bytes (see
# tx_model_alloc_bytes). Returns 0 when loaded, or one of the pk_err_* codes (negative),
# in which case nothing was allocated or changed and the current model, if any, still
# serves. A loaded model serves through tx_fwd_packed for any T up to the stored T; it has
# no latent weights, so tx_fwd / tx_fwd_q / tx_bwd / tx_sgd / tx_pack refuse it until
# tx_init or tx_param_init makes an ordinary model again.
#
# Memory (1.4.0): a load allocates tx_model_alloc_bytes(V, T, C, F), except a load that
# replaces a LOADED model of the same V, T, C, F, which overwrites that model's buffers
# and allocates nothing. Either way the max_bytes check uses the model's figure, so
# whether a buffer loads does not depend on what was loaded before it.
fn tx_pack_deserialize(buf, n, max_bytes): i64 {
    var hr = _pk_header(buf, n);
    if (hr != 0) { return hr; }
    var V = load64(buf + 24); var T = load64(buf + 32); var C = load64(buf + 40); var F = load64(buf + 48);
    var size = _pk_size(V, T, C, F);
    if (tx_model_alloc_bytes(V, T, C, F) > max_bytes) { return pk_err_too_big(); }
    if (_pk_fnv(buf, size - 8) != load64(buf + size - 8)) { return pk_err_checksum(); }
    # validate every field before anything is allocated or changed
    var p = buf + 64;
    var i = 0;
    while (i < 7) {
        var KN = _pk_layer_k(i, C, F) * _pk_layer_n(i, C, F, V);
        if (_pk_gamma_ok(load64(p)) == 0) { return pk_err_gamma(); }
        if (_pk_codes_ok(p + 8, KN) == 0) { return pk_err_weights(); }
        p = p + 8 + _pk_code_bytes(KN);
        i = i + 1;
    }
    if (_pk_all_finite(p, V * C + T * C + 3 * C + V) == 0) { return pk_err_param(); }
    # commit: every check passed, and the allocation fits max_bytes
    if (_pk_reusable(V, T, C, F) == 0) {
        tx_init(V, T, C, F);
        tx_int_init(V, T, C, F);
        tx_pack_init(V, T, C, F);
    }
    p = buf + 64;
    i = 0;
    while (i < 7) {
        var K = _pk_layer_k(i, C, F); var N = _pk_layer_n(i, C, F, V);
        var KN2 = K * N;
        store64(pk_gamma + i * 8, load64(p));
        var codes = p + 8;
        var w8t = load64(pk_w8t + i * 8);
        var j = 0;
        while (j < KN2) {
            var code = (load8(codes + j / 4) >> ((j % 4) * 2)) & 3;
            var b = 0;
            if (code == 1) { b = 1; }
            if (code == 2) { b = 255; }
            store8(w8t + j, b);
            j = j + 1;
        }
        # wsum[n] = the weight sum over the 16-lane span, as tsimd_pack_w computes it
        var K16 = (K / 16) * 16;
        var wsum = load64(pk_wsum + i * 8);
        var nn = 0;
        while (nn < N) {
            var s = 0; var k = 0;
            while (k < K16) {
                var wb = load8(w8t + nn * K + k);
                s = s + (wb == 1) - (wb == 255);
                k = k + 1;
            }
            store64(wsum + nn * 8, s);
            nn = nn + 1;
        }
        p = codes + _pk_code_bytes(KN2);
        i = i + 1;
    }
    t_copy(tx_tokemb, p, V * C); p = p + V * C * 8;
    t_copy(tx_posemb, p, T * C); p = p + T * C * 8;
    t_copy(tx_gns, p, 2 * C); p = p + 2 * C * 8;
    t_copy(tx_gf, p, C); p = p + C * 8;
    t_copy(tx_bhead, p, V);
    pk_ready = 1;
    tx_packed_only = 1;
    pk_vocab = pk_vocab_none();
    if (load64(buf + 56) == _pk_flag_bytes()) { pk_vocab = pk_vocab_bytes(); }
    tx_rev = tx_rev + 1;
    return 0;
}

# --- decode.cyr ---

# tentib — incremental decode on the packed store (1.4.0).
#
# A server generates one token at a time. Without this module each new token is a full
# tx_fwd_packed over the window: n new tokens cost n forwards of up to T positions. The
# step below runs ONE new position, against the keys and values of the earlier positions
# kept in a cache, so a token costs one position plus the attention row over the cache.
#
#   tx_dec_reset();                      # a new sequence (allocates the cache once)
#   var p = tx_dec_step(tok);            # position p; its logits in ki_logits[0..V)
#   ...                                  # one step per prompt token, then per new token
#
# THE STEP IS BIT-IDENTICAL to the last row of tx_fwd_packed over the same tokens. Every
# stage of the forward except attention is per position: the embedding, both RMSNorms,
# the per-token activation quant and every BitLinear row (ternary_matmul_free_simd runs
# its rows independently), GELU, the residual adds. Attention is causal, so position p
# reads only the keys and values of positions 0..p, which are what the cache holds, and
# the step computes p's row with the same function attn_fwd uses (_attn_row in
# src/layers.cyr), so every sum runs in the same order. The suite checks it at every
# window length; the fuzz harness checks it on random models (P11).
#
# THE WINDOW. Positions are absolute (the position embedding has T rows), so a cache
# holds at most T positions, and tx_dec_step fails loud on a full one. Sliding the
# window by one moves every token to a new position, which changes every cached key
# and value: there is nothing to reuse. Past T tokens, serve each token with a full
# tx_fwd_packed over the last T (what a sliding window has always cost), or reset and
# re-feed a shorter tail (cheaper per token, but a different context, so other output).
#
# STALENESS. The cache belongs to the model it was built against. Every call that
# changes what serving reads (tx_init, tx_param_init, tx_sgd, tx_pack_init, tx_pack,
# a successful tx_pack_deserialize) bumps tx_rev, and tx_dec_step refuses a cache older
# than the model: call tx_dec_reset after any of them.
#
# MEMORY. The cache is 2 * T * C f64 (tx_dec_alloc_bytes), allocated by the first
# tx_dec_reset and reused by every later one whose model fits it (T * C no larger). A
# step allocates nothing: its scratch is row 0 of the buffers tx_fwd_packed uses, so a
# step and a full forward overwrite each other's outputs, never the cache.
#
# Depends (includer order): ternary + bitlinear + layers + model + block + kernel + serial.

var dec_K = 0; var dec_V = 0;        # the cache: keys and values, one C-row per position
var dec_cap = 0;                     # f64 slots each cache buffer holds (T * C it was sized for)
var dec_len = 0;                     # positions cached
var dec_rev = 0 - 1;                 # tx_rev at the last tx_dec_reset (-1: never reset)

# Bytes of the decode cache for a model of context T and width C: keys and values,
# T * C f64 each. -1 for a dim outside [1, 2^20].
fn tx_dec_alloc_bytes(T, C): i64 {
    if ((T < 1) | (C < 1) | (T > 1048576) | (C > 1048576)) { return 0 - 1; }
    return 16 * T * C;
}

# Start a new sequence on the live packed model: the cache holds no positions. The first
# call allocates the cache (tx_dec_alloc_bytes(T, C)), and so does a call for a model
# larger than any before it; every other call allocates nothing. Fails loud when no
# packed model is live.
fn tx_dec_reset(): i64 {
    guard(pk_ready == 1, "tx_dec_reset: no packed model (call tx_pack or tx_pack_deserialize first)");
    var need = tx_T0 * pk_C0;
    if (need > dec_cap) {
        dec_K = t_alloc(need); dec_V = t_alloc(need);
        dec_cap = need;
    }
    dec_len = 0;
    dec_rev = tx_rev;
    return 0;
}

# Positions the cache holds: the next tx_dec_step runs position tx_dec_len(). It is at
# most T, and a step fails loud once it is T.
fn tx_dec_len(): i64 { return dec_len; }

# Run the next position for token id tok: embed it at position p = tx_dec_len(), run the
# block against the cached keys and values of positions 0..p-1, append its own, and
# write its logits to ki_logits[0..V). Returns p. The logits are bit-identical to row p
# of tx_fwd_packed over the same p + 1 tokens. Fails loud when no packed model is live,
# when the cache is older than the model (tx_dec_reset after a load or any other model
# change), when the cache already holds T positions, or on an id outside [0, V).
fn tx_dec_step(tok): i64 {
    guard(pk_ready == 1, "tx_dec_step: no packed model (call tx_pack or tx_pack_deserialize first)");
    guard(dec_rev == tx_rev, "tx_dec_step: the cache predates the model (call tx_dec_reset)");
    var V = pk_V0; var C = pk_C0; var F = pk_F0;
    _tx_dims(V, 1, C, F);
    guard((ki_T0 >= 1) & (V <= ki_V0) & (C <= ki_cap_k) & (F <= ki_cap_k),
      "tx_dec_step: V, C or F exceeds the tx_int_init sizing");
    var p = dec_len;
    guard(p < tx_T0, "tx_dec_step: the cache holds T positions (the window is full)");
    guard((tok >= 0) & (tok < V), "tx_dec_step: token id outside [0, V)");
    var C8 = C * 8;
    # the embedding at position p (as _tx_embed does for row p)
    t_copy(tx_resid0, tx_tokemb + tok * C8, C);
    t_add_into(tx_resid0, tx_posemb + p * C8, C);
    # attention sublayer (attn_sublayer_pk for one row): Q into scratch, K and V into the cache
    rmsnorm_fwd(tx_resid0, tx_gns, blk_a, C);
    bl_forward_pk(0, blk_a, 0, blk_Q, 1, C, C);
    bl_forward_pk(1, blk_a, 0, dec_K + p * C8, 1, C, C);
    bl_forward_pk(2, blk_a, 0, dec_V + p * C8, 1, C, C);
    _attn_row(blk_Q, dec_K, dec_V, blk_P, blk_ctx, p, C, _attn_scale(C));
    bl_forward_pk(3, blk_ctx, 0, blk_attn_out, 1, C, C);
    t_copy(blk_out, tx_resid0, C); t_add_into(blk_out, blk_attn_out, C);
    # MLP sublayer, final norm, head (tx_fwd_packed's tail at T = 1)
    t_copy(blk_xmid, blk_out, C);
    mlp_sublayer_pk(blk_xmid, tx_gns + C8, 1, C, F);
    rmsnorm_fwd(mlp_out, tx_gf, tx_fnorm, C);
    bl_forward_pk(6, tx_fnorm, tx_bhead, ki_logits, 1, C, V);
    dec_len = p + 1;
    return p;
}
