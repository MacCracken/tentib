[package]
name = "tentib"
version = "${file:VERSION}"
description = "tentib — sovereign integer-native / ternary (1.58-bit) ML reference in Cyrius (BitNet reversed; the i64 thesis applied to the weights)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"
repository = "https://github.com/MacCracken/tentib"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/tentib"

# `cyrius distlib` concatenates [lib].modules (in order) into dist/tentib.cyr — the
# bundle consumers import via `[deps.tentib] modules = ["dist/tentib.cyr"]` (1.3.0).
# main.cyr (the demo) and test.cyr (the [build].test stub) are excluded. The bundle
# leaves rosnet's symbols (t_alloc, linear_fwd, linear_bwd, ...) and, through rosnet's
# t_randn, tyche's rng_* UNRESOLVED: a consumer declares [deps.rosnet] and
# [deps.tyche] too. It does not need akshara (only tentib's own demo and tests
# tokenize), and since 1.1.2 it calls no consumer-defined printer.
[lib]
modules = ["src/ternary.cyr", "src/bitlinear.cyr", "src/layers.cyr", "src/model.cyr", "src/block.cyr", "src/kernel.cyr", "src/serial.cyr", "src/decode.cyr"]

# The AGNOS GPU tile path (ternary_matmul_free_gpu, 1.0.1) is a SEPARATE profile, as
# rosnet's GPU backend is: `cyrius distlib gpu` bundles it into dist/tentib-gpu.cyr.
# It is self-contained (it computes every tile on the CPU off AGNOS), and a consumer
# that wants it imports both bundles.
[lib.gpu]
modules = ["src/gpu.cyr"]

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "math", "fnptr"]

# tentib is a SIBLING reference to attn11 (transformer) and tarka (RL/reasoning),
# on the same f64 substrate. M1 (v0.2.0) wires the latent-weight tensors + grad to
# rosnet; BitLinear is a quantization wrapper around rosnet's plain f64 matmul, and
# the STE re-routes the quantizers' gradients back through the same linear_bwd call.

# rosnet's t_randn calls tyche's rng_normal — [deps.tyche] is MANDATORY for link
# even though tentib only calls rosnet directly.
[deps.tyche]
git = "https://github.com/MacCracken/tyche"
tag = "1.2.2"
modules = ["dist/tyche.cyr"]

# Dense f64 tensor algebra: storage, BLAS-1, matmul + gradient (linear_fwd/linear_bwd).
[deps.rosnet]
git = "https://github.com/MacCracken/rosnet"
tag = "1.4.1"
modules = ["dist/rosnet.cyr"]

# Sovereign tokenizer (अक्षर) — the shared text→token-id layer (with attn11/tarka).
# tentib uses the pure byte-vocab path: corpus_set(text,len)->V + gd_ld(i) + g_datalen.
# The loader/streaming consumer symbols (secure_read_file/read_stdin/file_seek) are
# stubbed in the build units (M2 bite-F real-corpus training).
# scope = "test" (1.3.0): the LIBRARY (dist/tentib.cyr) never tokenizes — only the demo,
# the example programs and the suite / bench / fuzz harnesses do. A test-scope dep is
# still cloned, vendored into lib/ and lock-pinned by every resolve, and prepended to
# test / bench / fuzz compiles; the demo, examples and programs include
# lib/akshara.cyr explicitly. A consumer of tentib never walks it, so it inherits
# neither akshara nor its four consumer hooks.
[deps.akshara]
git = "https://github.com/MacCracken/akshara"
tag = "1.3.1"
modules = ["dist/akshara.cyr"]
scope = "test"
