# tentib — incremental decode on the packed store (1.4.0).
#
# A server generates one token at a time. Without this module each new token is a full
# tx_fwd_packed over the window: n new tokens cost n forwards of up to T positions. The
# step below runs ONE new position, against the keys and values of the earlier positions
# kept in a cache, so a token costs one position plus the attention row over the cache.
#
#   tx_dec_reset();                      # a new sequence (allocates the cache once)
#   var p = tx_dec_step(tok);            # position p; its logits in ki_logits[0..V)
#   ...                                  # one step per prompt token, then per new token
#
# THE STEP IS BIT-IDENTICAL to the last row of tx_fwd_packed over the same tokens. Every
# stage of the forward except attention is per position: the embedding, both RMSNorms,
# the per-token activation quant and every BitLinear row (ternary_matmul_free_simd runs
# its rows independently), GELU, the residual adds. Attention is causal, so position p
# reads only the keys and values of positions 0..p, which are what the cache holds, and
# the step computes p's row with the same function attn_fwd uses (_attn_row in
# src/layers.cyr), so every sum runs in the same order. The suite checks it at every
# window length; the fuzz harness checks it on random models (P11).
#
# THE WINDOW. Positions are absolute (the position embedding has T rows), so a cache
# holds at most T positions, and tx_dec_step fails loud on a full one. Sliding the
# window by one moves every token to a new position, which changes every cached key
# and value: there is nothing to reuse. Past T tokens, serve each token with a full
# tx_fwd_packed over the last T (what a sliding window has always cost), or reset and
# re-feed a shorter tail (cheaper per token, but a different context, so other output).
#
# STALENESS. The cache belongs to the model it was built against. Every call that
# changes what serving reads (tx_init, tx_param_init, tx_sgd, tx_pack_init, tx_pack,
# a successful tx_pack_deserialize) bumps tx_rev, and tx_dec_step refuses a cache older
# than the model: call tx_dec_reset after any of them.
#
# MEMORY. The cache is 2 * T * C f64 (tx_dec_alloc_bytes), allocated by the first
# tx_dec_reset and reused by every later one whose model fits it (T * C no larger). A
# step allocates nothing: its scratch is row 0 of the buffers tx_fwd_packed uses, so a
# step and a full forward overwrite each other's outputs, never the cache.
#
# Depends (includer order): ternary + bitlinear + layers + model + block + kernel + serial.

var dec_K = 0; var dec_V = 0;        # the cache: keys and values, one C-row per position
var dec_cap = 0;                     # f64 slots each cache buffer holds (T * C it was sized for)
var dec_len = 0;                     # positions cached
var dec_rev = 0 - 1;                 # tx_rev at the last tx_dec_reset (-1: never reset)

# Bytes of the decode cache for a model of context T and width C: keys and values,
# T * C f64 each. -1 for a dim outside [1, 2^20].
fn tx_dec_alloc_bytes(T, C): i64 {
    if ((T < 1) | (C < 1) | (T > 1048576) | (C > 1048576)) { return 0 - 1; }
    return 16 * T * C;
}

# Start a new sequence on the live packed model: the cache holds no positions. The first
# call allocates the cache (tx_dec_alloc_bytes(T, C)), and so does a call for a model
# larger than any before it; every other call allocates nothing. Fails loud when no
# packed model is live.
fn tx_dec_reset(): i64 {
    guard(pk_ready == 1, "tx_dec_reset: no packed model (call tx_pack or tx_pack_deserialize first)");
    var need = tx_T0 * pk_C0;
    if (need > dec_cap) {
        dec_K = t_alloc(need); dec_V = t_alloc(need);
        dec_cap = need;
    }
    dec_len = 0;
    dec_rev = tx_rev;
    return 0;
}

# Positions the cache holds: the next tx_dec_step runs position tx_dec_len(). It is at
# most T, and a step fails loud once it is T.
fn tx_dec_len(): i64 { return dec_len; }

# Run the next position for token id tok: embed it at position p = tx_dec_len(), run the
# block against the cached keys and values of positions 0..p-1, append its own, and
# write its logits to ki_logits[0..V). Returns p. The logits are bit-identical to row p
# of tx_fwd_packed over the same p + 1 tokens. Fails loud when no packed model is live,
# when the cache is older than the model (tx_dec_reset after a load or any other model
# change), when the cache already holds T positions, or on an id outside [0, V).
fn tx_dec_step(tok): i64 {
    guard(pk_ready == 1, "tx_dec_step: no packed model (call tx_pack or tx_pack_deserialize first)");
    guard(dec_rev == tx_rev, "tx_dec_step: the cache predates the model (call tx_dec_reset)");
    var V = pk_V0; var C = pk_C0; var F = pk_F0;
    _tx_dims(V, 1, C, F);
    guard((ki_T0 >= 1) & (V <= ki_V0) & (C <= ki_cap_k) & (F <= ki_cap_k),
      "tx_dec_step: V, C or F exceeds the tx_int_init sizing");
    var p = dec_len;
    guard(p < tx_T0, "tx_dec_step: the cache holds T positions (the window is full)");
    guard((tok >= 0) & (tok < V), "tx_dec_step: token id outside [0, V)");
    var C8 = C * 8;
    # the embedding at position p (as _tx_embed does for row p)
    t_copy(tx_resid0, tx_tokemb + tok * C8, C);
    t_add_into(tx_resid0, tx_posemb + p * C8, C);
    # attention sublayer (attn_sublayer_pk for one row): Q into scratch, K and V into the cache
    rmsnorm_fwd(tx_resid0, tx_gns, blk_a, C);
    bl_forward_pk(0, blk_a, 0, blk_Q, 1, C, C);
    bl_forward_pk(1, blk_a, 0, dec_K + p * C8, 1, C, C);
    bl_forward_pk(2, blk_a, 0, dec_V + p * C8, 1, C, C);
    _attn_row(blk_Q, dec_K, dec_V, blk_P, blk_ctx, p, C, _attn_scale(C));
    bl_forward_pk(3, blk_ctx, 0, blk_attn_out, 1, C, C);
    t_copy(blk_out, tx_resid0, C); t_add_into(blk_out, blk_attn_out, C);
    # MLP sublayer, final norm, head (tx_fwd_packed's tail at T = 1)
    t_copy(blk_xmid, blk_out, C);
    mlp_sublayer_pk(blk_xmid, tx_gns + C8, 1, C, F);
    rmsnorm_fwd(mlp_out, tx_gf, tx_fnorm, C);
    bl_forward_pk(6, tx_fnorm, tx_bhead, ki_logits, 1, C, V);
    dec_len = p + 1;
    return p;
}
