# tentib fuzz harness — seeded property fuzzing (1.1.2; was a no-op stub).
#
# Each round draws a random layer shape (K across every K % 16 split, M and N
# ragged against the 8x8x8 GPU tile) and random activations: magnitudes from
# 1e-3 to 1e3, whole zero rows, exact zeros, and in some rounds one NaN. It checks
# properties that must hold on EVERY input, not just the suite's fixed cases:
#
#   P1  the four integer kernels agree bit for bit: scalar == branchless == SIMD
#       == the GPU tile path's host fallback (with and without a bias)
#   P2  act_quant_int codes lie in [-127, +127]; a zero row has scale 0 and codes 0
#   P3  tpack2 / tunpack2 round-trip every ternary weight exactly
#   P4  bl_weight_effective emits ternary codes and Weff = code * gamma, bit for bit
#   P5  on finite input the integer kernel matches the full-quant f64 forward
#       (relative error < 1e-9: the integer accumulate adds no rounding)
#   P6  a NaN activation makes its row's outputs NaN in every kernel, and leaves
#       every other row bit-identical to the NaN-free run
#   P7  with the scale from bl_act_quant, the activation STE mask is the identity
#   P8  (every 8th round) a small whole model: integer modes 0 / 2 and packed
#       serving agree bit for bit, and serving a prefix reproduces the prefix rows
#   P9  (every 16th round, 1.2.0) that model survives the bytes round trip: overwrite the
#       in-memory model, deserialize, serve bit for bit; re-serializing gives the same bytes
#   P10 (every 2nd round, 1.2.0) the decoder on a mutated artifact — bit flips,
#       truncation / extension, header words, body bytes, gammas, parameters (the last
#       four with the checksum recomputed, to reach the field checks; NaN / Inf among
#       the values), and one round in four a memory budget below the need: it returns 0
#       or a documented code and never exits; a refused load leaves the current model
#       serving bit-identically; an accepted buffer re-serializes to the same bytes
#
# Deterministic: the seed sequence is fixed, so a failure names a reproducible
# round. Exit 0 = every property held; exit 1 = a property failed (message on
# stderr). Build: CYRIUS_DCE=1 cyrius build tests/tentib.fcyr build/fuzz

include "lib/tyche.cyr"
include "lib/rosnet.cyr"
include "src/ternary.cyr"
include "src/bitlinear.cyr"
include "src/layers.cyr"
include "src/model.cyr"
include "lib/akshara.cyr"
include "src/block.cyr"
include "src/kernel.cyr"
include "src/serial.cyr"  # tx_pack_serialize / tx_pack_deserialize — packed-model bytes (1.2.0)
include "src/gpu.cyr"

fn _putc(ch): i64 { var b[8]; store8(&b, ch); sys_write(1, &b, 1); return 0; }
# The harness's printer: a NUL-terminated string to stdout.
fn puts(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } sys_write(1, s, n); return 0; }
# akshara hook, not wired here: file loading is refused (-1).
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
# akshara hook, not wired here: stdin reading is refused (-1).
fn read_stdin(buf, cap): i64 { return 0 - 1; }
# akshara hook, not wired here: seeking is refused (-1).
fn file_seek(fd, off): i64 { return 0 - 1; }

var fz_round = 0;

# Report a failed property with its round on stderr, then exit 1.
fn fail(prop): i64 {
    _tentib_err("FUZZ FAIL: "); _tentib_err(prop); _tentib_err(" at round ");
    var buf[24]; var n = fz_round; var i = 22; store8(&buf + 23, 0);
    if (n == 0) { store8(&buf + i, 48); i = i - 1; }
    while (n > 0) { store8(&buf + i, 48 + n % 10); n = n / 10; i = i - 1; }
    _tentib_err(&buf + i + 1); _tentib_err("\n");
    sys_exit(1);
    return 0;
}

# uniform integer in [lo, hi]
fn rint(lo, hi): i64 { return lo + (rng_u64() & 0x7FFFFFFFFFFFFFFF) % (hi - lo + 1); }

# 1 when v is NaN.
fn is_nan(v): i64 { return 1 - f64_eq(v, v); }

# tx_param_init reseeds tyche's global stream (rng_seed), which the fuzz driver also
# draws from. Run it with the driver's state saved and restored (_rng_state is tyche's
# documented checkpoint hook), so a model init never makes later rounds repeat.
fn fz_param_init(V, T, C, F, seed): i64 {
    var keep = _rng_state;
    tx_param_init(V, T, C, F, seed);
    _rng_state = keep;
    return 0;
}

# 1 when a[0..n) and b[0..n) hold the same bits.
fn same(a, b, n): i64 {
    var i = 0;
    while (i < n) { if (load64(a + i * 8) != load64(b + i * 8)) { return 0; } i = i + 1; }
    return 1;
}

# Random activations: each row gets its own magnitude 10^e, e in [-3, 3]; about one
# row in nine is all zero and one element in twelve is an exact +0.
fn fill_x(x, M, K): i64 {
    var m = 0;
    while (m < M) {
        var zero_row = (rint(0, 8) == 0);
        var mag = f64_from(1);
        var e = rint(0, 6) - 3;
        while (e > 0) { mag = f64_mul(mag, f64_from(10)); e = e - 1; }
        while (e < 0) { mag = f64_div(mag, f64_from(10)); e = e + 1; }
        var k = 0;
        while (k < K) {
            var v = f64_mul(rng_normal(), mag);
            if (zero_row == 1) { v = f64_from(0); }
            if (rint(0, 11) == 0) { v = f64_from(0); }
            store64(x + (m * K + k) * 8, v);
            k = k + 1;
        }
        m = m + 1;
    }
    return 0;
}

# All four integer kernels on (qx, sx); y0 is the scalar reference. Returns 1 when
# the others match it bit for bit.
fn kernels_agree(qx, sx, Wq, g, b, M, K, N, y0, y1, y2, y3, w8t, wsum, xu8): i64 {
    ternary_matmul_free(qx, sx, Wq, g, b, y0, M, K, N);
    ternary_matmul_free_bl(qx, sx, Wq, g, b, y1, M, K, N);
    tsimd_pack_w(Wq, K, N, w8t, wsum);
    ternary_matmul_free_simd(qx, sx, w8t, wsum, g, b, y2, M, K, N, xu8);
    if (ternary_matmul_free_gpu(qx, sx, Wq, g, b, y3, M, K, N) != 0) { return 0; }
    var MN = M * N;
    if (same(y0, y1, MN) == 0) { return 0; }
    if (same(y0, y2, MN) == 0) { return 0; }
    if (same(y0, y3, MN) == 0) { return 0; }
    return 1;
}

# One random layer: properties P1-P7.
fn layer_round(): i64 {
    var M = rint(1, 12); var K = rint(1, 80); var N = rint(1, 40);
    var MK = M * K; var KN = K * N; var MN = M * N;
    var x = t_alloc(MK); var W = t_alloc(KN); var Wq = t_alloc(KN); var We = t_alloc(KN);
    var qx = t_alloc(MK); var sx = t_alloc(M); var xe = t_alloc(MK); var sf = t_alloc(M);
    var y0 = t_alloc(MN); var y1 = t_alloc(MN); var y2 = t_alloc(MN); var y3 = t_alloc(MN); var yf = t_alloc(MN);
    var w8t = alloc(KN + 16); var wsum = t_alloc(N); var xu8 = alloc(K + 16);
    var pk = alloc(KN / 4 + 8); var dx = t_alloc(MK);
    var b = 0;
    if (rint(0, 1) == 1) { b = t_alloc(N); t_randn(b, N, f64_from(1)); }
    fill_x(x, M, K);
    t_randn(W, KN, f64_div(f64_from(rint(1, 20)), f64_from(10)));

    # P4
    var g = bl_weight_effective(W, KN, Wq, We);
    var i = 0;
    while (i < KN) {
        var q = load64(Wq + i * 8);
        if ((q < (0 - 1)) | (q > 1)) { fail("P4 code not ternary"); }
        if (load64(We + i * 8) != f64_mul(f64_from(q), g)) { fail("P4 Weff != code * gamma"); }
        i = i + 1;
    }
    # P3
    tpack2(Wq, KN, pk);
    i = 0;
    while (i < KN) { if (tunpack2(pk, i) != load64(Wq + i * 8)) { fail("P3 tpack2 round-trip"); } i = i + 1; }
    # P2
    act_quant_int(x, M, K, qx, sx);
    var m = 0;
    while (m < M) {
        var s = load64(sx + m * 8);
        if (f64_lt(s, f64_from(0)) == 1) { fail("P2 negative scale"); }
        var k = 0;
        while (k < K) {
            var c = load64(qx + (m * K + k) * 8);
            if ((c < (0 - 127)) | (c > 127)) { fail("P2 code outside [-127, 127]"); }
            if (f64_eq(s, f64_from(0)) == 1) { if (c != 0) { fail("P2 zero row with a nonzero code"); } }
            k = k + 1;
        }
        m = m + 1;
    }
    # P1
    if (kernels_agree(qx, sx, Wq, g, b, M, K, N, y0, y1, y2, y3, w8t, wsum, xu8) == 0) { fail("P1 kernels disagree"); }
    # P5: the integer result is exact; the f64 reference rounds each product and each
    # add. So the bound is the summation error bound, not a relative tolerance (which
    # fails on any cancellation to an exact 0): |int - f64| <= 4*K*eps*(s*g*sum|q| + |b|)
    bl_forward_full(x, W, b, yf, M, K, N, Wq, We, xe, sf);
    var eps = f64_div(f64_from(1), f64_from(4503599627370496));   # 2^-52
    var kfac = f64_mul(f64_from(4 * K), eps);
    m = 0;
    while (m < M) {
        var l1 = 0; var k2 = 0;
        while (k2 < K) {
            var c2 = load64(qx + (m * K + k2) * 8);
            if (c2 < 0) { c2 = 0 - c2; }
            l1 = l1 + c2;
            k2 = k2 + 1;
        }
        var mag = f64_mul(f64_mul(f64_from(l1), load64(sx + m * 8)), f64_abs(g));
        var n2 = 0;
        while (n2 < N) {
            var bmag = f64_from(0);
            if (b != 0) { bmag = f64_abs(load64(b + n2 * 8)); }
            var bound = f64_mul(kfac, f64_add(mag, bmag));
            var a = load64(y0 + (m * N + n2) * 8); var r = load64(yf + (m * N + n2) * 8);
            if (f64_gt(f64_abs(f64_sub(a, r)), bound) == 1) { fail("P5 integer vs f64 beyond the rounding bound"); }
            n2 = n2 + 1;
        }
        m = m + 1;
    }
    # P7
    t_fill(dx, MK, f64_from(1));
    bl_ste_mask_x(dx, x, M, K, sf);
    i = 0;
    while (i < MK) {
        if (f64_eq(load64(dx + i * 8), f64_from(1)) == 0) { fail("P7 mask_x zeroed an unsaturated element"); }
        i = i + 1;
    }
    # P6: one NaN in a random row, every kernel
    if (rint(0, 2) == 0) {
        var nr = rint(0, M - 1);
        store64(x + (nr * K + rint(0, K - 1)) * 8, f64_div(f64_from(0), f64_from(0)));
        var qn = t_alloc(MK); var sn = t_alloc(M);
        var z0 = t_alloc(MN); var z1 = t_alloc(MN); var z2 = t_alloc(MN); var z3 = t_alloc(MN);
        act_quant_int(x, M, K, qn, sn);
        ternary_matmul_free(qn, sn, Wq, g, b, z0, M, K, N);
        ternary_matmul_free_bl(qn, sn, Wq, g, b, z1, M, K, N);
        ternary_matmul_free_simd(qn, sn, w8t, wsum, g, b, z2, M, K, N, xu8);
        ternary_matmul_free_gpu(qn, sn, Wq, g, b, z3, M, K, N);
        m = 0;
        while (m < M) {
            var n = 0;
            while (n < N) {
                var o = (m * N + n) * 8;
                if (m == nr) {
                    var nans = is_nan(load64(z0 + o)) & is_nan(load64(z1 + o));
                    nans = nans & is_nan(load64(z2 + o)) & is_nan(load64(z3 + o));
                    if (nans == 0) {
                        fail("P6 NaN row has a non-NaN output");
                    }
                } else {
                    var v = load64(y0 + o);
                    if ((load64(z0 + o) != v) | (load64(z1 + o) != v) | (load64(z2 + o) != v) | (load64(z3 + o) != v)) {
                        fail("P6 a NaN-free row changed");
                    }
                }
                n = n + 1;
            }
            m = m + 1;
        }
    }
    return 0;
}

# 1 when a[0..n) and b[0..n) hold the same bytes.
fn same_b(a, b, n): i64 {
    var i = 0;
    while (i < n) { if (load8(a + i) != load8(b + i)) { return 0; } i = i + 1; }
    return 1;
}

# P9: the live packed model (whose mode-0 logits over tok are l0) through the bytes.
fn serial_round(tok, l0, V, T, C, F): i64 {
    var n = tx_pack_serial_bytes();
    var a = alloc(n + 8); var b = alloc(n + 8);
    if (tx_pack_serialize(a, n) != n) { fail("P9 tx_pack_serialize size"); }
    tx_init(V + 1, T, C, F); fz_param_init(V + 1, T, C, F, 1);     # overwrite
    if (tx_pack_deserialize(a, n, 1 << 30) != 0) { fail("P9 a serialized model did not load"); }
    tx_fwd_packed(tok, V, T, C, F);
    if (same(l0, ki_logits, T * V) == 0) { fail("P9 the loaded model serves differently"); }
    tx_pack_serialize(b, n);
    if (same_b(a, b, n) == 0) { fail("P9 re-serialized bytes differ"); }
    return 0;
}

# P10 state: one valid artifact of fixed small dims, and zero-id tokens to serve with.
var fz_art = 0; var fz_art_n = 0; var fz_tok0 = 0;
var fz_V = 7; var fz_T = 4; var fz_C = 5; var fz_F = 9;

# Build P10's base artifact.
fn decoder_setup(): i64 {
    tx_init(fz_V, fz_T, fz_C, fz_F); fz_param_init(fz_V, fz_T, fz_C, fz_F, 4242);
    tx_int_init(fz_V, fz_T, fz_C, fz_F); tx_pack_init(fz_V, fz_T, fz_C, fz_F); tx_pack(fz_V, fz_T, fz_C, fz_F);
    fz_art_n = tx_pack_serial_bytes();
    fz_art = alloc(fz_art_n + 8);
    tx_pack_serialize(fz_art, fz_art_n);
    fz_tok0 = t_alloc(64);                                 # id 0 is valid for any V
    return 0;
}

# Byte offset of layer i's gamma in an artifact of P10's dims.
fn fz_gamma_off(i): i64 {
    var o = 64; var j = 0;
    while (j < i) {
        o = o + 8 + _pk_code_bytes(_pk_layer_k(j, fz_C, fz_F) * _pk_layer_n(j, fz_C, fz_F, fz_V));
        j = j + 1;
    }
    return o;
}

# Serve the current model (whatever it is) over zero-id tokens; logits into out.
fn fz_serve(out): i64 {
    tx_fwd_packed(fz_tok0, tx_V0, tx_T0, tx_C0, tx_F0);
    t_copy(out, ki_logits, tx_T0 * tx_V0);
    return 0;
}

# A random 64-bit pattern, or (one time in two) an exact NaN, +Inf or -Inf.
fn fz_bits(): i64 {
    var pick = rint(0, 5);
    if (pick == 0) { return 0x7FF8000000000000; }
    if (pick == 1) { return 0x7FF0000000000000; }
    if (pick == 2) { return f64_neg(f64_div(f64_from(1), f64_from(0))); }
    return rng_u64();
}

# P10: one mutation of the base artifact through the decoder.
fn decoder_round(): i64 {
    var n = fz_art_n;
    var m = alloc(n + 64);
    var i = 0;
    while (i < n) { store8(m + i, load8(fz_art + i)); i = i + 1; }
    while (i < n + 64) { store8(m + i, rint(0, 255)); i = i + 1; }
    var len = n;
    var kind = rint(0, 5);
    if (kind == 0) {
        var f = rint(1, 4);
        while (f > 0) { var pos = rint(0, n - 1); store8(m + pos, load8(m + pos) ^ (1 << rint(0, 7))); f = f - 1; }
    }
    if (kind == 1) { len = rint(0, n + 40); }
    if (kind == 2) {
        var w = rint(0, 7); var orig = load64(m + w * 8); var v = rng_u64();
        var pick = rint(0, 6);
        if (pick == 0) { v = 0; }
        if (pick == 1) { v = 1; }
        if (pick == 2) { v = 0 - 1; }
        if (pick == 3) { v = 1048576; }
        if (pick == 4) { v = 1048577; }
        if (pick == 5) { v = orig + 1; }
        store64(m + w * 8, v);
        store64(m + n - 8, _pk_fnv(m, n - 8));
    }
    if (kind == 3) {
        store8(m + rint(64, n - 9), rint(0, 255));
        store64(m + n - 8, _pk_fnv(m, n - 8));
    }
    if (kind == 4) {
        store64(m + fz_gamma_off(rint(0, 6)), fz_bits());
        store64(m + n - 8, _pk_fnv(m, n - 8));
    }
    if (kind == 5) {
        var np = fz_V * fz_C + fz_T * fz_C + 3 * fz_C + fz_V;
        store64(m + n - 8 - 8 * rint(1, np), fz_bits());
        store64(m + n - 8, _pk_fnv(m, n - 8));
    }
    var before = t_alloc(tx_T0 * tx_V0);
    fz_serve(before);
    var cap = 1 << 26;                                     # one round in four: a budget below the need
    if (rint(0, 3) == 0) { cap = rint(0, tx_model_alloc_bytes(fz_V, fz_T, fz_C, fz_F) - 1); }
    var rc = tx_pack_deserialize(m, len, cap);
    if ((rc > 0) | (rc < (0 - 9))) { fail("P10 a status outside the documented codes"); }
    if (rc == 0) {
        if (tx_pack_serial_bytes() != len) { fail("P10 an accepted buffer has a different length"); }
        var re = alloc(len + 8);
        tx_pack_serialize(re, len);
        if (same_b(m, re, len) == 0) { fail("P10 an accepted buffer is not canonical"); }
        # an independent oracle (not the decoder's own helpers): every loaded gamma is a
        # finite non-negative f64, every loaded parameter finite
        var gi = 0;
        while (gi < 7) {
            var gv = load64(pk_gamma + gi * 8);
            if ((gv < 0) | (((gv >> 52) & 0x7FF) == 0x7FF)) { fail("P10 an accepted gamma is not a valid scale"); }
            gi = gi + 1;
        }
        if ((f64_is_finite(tget(tx_tokemb, 0)) & f64_is_finite(tget(tx_bhead, fz_V - 1))) == 0) {
            fail("P10 an accepted parameter is not finite");
        }
        var after_ok = t_alloc(tx_T0 * tx_V0);
        fz_serve(after_ok);
    } else {
        var after = t_alloc(tx_T0 * tx_V0);
        fz_serve(after);
        if (same(before, after, tx_T0 * tx_V0) == 0) { fail("P10 a refused load changed the model"); }
    }
    return 0;
}

# One random small model: properties P8 and (every 16th round) P9.
fn model_round(): i64 {
    var V = rint(2, 12); var T = rint(1, 8); var C = rint(1, 24); var F = rint(1, 40);
    tx_init(V, T, C, F);
    fz_param_init(V, T, C, F, rint(1, 1000000));
    tx_int_init(V, T, C, F);
    var tok = t_alloc(T); var t = 0;
    while (t < T) { store64(tok + t * 8, rint(0, V - 1)); t = t + 1; }
    var TV = T * V;
    var l0 = t_alloc(TV); var l2 = t_alloc(TV);
    tx_fwd_q(0, tok, V, T, C, F); t_copy(l0, ki_logits, TV);
    tx_fwd_q(2, tok, V, T, C, F); t_copy(l2, ki_logits, TV);
    if (same(l0, l2, TV) == 0) { fail("P8 mode 2 != mode 0"); }
    tx_pack_init(V, T, C, F); tx_pack(V, T, C, F);
    tx_fwd_packed(tok, V, T, C, F);
    if (same(l0, ki_logits, TV) == 0) { fail("P8 packed serving != mode 0"); }
    var Tp = rint(1, T);
    tx_fwd_packed(tok, V, Tp, C, F);
    if (same(l0, ki_logits, Tp * V) == 0) { fail("P8 prefix serve != prefix rows"); }
    if ((fz_round % 16) == 0) { serial_round(tok, l0, V, T, C, F); }
    return 0;
}

# 5000 seeded rounds; exit 0 when every property held.
fn main(): i64 {
    alloc_init();
    rng_seed(20261109);
    decoder_setup();
    var rounds = 5000;
    while (fz_round < rounds) {
        layer_round();
        if ((fz_round % 8) == 0) { model_round(); }
        if ((fz_round % 2) == 0) { decoder_round(); }
        fz_round = fz_round + 1;
    }
    puts("fuzz: 5000 rounds, P1-P10 held\n");
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
