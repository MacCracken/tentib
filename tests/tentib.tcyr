# tentib — correctness suite.
# M0: the b1.58 absmean quantizer lands weights in {-1,0,+1}; the matmul-free
# signed-accumulate dot equals gamma * (independent signed sum).
# M1: rosnet substrate smoke (linear_fwd layout) — BitLinear + STE land next.
# Stdlib auto-included via cyrius.cyml; rosnet/tyche materialized to lib/ by `cyrius deps`.

include "lib/tyche.cyr"     # rng_* (rosnet's t_randn -> rng_normal; link dep)
include "lib/rosnet.cyr"    # t_alloc / t_zero / linear_fwd / linear_bwd / f64_is_finite
include "src/ternary.cyr"   # absmean / ternary_one / tload / tstore (M0 core)
include "src/bitlinear.cyr" # bl_weight_effective / bl_forward_wonly (M1)
include "src/layers.cyr"    # rmsnorm / gelu / attention — differentiable layers (M2)
include "src/model.cyr"     # softmax_xent / lm_* — minimal trainable ternary LM (M2)
include "lib/akshara.cyr"   # corpus_set / gd_ld — sovereign tokenizer (M2 bite-F)
include "src/block.cyr"     # attn_sublayer_* / tx_* — transformer block + LM (M2 bite-E/F)
include "src/kernel.cyr"    # ternary_matmul_free / act_quant_int / tpack2 — matmul-free kernel (M3)
include "src/serial.cyr"  # tx_pack_serialize / tx_pack_deserialize — packed-model bytes (1.2.0)
include "src/gpu.cyr"       # ternary_matmul_free_gpu — its host fallback is gated here (1.1.2)

# akshara consumer symbols (unused — we drive the pure corpus_set/gd_ld path)
fn _putc(ch): i64 { return 0; }
# Silenced: the suite reports through assert, so puts prints nothing here.
fn puts(s): i64 { return 0; }
# akshara hook, not wired here: file loading is refused (-1).
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
# akshara hook, not wired here: stdin reading is refused (-1).
fn read_stdin(buf, cap): i64 { return 0 - 1; }
# akshara hook, not wired here: seeking is refused (-1).
fn file_seek(fd, off): i64 { return 0 - 1; }

# |a-b| < 1e-9 — tolerance compare for f64 results that aren't bit-exact integers
fn bl_close(a, b): i64 {
    return f64_lt(f64_abs(f64_sub(a, b)), f64_div(f64_from(1), f64_from(1000000000)));
}

# --- finite-difference gate harness (tarka tests/tarka.tcyr pattern) ---
fn bl_eps(): i64 { return f64_div(f64_from(1), f64_from(10000)); }    # 1e-4
# FD-gate tolerance: 1e-5 relative error.
fn bl_tol(): i64 { return f64_div(f64_from(1), f64_from(100000)); }   # 1e-5
# Relative error |fd - an| / (|an| + 1e-9), safe at an = 0.
fn bl_relerr(fd, an): i64 {
    var num = f64_abs(f64_sub(fd, an));
    var den = f64_add(f64_abs(an), f64_div(f64_from(1), f64_from(1000000000)));
    return f64_div(num, den);
}
# central FD of the linearized surrogate L_lin(W)=<dyf, x@W> wrt W[idx] (dW gate)
fn fd_wgrad(x, W, idx, dyf, M, K, N, yscr): i64 {
    var sv = tload(W, idx);
    tstore(W, idx, f64_add(sv, bl_eps())); var lp = bl_surr_lin_loss(x, W, dyf, M, K, N, yscr);
    tstore(W, idx, f64_sub(sv, bl_eps())); var lm = bl_surr_lin_loss(x, W, dyf, M, K, N, yscr);
    tstore(W, idx, sv);
    return f64_div(f64_sub(lp, lm), f64_mul(f64_from(2), bl_eps()));
}
# central FD of 1/2||x@Weff||^2 wrt x[idx], Weff fixed (dx gate)
fn fd_xgrad(x, idx, Weff, M, K, N, yscr): i64 {
    var sv = tload(x, idx);
    tstore(x, idx, f64_add(sv, bl_eps())); var lp = bl_loss_of_x(x, Weff, M, K, N, yscr);
    tstore(x, idx, f64_sub(sv, bl_eps())); var lm = bl_loss_of_x(x, Weff, M, K, N, yscr);
    tstore(x, idx, sv);
    return f64_div(f64_sub(lp, lm), f64_mul(f64_from(2), bl_eps()));
}
# central FD of the FULL quantized loss wrt W[idx], Weff recomputed (falsifier)
fn fd_qgrad(x, W, idx, M, K, N, Wq, Weff, yscr): i64 {
    var sv = tload(W, idx);
    tstore(W, idx, f64_add(sv, bl_eps())); var lp = bl_quant_loss_wonly(x, W, 0, M, K, N, Wq, Weff, yscr);
    tstore(W, idx, f64_sub(sv, bl_eps())); var lm = bl_quant_loss_wonly(x, W, 0, M, K, N, Wq, Weff, yscr);
    tstore(W, idx, sv);
    return f64_div(f64_sub(lp, lm), f64_mul(f64_from(2), bl_eps()));
}

# --- 0.4.1 (M3d) helper: random M x K -> N layer; quantize; check the SIMD kernel
# (tsimd_pack_w + u8-offset iv_dp8 + branchless tail) reproduces the scalar
# matmul-free kernel BIT-FOR-BIT. K chosen by the caller to steer the K16 split.
fn m3s_simd_matches(M, K, N, seed): i64 {
    var MK = M * K; var KN = K * N; var MN = M * N;
    var x = t_alloc(MK); var W = t_alloc(KN); var Wq = t_alloc(KN); var We = t_alloc(KN);
    var qx = t_alloc(MK); var si = t_alloc(M);
    var yi = t_alloc(MN); var ys = t_alloc(MN);
    var w8t = alloc(KN); var wsum = t_alloc(N); var xu8 = alloc(K);
    rng_seed(seed);
    t_randn(x, MK, f64_from(1));
    t_randn(W, KN, f64_div(f64_from(1), f64_from(2)));
    var g = bl_weight_effective(W, KN, Wq, We);
    act_quant_int(x, M, K, qx, si);
    ternary_matmul_free(qx, si, Wq, g, 0, yi, M, K, N);
    tsimd_pack_w(Wq, K, N, w8t, wsum);
    ternary_matmul_free_simd(qx, si, w8t, wsum, g, 0, ys, M, K, N, xu8);
    var ok = 1; var i = 0;
    while (i < MN) { if (tget(ys, i) != tget(yi, i)) { ok = 0; } i = i + 1; }
    return ok;
}
# central FD of the quantized softmax-CE loss wrt embedding entry embx[k] (EXACT — embx is smooth input)
fn fd_emb(embx, k, W, b, tgt_buf, D, V, Wq, Weff, logits, probs): i64 {
    var sv = load64(embx + k * 8);
    store64(embx + k * 8, f64_add(sv, bl_eps()));
    var lp = bl_xent_loss(embx, W, b, tgt_buf, D, V, Wq, Weff, logits, probs);
    store64(embx + k * 8, f64_sub(sv, bl_eps()));
    var lm = bl_xent_loss(embx, W, b, tgt_buf, D, V, Wq, Weff, logits, probs);
    store64(embx + k * 8, sv);
    return f64_div(f64_sub(lp, lm), f64_mul(f64_from(2), bl_eps()));
}
# central FD of the quantized softmax-CE loss wrt head weight W[idx] (FALSIFIER — round/clip flat)
fn fd_xentw(embx, W, idx, b, tgt_buf, D, V, Wq, Weff, logits, probs): i64 {
    var sv = load64(W + idx * 8);
    store64(W + idx * 8, f64_add(sv, bl_eps()));
    var lp = bl_xent_loss(embx, W, b, tgt_buf, D, V, Wq, Weff, logits, probs);
    store64(W + idx * 8, f64_sub(sv, bl_eps()));
    var lm = bl_xent_loss(embx, W, b, tgt_buf, D, V, Wq, Weff, logits, probs);
    store64(W + idx * 8, sv);
    return f64_div(f64_sub(lp, lm), f64_mul(f64_from(2), bl_eps()));
}

# --- 1.1.2: fail-path harness for guard() ------------------------------------
# guard() exits the process, so its fail path is tested in a forked child: the
# child runs one scenario with stderr sent to /dev/null and exits 0 if the call
# returned. The parent gets the child's exit status: 1 = the guard fired, 0 = the
# call went through, -1 = the child died on a signal (e.g. SIGSEGV).
fn child_exit(fp): i64 {
    var pid = sys_fork();
    if (pid == 0) {
        var fd = sys_open("/dev/null", O_WRONLY, 0);
        if (fd >= 0) { sys_dup2(fd, 2); }
        fncall0(fp);
        sys_exit(0);
    }
    var st[8];
    store64(&st, 0);
    sys_waitpid(pid, &st, 0);
    var s = load64(&st) & 0xFFFFFFFF;
    if ((s & 0x7F) != 0) { return 0 - 1; }
    return (s >> 8) & 0xFF;
}

# Scenario state, set by main before the forks (the child inherits a copy).
var g_V = 0; var g_T = 0; var g_C = 0; var g_F = 0;
var g_tok = 0; var g_tgt = 0; var g_bad = 0; var g_buf = 0; var g_buf2 = 0;

# Control: returns, so the child exits 0.
fn sc_ok_noop(): i64 { return 0; }
# Control: tx_fwd at T - 1 is legal and returns.
fn sc_ok_short_t(): i64 { return tx_fwd(g_tok, g_V, g_T - 1, g_C, g_F); }
# tpack2 over a weight of 2 (must fail).
fn sc_tpack2_bad(): i64 {
    store64(g_buf, 0); store64(g_buf + 8, 2); store64(g_buf + 16, 1);
    return tpack2(g_buf, 3, g_buf2);
}
# tsimd_pack_w over a weight of -2 (must fail).
fn sc_pack_w_bad(): i64 {
    store64(g_buf, 1); store64(g_buf + 8, 0 - 2);
    return tsimd_pack_w(g_buf, 2, 1, g_buf2, g_buf2 + 64);
}
# The SIMD kernel at K = 2^22 + 1 (must fail before touching memory).
fn sc_simd_big_k(): i64 { return ternary_matmul_free_simd(0, 0, 0, 0, 0, 0, 0, 1, 4194305, 1, 0); }
# tx_pack with the packed store unallocated (must fail).
fn sc_tx_pack_noinit(): i64 { pk_w8t = 0; return tx_pack(g_V, g_T, g_C, g_F); }
# tx_fwd_packed before tx_pack (must fail).
fn sc_packed_not_ready(): i64 { pk_ready = 0; return tx_fwd_packed(g_tok, g_V, g_T, g_C, g_F); }
# tx_fwd with token id V (must fail).
fn sc_fwd_tok_hi(): i64 { return tx_fwd(g_bad, g_V, g_T, g_C, g_F); }
# tx_fwd with token id -1 (must fail).
fn sc_fwd_tok_neg(): i64 { store64(g_bad, 0 - 1); return tx_fwd(g_bad, g_V, g_T, g_C, g_F); }
# tx_bwd with token id V after a valid tx_loss (must fail).
fn sc_bwd_tok(): i64 {
    tx_loss(g_tok, g_tgt, g_V, g_T, g_C, g_F);
    return tx_bwd(g_bad, g_tgt, g_V, g_T, g_C, g_F);
}
# softmax_xent_fwd with target id V (must fail).
fn sc_xent_fwd_tgt(): i64 { return softmax_xent_fwd(tx_logits, g_bad, tx_probs, g_T, g_V); }
# softmax_xent_bwd with target id -1 (must fail).
fn sc_xent_bwd_tgt(): i64 { store64(g_bad, 0 - 1); return softmax_xent_bwd(tx_probs, g_bad, tx_dlogits, g_T, g_V); }
# tx_fwd with a C other than tx_init's (must fail).
fn sc_fwd_c(): i64 { return tx_fwd(g_tok, g_V, g_T, g_C + 1, g_F); }
# tx_fwd with T one past tx_init's (must fail).
fn sc_fwd_t(): i64 { return tx_fwd(g_tok, g_V, g_T + 1, g_C, g_F); }
# tx_fwd with T = 0 (must fail).
fn sc_fwd_t0(): i64 { return tx_fwd(g_tok, g_V, 0, g_C, g_F); }
# tx_fwd with the model marked uninitialized (must fail).
fn sc_fwd_noinit(): i64 { tx_T0 = 0; return tx_fwd(g_tok, g_V, g_T, g_C, g_F); }
# tx_fwd_packed with token id V (must fail).
fn sc_packed_tok(): i64 { return tx_fwd_packed(g_bad, g_V, g_T, g_C, g_F); }
# tx_fwd_q with the integer scratch marked unallocated (must fail).
fn sc_fwdq_noint(): i64 { ki_T0 = 0; return tx_fwd_q(0, g_tok, g_V, g_T, g_C, g_F); }
# bl_forward_q with N past the tx_int_init sizing (must fail).
fn sc_blq_cap(): i64 { return bl_forward_q(0, tx_resid0, tx_Wm, 0, tx_logits, 1, g_C, g_F * 4); }
# block_fwd with an F other than blk_init's (must fail).
fn sc_block_f(): i64 { return block_fwd(tx_resid0, tx_gns, tx_Wa, tx_Wm, g_T, g_C, g_F + 1); }
# tx_sgd with a V other than tx_init's (must fail).
fn sc_sgd_v(): i64 { return tx_sgd(g_V + 1, g_T, g_C, g_F, f64_from(0)); }
# tx_pack with dims other than the model's (must fail).
fn sc_pack_dims(): i64 { return tx_pack(g_V, g_T, g_C, g_F * 2); }

# --- 1.2.0: packed-model serialization helpers --------------------------------
var g_art_n = 0; var g_ref = 0; var g_tok_s = 0;
# A packed model of dims V, T, C, F from random parameters (seed), serialized into a
# fresh buffer; returns the buffer, its length in g_art_n, the reference serve of
# tokens g_tok_s[0..T) in g_ref (T x V logits).
fn make_artifact(V, T, C, F, seed): i64 {
    tx_init(V, T, C, F); tx_param_init(V, T, C, F, seed);
    tx_int_init(V, T, C, F); tx_pack_init(V, T, C, F); tx_pack(V, T, C, F);
    g_tok_s = t_alloc(T);
    var t = 0;
    while (t < T) { store64(g_tok_s + t * 8, (t * 5 + 3) % V); t = t + 1; }
    tx_fwd_packed(g_tok_s, V, T, C, F);
    g_ref = t_alloc(T * V); t_copy(g_ref, ki_logits, T * V);
    g_art_n = tx_pack_serial_bytes();
    var buf = alloc(g_art_n + 64);
    tx_pack_serialize(buf, g_art_n);
    return buf;
}
# 1 when a[0..n) and b[0..n) hold the same bytes.
fn same_bytes(a, b, n): i64 {
    var i = 0;
    while (i < n) { if (load8(a + i) != load8(b + i)) { return 0; } i = i + 1; }
    return 1;
}
# A private copy of an artifact (so a mutation never touches the original).
fn art_copy(src, n): i64 {
    var d = alloc(n + 64);
    var i = 0;
    while (i < n) { store8(d + i, load8(src + i)); i = i + 1; }
    return d;
}
# Recompute the trailing checksum after a deliberate mutation, so the decoder reaches
# its field checks instead of stopping at pk_err_checksum.
fn art_fix(buf, n): i64 { store64(buf + n - 8, _pk_fnv(buf, n - 8)); return 0; }
# 1 when serving tokens g_tok_s at T rows reproduces g_ref bit for bit.
fn serves_ref(V, T, C, F): i64 {
    tx_fwd_packed(g_tok_s, V, T, C, F);
    var i = 0;
    while (i < T * V) { if (tget(ki_logits, i) != tget(g_ref, i)) { return 0; } i = i + 1; }
    return 1;
}
# A packed-only (deserialized) model refuses every path that reads latent weights.
fn sc_po_fwd(): i64 { return tx_fwd(g_tok, g_V, g_T, g_C, g_F); }
# tx_fwd_q on a deserialized model (must fail: no latent weights).
fn sc_po_fwdq(): i64 { return tx_fwd_q(0, g_tok, g_V, g_T, g_C, g_F); }
# tx_bwd on a deserialized model (must fail).
fn sc_po_bwd(): i64 { return tx_bwd(g_tok, g_tgt, g_V, g_T, g_C, g_F); }
# tx_sgd on a deserialized model (must fail).
fn sc_po_sgd(): i64 { return tx_sgd(g_V, g_T, g_C, g_F, f64_from(0)); }
# tx_pack on a deserialized model (must fail: it would re-pack from zero latents).
fn sc_po_pack(): i64 { return tx_pack(g_V, g_T, g_C, g_F); }
# tx_pack_dims with no packed model live (must fail).
fn sc_dims_none(): i64 { pk_ready = 0; var d[32]; return tx_pack_dims(&d); }
# Control: a deserialized model serves.
fn sc_po_serve(): i64 { return tx_fwd_packed(g_tok, g_V, g_T, g_C, g_F); }
# Control: tx_param_init makes an ordinary model again, so tx_fwd runs.
fn sc_po_reinit(): i64 { tx_param_init(g_V, g_T, g_C, g_F, 3); return tx_fwd(g_tok, g_V, g_T, g_C, g_F); }

# 1 when every element of p[0..n) is NaN (f64_eq(v, v) is 0 only for NaN)
fn all_nan(p, n): i64 {
    var i = 0;
    while (i < n) { if (f64_eq(load64(p + i * 8), load64(p + i * 8)) == 1) { return 0; } i = i + 1; }
    return 1;
}

# ternary_matmul_free_gpu's host fallback (src/gpu.cyr) vs the scalar kernel at a
# shape whose M, K, N need not be multiples of the 8x8x8 tile: 1 = bit-identical
# outputs and 0 GPU tiles (the host has no #82).
fn gpu_fallback_matches(M, K, N, seed, withb): i64 {
    var MK = M * K; var KN = K * N; var MN = M * N;
    var x = t_alloc(MK); var W = t_alloc(KN); var Wq = t_alloc(KN); var We = t_alloc(KN);
    var qx = t_alloc(MK); var si = t_alloc(M); var yc = t_alloc(MN); var yg = t_alloc(MN);
    var b = 0;
    rng_seed(seed);
    t_randn(x, MK, f64_from(1));
    t_randn(W, KN, f64_div(f64_from(1), f64_from(2)));
    if (withb == 1) { b = t_alloc(N); t_randn(b, N, f64_from(1)); }
    var g = bl_weight_effective(W, KN, Wq, We);
    act_quant_int(x, M, K, qx, si);
    ternary_matmul_free(qx, si, Wq, g, b, yc, M, K, N);
    var tiles = ternary_matmul_free_gpu(qx, si, Wq, g, b, yg, M, K, N);
    if (tiles != 0) { return 0; }
    var i = 0;
    while (i < MN) { if (tget(yg, i) != tget(yc, i)) { return 0; } i = i + 1; }
    return 1;
}

# The correctness suite; returns the failed-assertion count.
fn main() {
    alloc_init();

    test_group("rosnet substrate smoke (linear_fwd layout)");
    # x(1x2)=[1,2], W(2x2) row-major [[3,4],[5,6]], b=0 -> y(1x2) = x@W = [1*3+2*5, 1*4+2*6] = [13,16]
    var sx = t_alloc(2); var sW = t_alloc(4); var sy = t_alloc(2);
    tset(sx, 0, f64_from(1)); tset(sx, 1, f64_from(2));
    tset(sW, 0, f64_from(3)); tset(sW, 1, f64_from(4));
    tset(sW, 2, f64_from(5)); tset(sW, 3, f64_from(6));
    linear_fwd(sx, sW, 0, sy, 1, 2, 2);
    assert(f64_eq(tget(sy, 0), f64_from(13)) == 1, "linear_fwd y[0] = 13 (x@W layout confirmed)");
    assert(f64_eq(tget(sy, 1), f64_from(16)) == 1, "linear_fwd y[1] = 16");

    test_group("ternary quantization (BitNet b1.58 absmean)");

    var N = 4;
    var w = alloc(N * 8);
    var tw = alloc(N * 8);
    var x = alloc(N * 8);

    # w = [0.9, -0.1, 0.5, -0.8]; |w| sum = 2.3; gamma = 2.3/4 = 0.575
    # w/gamma = [1.57, -0.17, 0.87, -1.39] -> round+clip -> [1, 0, 1, -1]
    tstore(w, 0, f64_div(f64_from(9), f64_from(10)));
    tstore(w, 1, f64_div(f64_from(0 - 1), f64_from(10)));
    tstore(w, 2, f64_div(f64_from(5), f64_from(10)));
    tstore(w, 3, f64_div(f64_from(0 - 8), f64_from(10)));

    var g = ternary_quantize(w, N, tw);

    # gamma = 0.575, within 1e-9
    var gexp = f64_div(f64_from(575), f64_from(1000));
    var gtol = f64_div(f64_from(1), f64_from(1000000000));
    assert(f64_lt(f64_abs(f64_sub(g, gexp)), gtol) == 1, "gamma = absmean = 0.575");

    # ternary values
    assert(tload(tw, 0) == 1, "w0  0.9 -> +1");
    assert(tload(tw, 1) == 0, "w1 -0.1 ->  0 (the b1.58 zero state)");
    assert(tload(tw, 2) == 1, "w2  0.5 -> +1");
    assert(tload(tw, 3) == (0 - 1), "w3 -0.8 -> -1");

    test_group("matmul-free dot = gamma * signed-sum (no multiply in the accumulate)");

    # x = [1, 2, 4, 3]; ternary [1,0,1,-1] -> signed sum = +1 +0 +4 -3 = 2
    tstore(x, 0, f64_from(1));
    tstore(x, 1, f64_from(2));
    tstore(x, 2, f64_from(4));
    tstore(x, 3, f64_from(3));

    var approx = ternary_dot(tw, x, N, g);
    var expect = f64_mul(f64_from(2), g);   # same op order as ternary_dot's final mul
    assert(f64_eq(approx, expect) == 1, "matmul-free dot == gamma * 2");

    test_group("BitLinear forward (weight-only ternary, on rosnet linear_fwd)");
    # latent W(K=2,N=2) row-major [[0.6,-0.6],[0.2,1.8]]; |W| sum=3.2, gamma=0.8
    # W/gamma=[0.75,-0.75,0.25,2.25] -> round/clip -> Wq=[1,-1,0,1]; Weff=[0.8,-0.8,0,0.8]
    var bK = 2; var bN = 2; var bKN = bK * bN;
    var bW = t_alloc(bKN); var bWq = t_alloc(bKN); var bWeff = t_alloc(bKN);
    tstore(bW, 0, f64_div(f64_from(6), f64_from(10)));
    tstore(bW, 1, f64_div(f64_from(0 - 6), f64_from(10)));
    tstore(bW, 2, f64_div(f64_from(2), f64_from(10)));
    tstore(bW, 3, f64_div(f64_from(18), f64_from(10)));
    # x(M=1,K=2)=[1,2]; y = x @ Weff = [1*0.8+2*0, 1*(-0.8)+2*0.8] = [0.8, 0.8]
    var bx = t_alloc(bK); tstore(bx, 0, f64_from(1)); tstore(bx, 1, f64_from(2));
    var by = t_alloc(bN);
    var bg = bl_forward_wonly(bx, bW, 0, by, 1, bK, bN, bWq, bWeff);

    assert(bl_close(bg, f64_div(f64_from(8), f64_from(10))) == 1, "gamma = absmean = 0.8");
    assert(tload(bWq, 0) == 1, "Wq0  0.75 -> +1");
    assert(tload(bWq, 1) == (0 - 1), "Wq1 -0.75 -> -1");
    assert(tload(bWq, 2) == 0, "Wq2  0.25 ->  0");
    assert(tload(bWq, 3) == 1, "Wq3  2.25 -> +1 (clipped from round 2)");
    assert(bl_close(tget(by, 0), f64_div(f64_from(8), f64_from(10))) == 1, "y[0] = 0.8 (dequantized matmul)");
    assert(bl_close(tget(by, 1), f64_div(f64_from(8), f64_from(10))) == 1, "y[1] = 0.8");

    test_group("BitLinear STE backward — finite-difference gate (prove the surrogate, not the discontinuity)");
    var gK = 4; var gN = 2; var gKN = 8; var gM = 1;
    var gW = t_alloc(gKN); var gWq = t_alloc(gKN); var gWeff = t_alloc(gKN);
    var gx = t_alloc(gK); var gy = t_alloc(gN); var gdy = t_alloc(gN);
    var gdx = t_alloc(gK); var gdW = t_alloc(gKN); var gdb = t_alloc(gN);
    var gscr = t_alloc(gKN); var gyscr = t_alloc(gN);
    # latent W (K=4,N=2), sum|W| = 8 -> gamma = 1.0; mid-bin so +-EPS can't cross a round step.
    # unsaturated (|W/g|<1): idx 0,1,2,3,6 ; saturated: 4,5,7
    tstore(gW, 0, f64_div(f64_from(3),  f64_from(10)));   #  0.3  -> Wq 0
    tstore(gW, 1, f64_div(f64_from(0-8),  f64_from(10))); # -0.8  -> Wq -1
    tstore(gW, 2, f64_div(f64_from(7),  f64_from(10)));   #  0.7  -> Wq 1
    tstore(gW, 3, f64_div(f64_from(0-2),  f64_from(10))); # -0.2  -> Wq 0
    tstore(gW, 4, f64_div(f64_from(19), f64_from(10)));   #  1.9  -> Wq 1  (saturated)
    tstore(gW, 5, f64_div(f64_from(0-21), f64_from(10))); # -2.1  -> Wq -1 (saturated)
    tstore(gW, 6, f64_div(f64_from(6),  f64_from(10)));   #  0.6  -> Wq 1
    tstore(gW, 7, f64_div(f64_from(0-14), f64_from(10))); # -1.4  -> Wq -1 (saturated, |W/g|=1.4>1)
    tstore(gx, 0, f64_from(1)); tstore(gx, 1, f64_from(2));
    tstore(gx, 2, f64_from(0-1)); tstore(gx, 3, f64_div(f64_from(1), f64_from(2)));

    # real quantized forward -> dy = y_quant (the frozen upstream gradient of 1/2||y||^2)
    var gg = bl_forward_wonly(gx, gW, 0, gy, gM, gK, gN, gWq, gWeff);
    assert(bl_close(gg, f64_from(1)) == 1, "gate: gamma = 1.0 (sum|W|/8)");
    t_copy(gdy, gy, gN);
    t_zero(gdW, gKN); t_zero(gdb, gN);
    bl_backward_wonly(gx, gWeff, gdy, gdx, gdW, gdb, gM, gK, gN, gW, gg, gscr);

    # dW gate: analytic STE dW == FD of the linearized surrogate, UNSATURATED entries only.
    # saturated entries: assert analytic dW == 0 (the clip-mask).
    var mrw = f64_from(0); var nsat = 0; var i = 0;
    while (i < gKN) {
        if (f64_lt(f64_abs(f64_div(tload(gW, i), gg)), f64_from(1)) == 1) {
            var re = bl_relerr(fd_wgrad(gx, gW, i, gdy, gM, gK, gN, gyscr), tload(gdW, i));
            if (f64_gt(re, mrw) == 1) { mrw = re; }
        } else {
            nsat = nsat + 1;
            assert(bl_close(tload(gdW, i), f64_from(0)) == 1, "gate: saturated entry dW = 0 (clip-mask)");
        }
        i = i + 1;
    }
    assert(f64_lt(mrw, bl_tol()) == 1, "gate: STE dW == FD(surrogate) on unsaturated entries");
    assert(nsat == 3, "gate: 3 entries saturated + masked");

    # dx gate: analytic dx == FD of 1/2||x@Weff||^2 (Weff fixed) — catches passing latent W to linear_bwd
    var mrx = f64_from(0); i = 0;
    while (i < gK) {
        var re2 = bl_relerr(fd_xgrad(gx, i, gWeff, gM, gK, gN, gyscr), tload(gdx, i));
        if (f64_gt(re2, mrx) == 1) { mrx = re2; }
        i = i + 1;
    }
    assert(f64_lt(mrx, bl_tol()) == 1, "gate: dx == FD through Weff (real forward weight)");

    # FALSIFIER 1: FD through the FULL quantized loss DIVERGES from the STE dW (surrogate is required)
    var mrq = f64_from(0); i = 0;
    while (i < gKN) {
        if (f64_lt(f64_abs(f64_div(tload(gW, i), gg)), f64_from(1)) == 1) {
            var re3 = bl_relerr(fd_qgrad(gx, gW, i, gM, gK, gN, gWq, gWeff, gyscr), tload(gdW, i));
            if (f64_gt(re3, mrq) == 1) { mrq = re3; }
        }
        i = i + 1;
    }
    assert(f64_gt(mrq, f64_div(f64_from(1), f64_from(2))) == 1,
      "falsifier: FD-through-quantized diverges (>0.5) -> surrogate necessary");

    # FALSIFIER 2: a masked (saturated) entry's surrogate FD is NONZERO (the mask wasn't vacuous)
    assert(f64_gt(f64_abs(fd_wgrad(gx, gW, 4, gdy, gM, gK, gN, gyscr)), bl_tol()) == 1,
      "falsifier: surrogate FD nonzero at a masked entry");

    # gamma != 1 — exercises the gamma-CANCELLATION. A spurious gamma factor in dW (the
    # rejected Lens-1 derivation) is invisible at gamma=1 but fails here by exactly gamma.
    # Scale W by 3 -> gamma=3, identical ternary structure (W*3/3 == W/1).
    var gW3 = t_alloc(gKN); var j = 0;
    while (j < gKN) { tstore(gW3, j, f64_mul(tload(gW, j), f64_from(3))); j = j + 1; }
    var gg3 = bl_forward_wonly(gx, gW3, 0, gy, gM, gK, gN, gWq, gWeff);
    assert(bl_close(gg3, f64_from(3)) == 1, "gate(g!=1): gamma = 3.0");
    t_copy(gdy, gy, gN);
    t_zero(gdW, gKN); t_zero(gdb, gN);
    bl_backward_wonly(gx, gWeff, gdy, gdx, gdW, gdb, gM, gK, gN, gW3, gg3, gscr);
    var mrw3 = f64_from(0); j = 0;
    while (j < gKN) {
        if (f64_lt(f64_abs(f64_div(tload(gW3, j), gg3)), f64_from(1)) == 1) {
            var re4 = bl_relerr(fd_wgrad(gx, gW3, j, gdy, gM, gK, gN, gyscr), tload(gdW, j));
            if (f64_gt(re4, mrw3) == 1) { mrw3 = re4; }
        }
        j = j + 1;
    }
    assert(f64_lt(mrw3, bl_tol()) == 1,
      "gate(g!=1): STE dW == FD(surrogate) at gamma=3 (gamma cancels, NO gamma factor)");

    # descent: a few STE-SGD steps reduce the quantized loss (the surrogate trains)
    var loss0 = bl_quant_loss_wonly(gx, gW, 0, gM, gK, gN, gWq, gWeff, gyscr);
    var step = 0;
    while (step < 5) {
        var gs = bl_forward_wonly(gx, gW, 0, gy, gM, gK, gN, gWq, gWeff);
        t_copy(gdy, gy, gN);
        t_zero(gdW, gKN); t_zero(gdb, gN);
        bl_backward_wonly(gx, gWeff, gdy, gdx, gdW, gdb, gM, gK, gN, gW, gs, gscr);
        t_axpy(gW, gdW, f64_div(f64_from(0-1), f64_from(20)), gKN);   # W -= 0.05 * dW
        step = step + 1;
    }
    var loss1 = bl_quant_loss_wonly(gx, gW, 0, gM, gK, gN, gWq, gWeff, gyscr);
    assert(f64_is_finite(loss1) == 1, "descent: loss finite");
    assert(f64_lt(loss1, loss0) == 1, "descent: STE-SGD reduces the quantized loss");

    test_group("BitLinear int8 activation quant + full forward (b1.58: ternary W AND int8 x)");
    var oneK = f64_div(f64_from(1), f64_from(127));   # one int8 step at absmax=1
    var ax = t_alloc(3); var axeff = t_alloc(3); var asx = t_alloc(1);
    tstore(ax, 0, f64_div(f64_from(1), f64_from(2)));   #  0.5
    tstore(ax, 1, f64_from(0 - 1));                     # -1.0  (the absmax)
    tstore(ax, 2, f64_div(f64_from(1), f64_from(4)));   #  0.25
    bl_act_quant(ax, 1, 3, axeff, asx);
    assert(bl_close(tget(asx, 0), oneK) == 1, "act: per-row scale s = absmax/127");
    assert(bl_close(tget(axeff, 1), f64_from(0 - 1)) == 1, "act: max-magnitude activation dequantizes exactly (-1.0)");
    assert(f64_lt(f64_abs(f64_sub(tget(axeff, 0), f64_div(f64_from(1), f64_from(2)))), oneK) == 1,
      "act: round-trip error < one int8 step");
    # absmax==0 guard (zero token row) — must not 127/0
    var zx = t_alloc(2); var zxeff = t_alloc(2); var zsx = t_alloc(1);
    tstore(zx, 0, f64_from(0)); tstore(zx, 1, f64_from(0));
    bl_act_quant(zx, 1, 2, zxeff, zsx);
    assert(f64_is_finite(tget(zxeff, 0)) == 1, "act: zero-row guard (no 127/0 Inf)");

    # full forward (ternary W + int8 x) runs and is finite. At THIS tiny scale the
    # ternary-W error vs full precision is large (honest-scale: b1.58 matches fp16 at 3B+).
    var fK = 4; var fN = 2; var fKN = 8;
    var hW = t_alloc(fKN); var hWq = t_alloc(fKN); var hWeff = t_alloc(fKN);
    var hx = t_alloc(fK); var hxeff = t_alloc(fK); var hsx = t_alloc(1);
    var hy = t_alloc(fN); var hdy = t_alloc(fN); var hdx = t_alloc(fK);
    var hdW = t_alloc(fKN); var hdb = t_alloc(fN); var hscr = t_alloc(fKN); var hyscr = t_alloc(fN);
    tstore(hW, 0, f64_div(f64_from(3), f64_from(10)));   tstore(hW, 1, f64_div(f64_from(0-8), f64_from(10)));
    tstore(hW, 2, f64_div(f64_from(7), f64_from(10)));   tstore(hW, 3, f64_div(f64_from(0-2), f64_from(10)));
    tstore(hW, 4, f64_div(f64_from(19), f64_from(10)));  tstore(hW, 5, f64_div(f64_from(0-21), f64_from(10)));
    tstore(hW, 6, f64_div(f64_from(6), f64_from(10)));   tstore(hW, 7, f64_div(f64_from(0-14), f64_from(10)));
    tstore(hx, 0, f64_from(1)); tstore(hx, 1, f64_from(2));
    tstore(hx, 2, f64_from(0-1)); tstore(hx, 3, f64_div(f64_from(1), f64_from(2)));
    var hg = bl_forward_full(hx, hW, 0, hy, 1, fK, fN, hWq, hWeff, hxeff, hsx);
    assert(f64_is_finite(tget(hy, 0)) == 1, "full forward: y finite (ternary W + int8 x)");

    # the WEIGHT STE still passes with activation quant on (surrogate uses the FROZEN xeff)
    t_copy(hdy, hy, fN);
    t_zero(hdW, fKN); t_zero(hdb, fN);
    bl_backward_wonly(hxeff, hWeff, hdy, hdx, hdW, hdb, 1, fK, fN, hW, hg, hscr);
    bl_ste_mask_x(hdx, hx, 1, fK, hsx);
    var mrwa = f64_from(0); var ia = 0;
    while (ia < fKN) {
        if (f64_lt(f64_abs(f64_div(tload(hW, ia), hg)), f64_from(1)) == 1) {
            var rea = bl_relerr(fd_wgrad(hxeff, hW, ia, hdy, 1, fK, fN, hyscr), tload(hdW, ia));
            if (f64_gt(rea, mrwa) == 1) { mrwa = rea; }
        }
        ia = ia + 1;
    }
    assert(f64_lt(mrwa, bl_tol()) == 1, "gate: weight STE dW == FD(surrogate) with int8 activations frozen");

    test_group("M2 bite-A: softmax cross-entropy FD gate (the smooth loss layer)");
    var sM = 4; var sV = 5; var sMV = sM * sV;
    var slog = t_alloc(sMV); var sprob = t_alloc(sMV); var sdl = t_alloc(sMV); var stgt = t_alloc(sM);
    rng_seed(7); t_randn(slog, sMV, f64_from(1));
    store64(stgt + 0, 2); store64(stgt + 8, 0); store64(stgt + 16, 4); store64(stgt + 24, 1);
    softmax_xent_fwd(slog, stgt, sprob, sM, sV);
    softmax_xent_bwd(sprob, stgt, sdl, sM, sV);
    var smr = f64_from(0); var si = 0;
    while (si < sMV) {
        var o = load64(slog + si * 8);
        store64(slog + si * 8, f64_add(o, bl_eps())); var lp = softmax_xent_fwd(slog, stgt, sprob, sM, sV);
        store64(slog + si * 8, f64_sub(o, bl_eps())); var lm = softmax_xent_fwd(slog, stgt, sprob, sM, sV);
        store64(slog + si * 8, o);
        var nd = f64_div(f64_sub(lp, lm), f64_mul(f64_from(2), bl_eps()));
        var re5 = bl_relerr(nd, load64(sdl + si * 8));
        if (f64_gt(re5, smr) == 1) { smr = re5; }
        si = si + 1;
    }
    assert(f64_lt(smr, bl_tol()) == 1, "softmax_xent dlogits == central FD (< 1e-5)");

    test_group("M2 bite-A: end-to-end gradient gate (STE head + softmax-CE loss + embedding)");
    var eK = 4; var eV = 8; var eKV = eK * eV;     # D=4, V=8
    var emb = t_alloc(eK); var eW = t_alloc(eKV); var eb = t_alloc(eV);
    var elog = t_alloc(eV); var eprob = t_alloc(eV); var edl = t_alloc(eV); var edyf = t_alloc(eV);
    var eWq = t_alloc(eKV); var eWeff = t_alloc(eKV); var escr = t_alloc(eKV);
    var edemb = t_alloc(eK); var eGW = t_alloc(eKV); var eGb = t_alloc(eV);
    var etgt = t_alloc(1); var eyscr = t_alloc(eV);
    # one embedding row + a head weight (random, mid-bin under random f64 — knees are measure-zero)
    rng_seed(11);
    tstore(emb, 0, f64_div(f64_from(5), f64_from(10)));  tstore(emb, 1, f64_div(f64_from(0-3), f64_from(10)));
    tstore(emb, 2, f64_div(f64_from(8), f64_from(10)));  tstore(emb, 3, f64_div(f64_from(0-6), f64_from(10)));
    t_randn(eW, eKV, f64_div(f64_from(1), f64_from(2)));   # std 0.5 -> a spread of saturated + unsaturated
    t_zero(eb, eV);
    store64(etgt, 3);   # arbitrary target token

    # real pipeline: forward -> softmax-CE -> dy_frozen -> STE backward
    var eg = bl_forward_wonly(emb, eW, eb, elog, 1, eK, eV, eWq, eWeff);
    softmax_xent_fwd(elog, etgt, eprob, 1, eV);
    softmax_xent_bwd(eprob, etgt, edl, 1, eV);
    t_copy(edyf, edl, eV);
    t_zero(eGW, eKV); t_zero(eGb, eV);
    bl_backward_wonly(emb, eWeff, edyf, edemb, eGW, eGb, 1, eK, eV, eW, eg, escr);

    # dW_head gate: analytic STE dW == FD of the linearized surrogate (softmax-CE dy frozen), unsaturated only
    var emrw = f64_from(0); var nuns = 0; var ei = 0;
    while (ei < eKV) {
        if (f64_lt(f64_abs(f64_div(tload(eW, ei), eg)), f64_from(1)) == 1) {
            nuns = nuns + 1;
            var re6 = bl_relerr(fd_wgrad(emb, eW, ei, edyf, 1, eK, eV, eyscr), tload(eGW, ei));
            if (f64_gt(re6, emrw) == 1) { emrw = re6; }
        } else {
            assert(bl_close(tload(eGW, ei), f64_from(0)) == 1,
              "M2: saturated head dW = 0 (clip-mask through the loss)");
        }
        ei = ei + 1;
    }
    assert(f64_lt(emrw, bl_tol()) == 1, "M2: head dW == FD(STE surrogate) with softmax-CE dy frozen");
    assert(nuns > 0, "M2: gate exercised >=1 unsaturated entry");

    # embedding gradient gate: demb == FD of the live quantized softmax-CE loss wrt embx (EXACT, no STE on this path)
    var emrx = f64_from(0); ei = 0;
    while (ei < eK) {
        var re7 = bl_relerr(fd_emb(emb, ei, eW, eb, etgt, eK, eV, eWq, eWeff, elog, eprob), tload(edemb, ei));
        if (f64_gt(re7, emrx) == 1) { emrx = re7; }
        ei = ei + 1;
    }
    assert(f64_lt(emrx, bl_tol()) == 1, "M2: embedding grad == FD of the live softmax-CE loss (end-to-end chain)");

    # FALSIFIER: FD through the quantized softmax-CE loss wrt a head weight DIVERGES from the STE dW
    var emrq = f64_from(0); ei = 0;
    while (ei < eKV) {
        if (f64_lt(f64_abs(f64_div(tload(eW, ei), eg)), f64_from(1)) == 1) {
            var re8 = bl_relerr(fd_xentw(emb, eW, ei, eb, etgt, eK, eV, eWq, eWeff, elog, eprob), tload(eGW, ei));
            if (f64_gt(re8, emrq) == 1) { emrq = re8; }
        }
        ei = ei + 1;
    }
    assert(f64_gt(emrq, f64_div(f64_from(1), f64_from(2))) == 1,
      "M2 falsifier: FD-through-quantized-loss diverges (>0.5) — STE surrogate required");

    test_group("M2 bite-A: the ternary LM trains from scratch (SGD descent)");
    var tstats = t_alloc(3);
    lm_train(8, 4, 1000, 1, tstats);   # V=8, D=4, 1000 SGD steps on the successor bigram
    assert(f64_is_finite(tget(tstats, 1)) == 1, "train: final CE finite");
    assert(f64_lt(tget(tstats, 1), tget(tstats, 0)) == 1, "train: final CE < initial CE (descent)");
    assert(f64_lt(tget(tstats, 1), f64_div(f64_from(3), f64_from(2))) == 1,
      "train: final CE < 1.5 (well below uniform ln 8 ~ 2.08)");
    assert(tget(tstats, 2) >= 6, "train: argmax memorizes >= 6/8 successor tokens");

    test_group("M2 bite-B: RMSNorm forward/backward FD gate");
    var nD = 6;
    var nx = t_alloc(nD); var ng = t_alloc(nD); var ny = t_alloc(nD);
    var ndy = t_alloc(nD); var ndx = t_alloc(nD); var ndg = t_alloc(nD); var nyscr = t_alloc(nD);
    rng_seed(5);
    t_randn(nx, nD, f64_from(1));                       # x ~ N(0,1)
    var fifth = f64_div(f64_from(1), f64_from(5));
    var ni = 0;
    # gain ~ 1 + N(0,0.2)
    while (ni < nD) { tstore(ng, ni, f64_add(f64_from(1), f64_mul(rng_normal(), fifth))); ni = ni + 1; }
    var nrstd = rmsnorm_fwd(nx, ng, ny, nD);
    t_copy(ndy, ny, nD);                               # dy = y  (loss = 1/2||y||^2)
    t_zero(ndg, nD);
    rmsnorm_bwd(nx, ng, ndy, ndx, ndg, nD, nrstd);

    # dx gate — perturbing x changes rstd (all xhat), so this exercises the full reduction
    var nmrx = f64_from(0); ni = 0;
    while (ni < nD) {
        var sv = tload(nx, ni);
        tstore(nx, ni, f64_add(sv, bl_eps())); var lp = rms_loss(nx, ng, nD, nyscr);
        tstore(nx, ni, f64_sub(sv, bl_eps())); var lm9 = rms_loss(nx, ng, nD, nyscr);
        tstore(nx, ni, sv);
        var re9 = bl_relerr(f64_div(f64_sub(lp, lm9), f64_mul(f64_from(2), bl_eps())), tload(ndx, ni));
        if (f64_gt(re9, nmrx) == 1) { nmrx = re9; }
        ni = ni + 1;
    }
    assert(f64_lt(nmrx, bl_tol()) == 1, "RMSNorm dx == central FD (< 1e-5)");

    # dg gate
    var nmrg = f64_from(0); ni = 0;
    while (ni < nD) {
        var sg = tload(ng, ni);
        tstore(ng, ni, f64_add(sg, bl_eps())); var lpg = rms_loss(nx, ng, nD, nyscr);
        tstore(ng, ni, f64_sub(sg, bl_eps())); var lmg = rms_loss(nx, ng, nD, nyscr);
        tstore(ng, ni, sg);
        var reg = bl_relerr(f64_div(f64_sub(lpg, lmg), f64_mul(f64_from(2), bl_eps())), tload(ndg, ni));
        if (f64_gt(reg, nmrg) == 1) { nmrg = reg; }
        ni = ni + 1;
    }
    assert(f64_lt(nmrg, bl_tol()) == 1, "RMSNorm dg == central FD (< 1e-5)");

    test_group("M2 bite-C: GELU forward/backward FD gate");
    var ccD = 6;
    var ccx = t_alloc(ccD); var ccy = t_alloc(ccD); var ccdy = t_alloc(ccD);
    var ccdx = t_alloc(ccD); var ccyscr = t_alloc(ccD);
    rng_seed(9);
    t_randn(ccx, ccD, f64_div(f64_from(3), f64_from(2)));   # x ~ N(0,1.5) — spans both signs
    gelu_fwd(ccx, ccy, ccD);
    t_copy(ccdy, ccy, ccD);                                 # dy = y (loss = 1/2||y||^2)
    gelu_bwd(ccx, ccdy, ccdx, ccD);
    var ccmr = f64_from(0); var cci = 0;
    while (cci < ccD) {
        var ccsv = tload(ccx, cci);
        tstore(ccx, cci, f64_add(ccsv, bl_eps())); var cclp = gelu_loss(ccx, ccD, ccyscr);
        tstore(ccx, cci, f64_sub(ccsv, bl_eps())); var cclm = gelu_loss(ccx, ccD, ccyscr);
        tstore(ccx, cci, ccsv);
        var ccre = bl_relerr(f64_div(f64_sub(cclp, cclm), f64_mul(f64_from(2), bl_eps())), tload(ccdx, cci));
        if (f64_gt(ccre, ccmr) == 1) { ccmr = ccre; }
        cci = cci + 1;
    }
    assert(f64_lt(ccmr, bl_tol()) == 1, "GELU dx == central FD (< 1e-5)");

    test_group("M2 bite-D: scaled-dot-product self-attention (causal) FD gate");
    var aT = 3; var aD = 4; var aTD = aT * aD; var aTT = aT * aT;
    var aQ = t_alloc(aTD); var aK = t_alloc(aTD); var aV = t_alloc(aTD);
    var aP = t_alloc(aTT); var actx = t_alloc(aTD); var adctx = t_alloc(aTD);
    var adQ = t_alloc(aTD); var adK = t_alloc(aTD); var adV = t_alloc(aTD); var adprow = t_alloc(aT);
    var aPscr = t_alloc(aTT); var acscr = t_alloc(aTD);
    rng_seed(13);
    t_randn(aQ, aTD, f64_from(1)); t_randn(aK, aTD, f64_from(1)); t_randn(aV, aTD, f64_from(1));
    attn_fwd(aQ, aK, aV, aP, actx, aT, aD);
    t_copy(adctx, actx, aTD);                       # dctx = ctx (loss = 1/2||ctx||^2)
    attn_bwd(aQ, aK, aV, aP, adctx, adQ, adK, adV, adprow, aT, aD);
    var amrq = f64_from(0); var amrk = f64_from(0); var amrv = f64_from(0); var ai = 0;
    while (ai < aTD) {
        var sq = tload(aQ, ai);
        tstore(aQ, ai, f64_add(sq, bl_eps())); var lpq = attn_loss(aQ, aK, aV, aT, aD, aPscr, acscr);
        tstore(aQ, ai, f64_sub(sq, bl_eps())); var lmq = attn_loss(aQ, aK, aV, aT, aD, aPscr, acscr);
        tstore(aQ, ai, sq);
        var req = bl_relerr(f64_div(f64_sub(lpq, lmq), f64_mul(f64_from(2), bl_eps())), tload(adQ, ai));
        if (f64_gt(req, amrq) == 1) { amrq = req; }
        var sk = tload(aK, ai);
        tstore(aK, ai, f64_add(sk, bl_eps())); var lpk = attn_loss(aQ, aK, aV, aT, aD, aPscr, acscr);
        tstore(aK, ai, f64_sub(sk, bl_eps())); var lmk = attn_loss(aQ, aK, aV, aT, aD, aPscr, acscr);
        tstore(aK, ai, sk);
        var rek = bl_relerr(f64_div(f64_sub(lpk, lmk), f64_mul(f64_from(2), bl_eps())), tload(adK, ai));
        if (f64_gt(rek, amrk) == 1) { amrk = rek; }
        var svv = tload(aV, ai);
        tstore(aV, ai, f64_add(svv, bl_eps())); var lpv = attn_loss(aQ, aK, aV, aT, aD, aPscr, acscr);
        tstore(aV, ai, f64_sub(svv, bl_eps())); var lmv = attn_loss(aQ, aK, aV, aT, aD, aPscr, acscr);
        tstore(aV, ai, svv);
        var rev = bl_relerr(f64_div(f64_sub(lpv, lmv), f64_mul(f64_from(2), bl_eps())), tload(adV, ai));
        if (f64_gt(rev, amrv) == 1) { amrv = rev; }
        ai = ai + 1;
    }
    assert(f64_lt(amrq, bl_tol()) == 1, "attention dQ == central FD (< 1e-5)");
    assert(f64_lt(amrk, bl_tol()) == 1, "attention dK == central FD (< 1e-5)");
    assert(f64_lt(amrv, bl_tol()) == 1, "attention dV == central FD (< 1e-5)");

    test_group("M2 bite-E1: attention sublayer (BitLinear Q/K/V/O + attn + residual) — end-to-end dx gate");
    var qC = 4; var qT = 3; var qTC = qT * qC; var qCC = qC * qC;
    blk_init(qT, qC, 8);
    var qx = t_alloc(qTC); var qg1 = t_alloc(qC); var qW = t_alloc(4 * qCC);
    var qdx = t_alloc(qTC); var qdg1 = t_alloc(qC); var qdW = t_alloc(4 * qCC); var qdout = t_alloc(qTC);
    rng_seed(21);
    t_randn(qx, qTC, f64_from(1));
    var qj = 0; while (qj < qC) { tstore(qg1, qj, f64_from(1)); qj = qj + 1; }    # RMSNorm gain = 1
    t_randn(qW, 4 * qCC, f64_div(f64_from(1), f64_from(2)));                      # weights std 0.5
    attn_sublayer_fwd(qx, qg1, qW, qT, qC);
    t_copy(qdout, blk_out, qTC);                                                 # dout = out (loss = 1/2||out||^2)
    t_zero(qdW, 4 * qCC); t_zero(qdg1, qC);
    attn_sublayer_bwd(qdout, qx, qg1, qW, qdx, qdg1, qdW, qT, qC);
    assert(f64_is_finite(tget(qdx, 0)) == 1, "E1: dx finite");

    var qmr = f64_from(0); var qk = 0;
    while (qk < qTC) {
        var qsv = tload(qx, qk);
        tstore(qx, qk, f64_add(qsv, bl_eps())); var qlp = attn_sublayer_loss(qx, qg1, qW, qT, qC);
        tstore(qx, qk, f64_sub(qsv, bl_eps())); var qlm = attn_sublayer_loss(qx, qg1, qW, qT, qC);
        tstore(qx, qk, qsv);
        var qre = bl_relerr(f64_div(f64_sub(qlp, qlm), f64_mul(f64_from(2), bl_eps())), tload(qdx, qk));
        if (f64_gt(qre, qmr) == 1) { qmr = qre; }
        qk = qk + 1;
    }
    assert(f64_lt(qmr, bl_tol()) == 1, "E1: attention sublayer dx == central FD (< 1e-5) — full fwd+bwd chain");

    var qdwnz = 0; qk = 0;
    while (qk < 4 * qCC) { if (f64_gt(f64_abs(tload(qdW, qk)), bl_tol()) == 1) { qdwnz = 1; } qk = qk + 1; }
    assert(qdwnz == 1, "E1: projection weight grads nonzero (STE accumulated through the block)");

    test_group("M2 bite-E2: MLP sublayer (RMSNorm + BitLinear up/GELU/down + residual) — end-to-end dx gate");
    var u2C = 4; var u2T = 3; var u2F = 8; var u2TC = u2T * u2C; var u2CF = u2C * u2F;
    blk_init(u2T, u2C, u2F);
    var u2x = t_alloc(u2TC); var u2g = t_alloc(u2C); var u2W = t_alloc(2 * u2CF);
    var u2dx = t_alloc(u2TC); var u2dg = t_alloc(u2C); var u2dW = t_alloc(2 * u2CF); var u2dout = t_alloc(u2TC);
    rng_seed(31);
    t_randn(u2x, u2TC, f64_from(1));
    var u2j = 0; while (u2j < u2C) { tstore(u2g, u2j, f64_from(1)); u2j = u2j + 1; }
    t_randn(u2W, 2 * u2CF, f64_div(f64_from(1), f64_from(2)));
    mlp_sublayer_fwd(u2x, u2g, u2W, u2T, u2C, u2F);
    t_copy(u2dout, mlp_out, u2TC);
    t_zero(u2dW, 2 * u2CF); t_zero(u2dg, u2C);
    mlp_sublayer_bwd(u2dout, u2x, u2g, u2W, u2dx, u2dg, u2dW, u2T, u2C, u2F);
    assert(f64_is_finite(tget(u2dx, 0)) == 1, "E2: dx finite");
    var u2mr = f64_from(0); var u2k = 0;
    while (u2k < u2TC) {
        var u2sv = tload(u2x, u2k);
        tstore(u2x, u2k, f64_add(u2sv, bl_eps())); var u2lp = mlp_sublayer_loss(u2x, u2g, u2W, u2T, u2C, u2F);
        tstore(u2x, u2k, f64_sub(u2sv, bl_eps())); var u2lm = mlp_sublayer_loss(u2x, u2g, u2W, u2T, u2C, u2F);
        tstore(u2x, u2k, u2sv);
        var u2re = bl_relerr(f64_div(f64_sub(u2lp, u2lm), f64_mul(f64_from(2), bl_eps())), tload(u2dx, u2k));
        if (f64_gt(u2re, u2mr) == 1) { u2mr = u2re; }
        u2k = u2k + 1;
    }
    assert(f64_lt(u2mr, bl_tol()) == 1, "E2: MLP sublayer dx == central FD (< 1e-5) — full fwd+bwd chain");

    test_group("M2 bite-E3: full pre-norm block (attention + MLP sublayers) — end-to-end dx gate");
    var u3C = 4; var u3T = 3; var u3F = 8; var u3TC = u3T * u3C; var u3CC = u3C * u3C; var u3CF = u3C * u3F;
    blk_init(u3T, u3C, u3F);
    var u3x = t_alloc(u3TC); var u3gns = t_alloc(2 * u3C); var u3Wa = t_alloc(4 * u3CC); var u3Wm = t_alloc(2 * u3CF);
    var u3dx = t_alloc(u3TC); var u3dgns = t_alloc(2 * u3C); var u3dWa = t_alloc(4 * u3CC);
    var u3dWm = t_alloc(2 * u3CF); var u3dout = t_alloc(u3TC);
    rng_seed(37);
    t_randn(u3x, u3TC, f64_from(1));
    var u3j = 0; while (u3j < 2 * u3C) { tstore(u3gns, u3j, f64_from(1)); u3j = u3j + 1; }   # g1, g2 = 1
    t_randn(u3Wa, 4 * u3CC, f64_div(f64_from(1), f64_from(2)));
    t_randn(u3Wm, 2 * u3CF, f64_div(f64_from(1), f64_from(2)));
    block_fwd(u3x, u3gns, u3Wa, u3Wm, u3T, u3C, u3F);
    t_copy(u3dout, mlp_out, u3TC);
    t_zero(u3dWa, 4 * u3CC); t_zero(u3dWm, 2 * u3CF); t_zero(u3dgns, 2 * u3C);
    block_bwd(u3dout, u3x, u3gns, u3Wa, u3Wm, u3dx, u3dgns, u3dWa, u3dWm, u3T, u3C, u3F);
    assert(f64_is_finite(tget(u3dx, 0)) == 1, "E3: dx finite");
    var u3mr = f64_from(0); var u3k = 0;
    while (u3k < u3TC) {
        var u3sv = tload(u3x, u3k);
        tstore(u3x, u3k, f64_add(u3sv, bl_eps())); var u3lp = block_loss(u3x, u3gns, u3Wa, u3Wm, u3T, u3C, u3F);
        tstore(u3x, u3k, f64_sub(u3sv, bl_eps())); var u3lm = block_loss(u3x, u3gns, u3Wa, u3Wm, u3T, u3C, u3F);
        tstore(u3x, u3k, u3sv);
        var u3re = bl_relerr(f64_div(f64_sub(u3lp, u3lm), f64_mul(f64_from(2), bl_eps())), tload(u3dx, u3k));
        if (f64_gt(u3re, u3mr) == 1) { u3mr = u3re; }
        u3k = u3k + 1;
    }
    assert(f64_lt(u3mr, bl_tol()) == 1,
      "E3: full block dx == central FD (< 1e-5) — both sublayers + residual threading");

    test_group("M2 bite-E4a: transformer LM fwd/bwd — end-to-end embedding-gradient FD gate");
    var w4V = 6; var w4T = 4; var w4C = 4; var w4F = 8;
    tx_init(w4V, w4T, w4C, w4F);
    tx_param_init(w4V, w4T, w4C, w4F, 41);
    var w4tok = t_alloc(w4T); var w4tgt = t_alloc(w4T);
    store64(w4tok + 0, 1); store64(w4tok + 8, 4); store64(w4tok + 16, 2); store64(w4tok + 24, 5);
    store64(w4tgt + 0, 4); store64(w4tgt + 8, 2); store64(w4tgt + 16, 5); store64(w4tgt + 24, 3);
    tx_loss(w4tok, w4tgt, w4V, w4T, w4C, w4F);
    tx_zero_grads(w4V, w4T, w4C, w4F);
    tx_bwd(w4tok, w4tgt, w4V, w4T, w4C, w4F);
    assert(f64_is_finite(tget(tx_dtokemb, 4)) == 1, "E4a: d_tokemb finite");

    var w4mr = f64_from(0); var w4k = 0;
    while (w4k < w4V * w4C) {
        var w4sv = load64(tx_tokemb + w4k * 8);
        store64(tx_tokemb + w4k * 8, f64_add(w4sv, bl_eps())); var w4lp = tx_loss(w4tok, w4tgt, w4V, w4T, w4C, w4F);
        store64(tx_tokemb + w4k * 8, f64_sub(w4sv, bl_eps())); var w4lm = tx_loss(w4tok, w4tgt, w4V, w4T, w4C, w4F);
        store64(tx_tokemb + w4k * 8, w4sv);
        var w4fd = f64_div(f64_sub(w4lp, w4lm), f64_mul(f64_from(2), bl_eps()));
        var w4re = bl_relerr(w4fd, load64(tx_dtokemb + w4k * 8));
        if (f64_gt(w4re, w4mr) == 1) { w4mr = w4re; }
        w4k = w4k + 1;
    }
    assert(f64_lt(w4mr, bl_tol()) == 1,
      "E4a: d_tokemb == FD of CE loss (embed scatter + block + final-norm + head + softmax-CE)");

    var w4mrp = f64_from(0); w4k = 0;
    while (w4k < w4T * w4C) {
        var w4s2 = load64(tx_posemb + w4k * 8);
        store64(tx_posemb + w4k * 8, f64_add(w4s2, bl_eps())); var w4p2 = tx_loss(w4tok, w4tgt, w4V, w4T, w4C, w4F);
        store64(tx_posemb + w4k * 8, f64_sub(w4s2, bl_eps())); var w4m2 = tx_loss(w4tok, w4tgt, w4V, w4T, w4C, w4F);
        store64(tx_posemb + w4k * 8, w4s2);
        var w4fd2 = f64_div(f64_sub(w4p2, w4m2), f64_mul(f64_from(2), bl_eps()));
        var w4r2 = bl_relerr(w4fd2, load64(tx_dposemb + w4k * 8));
        if (f64_gt(w4r2, w4mrp) == 1) { w4mrp = w4r2; }
        w4k = w4k + 1;
    }
    assert(f64_lt(w4mrp, bl_tol()) == 1, "E4a: d_posemb == FD of CE loss");

    test_group("M2 bite-E4b: the ternary transformer LM trains from scratch (the first loss curve)");
    var w5tok = t_alloc(4); var w5tgt = t_alloc(4);
    store64(w5tok + 0, 1); store64(w5tok + 8, 4); store64(w5tok + 16, 2); store64(w5tok + 24, 5);
    store64(w5tgt + 0, 4); store64(w5tgt + 8, 2); store64(w5tgt + 16, 5); store64(w5tgt + 24, 3);
    var w5st = t_alloc(2);
    tx_train(w5tok, w5tgt, 6, 4, 4, 8, 1000, 1, w5st);   # V=6, T=4, C=4, F=8, 1000 SGD steps
    assert(f64_is_finite(tget(w5st, 1)) == 1, "E4b: final CE finite");
    assert(f64_lt(tget(w5st, 1), tget(w5st, 0)) == 1, "E4b: final CE < initial CE (the transformer descends)");
    assert(f64_lt(tget(w5st, 1), f64_div(f64_from(1), f64_from(2))) == 1,
      "E4b: final CE < 0.5 (memorizes the sequence; uniform baseline ln 6 ~ 1.79)");

    test_group("M2 bite-F: the ternary transformer trains on a REAL akshara-tokenized corpus");
    var fct = alloc(16);   # "hello world" as raw ASCII bytes
    store8(fct + 0, 104); store8(fct + 1, 101); store8(fct + 2, 108); store8(fct + 3, 108); store8(fct + 4, 111);
    store8(fct + 5, 32);
    store8(fct + 6, 119); store8(fct + 7, 111); store8(fct + 8, 114); store8(fct + 9, 108); store8(fct + 10, 100);
    var fcV = corpus_set(fct, 11);
    assert(fcV == 8, "bite-F: akshara byte-tokenizes 'hello world' -> V=8 distinct tokens");
    var fcT = 11 - 1;
    var fctok = t_alloc(fcT); var fctgt = t_alloc(fcT);
    var fci = 0;
    while (fci < fcT) { store64(fctok + fci * 8, gd_ld(fci)); store64(fctgt + fci * 8, gd_ld(fci + 1)); fci = fci + 1; }
    var fcst = t_alloc(2);
    tx_train(fctok, fctgt, fcV, fcT, 4, 8, 1500, 1, fcst);
    assert(f64_is_finite(tget(fcst, 1)) == 1, "bite-F: final CE finite");
    assert(f64_lt(tget(fcst, 1), tget(fcst, 0)) == 1,
      "bite-F: final CE < initial (trains on real akshara-tokenized text)");
    assert(f64_lt(tget(fcst, 1), f64_div(f64_from(1), f64_from(2))) == 1,
      "bite-F: final CE < 0.5 (learns the corpus; baseline ln 8 ~ 2.08)");

    test_group("M3: matmul-free integer kernel reproduces the f64-latent forward (logit parity)");
    var m3M = 2; var m3K = 4; var m3N = 3; var m3MK = m3M * m3K; var m3KN = m3K * m3N; var m3MN = m3M * m3N;
    var m3x = t_alloc(m3MK); var m3W = t_alloc(m3KN); var m3Wq = t_alloc(m3KN); var m3We = t_alloc(m3KN);
    var m3xe = t_alloc(m3MK); var m3sf = t_alloc(m3M); var m3yf = t_alloc(m3MN);
    var m3qx = t_alloc(m3MK); var m3si = t_alloc(m3M); var m3yi = t_alloc(m3MN);
    rng_seed(51);
    t_randn(m3x, m3MK, f64_from(1));
    t_randn(m3W, m3KN, f64_div(f64_from(1), f64_from(2)));
    # f64 path: bl_forward_full (int8-dequant activations @ dequant ternary weights)
    var m3g = bl_forward_full(m3x, m3W, 0, m3yf, m3M, m3K, m3N, m3Wq, m3We, m3xe, m3sf);
    # integer path: same quantization, but integer signed-accumulate + a single dequant
    act_quant_int(m3x, m3M, m3K, m3qx, m3si);
    ternary_matmul_free(m3qx, m3si, m3Wq, m3g, 0, m3yi, m3M, m3K, m3N);
    var m3mr = f64_from(0); var m3i = 0;
    while (m3i < m3MN) {
        var re = bl_relerr(tget(m3yi, m3i), tget(m3yf, m3i));
        if (f64_gt(re, m3mr) == 1) { m3mr = re; }
        m3i = m3i + 1;
    }
    assert(f64_lt(m3mr, f64_div(f64_from(1), f64_from(1000000000))) == 1,
      "M3: integer kernel logits == f64 forward (< 1e-9; integer accumulate is exact)");

    test_group("M3: 2-bit packed ternary storage round-trips (the ~1.58-bit memory payoff)");
    var m3pk = alloc((m3KN + 3) / 4);
    tpack2(m3Wq, m3KN, m3pk);
    var m3ok = 1; m3i = 0;
    while (m3i < m3KN) { if (tunpack2(m3pk, m3i) != tload(m3Wq, m3i)) { m3ok = 0; } m3i = m3i + 1; }
    assert(m3ok == 1, "M3: tpack2/tunpack2 round-trip exact (2 bits/weight, 32x smaller than f64)");

    test_group("M3b: branchless kernel is bit-identical to the branchy kernel (branch elimination only)");
    # same inputs as the M3 parity group (m3qx/m3si/m3Wq/m3g); m3yi holds the branchy output.
    var m3yb = t_alloc(m3MN);
    ternary_matmul_free_bl(m3qx, m3si, m3Wq, m3g, 0, m3yb, m3M, m3K, m3N);
    var m3bok = 1; m3i = 0;
    while (m3i < m3MN) { if (tget(m3yb, m3i) != tget(m3yi, m3i)) { m3bok = 0; } m3i = m3i + 1; }
    assert(m3bok == 1,
      "M3b: ternary_matmul_free_bl == ternary_matmul_free bit-for-bit (mask arithmetic, no value change)");

    test_group("M3d: integer-SIMD kernel (iv_dp8) is bit-identical to the scalar kernel (0.4.1)");
    # The exactness argument (kernel.cyr): ternary weights bound each pmaddubsw
    # pair-sum by 510 << 32767 (no i16 saturation) and the +128 u8-offset correction
    # is exact integer algebra — so the SIMD accumulate is the SAME i64, and the
    # dequant expression is shared => identical f64 bits. Three K regimes:
    assert(m3s_simd_matches(2, 4, 3, 71) == 1, "M3d: K=4 (K16=0, pure branchless tail) bit-identical");
    assert(m3s_simd_matches(3, 20, 5, 72) == 1,
      "M3d: K=20 (16-lane SIMD span + 4-wide tail, offset correction split) bit-identical");
    assert(m3s_simd_matches(2, 32, 7, 73) == 1, "M3d: K=32 (pure iv_dp8 span, two lane-groups) bit-identical");

    test_group("M3c: whole-model integer inference reproduces the f64 forward (parity + activation-quant delta)");
    # Train a tiny transformer, then run it three ways: the weight-only f64 model that
    # was trained, the full-quant f64 reference (int8 acts, f64 matmul), and the integer
    # matmul-free kernel. The kernel runs through ALL 7 BitLinears (Q/K/V/O + up/down + head).
    var ciV = 6; var ciT = 4; var ciC = 4; var ciF = 8; var ciTV = ciT * ciV;
    var citok = t_alloc(ciT); var citgt = t_alloc(ciT);
    store64(citok + 0, 1); store64(citok + 8, 4); store64(citok + 16, 2); store64(citok + 24, 5);
    store64(citgt + 0, 4); store64(citgt + 8, 2); store64(citgt + 16, 5); store64(citgt + 24, 3);
    var cist = t_alloc(2);
    tx_train(citok, citgt, ciV, ciT, ciC, ciF, 1000, 1, cist);   # trains (the bite-E4b config)
    tx_int_init(ciV, ciT, ciC, ciF);
    tx_fwd(citok, ciV, ciT, ciC, ciF);                           # weight-only f64 — the trained model
    var li_wo = t_alloc(ciTV); t_copy(li_wo, tx_logits, ciTV);
    tx_fwd_q(1, citok, ciV, ciT, ciC, ciF);                      # full-quant f64 reference
    var li_fq = t_alloc(ciTV); t_copy(li_fq, ki_logits, ciTV);
    tx_fwd_q(0, citok, ciV, ciT, ciC, ciF);                      # integer kernel — the payoff
    # EXACT gate: whole-model integer logits reproduce the full-quant f64 forward (the
    # integer accumulate adds no rounding; only the f64 reference rounds) — the M3a
    # per-layer parity, now composed through all 7 BitLinears + the f64 interludes.
    var ci_mx = f64_from(0); var cii = 0;
    while (cii < ciTV) {
        var ce = bl_relerr(tget(ki_logits, cii), tget(li_fq, cii));
        if (f64_gt(ce, ci_mx) == 1) { ci_mx = ce; }
        cii = cii + 1;
    }
    assert(f64_lt(ci_mx, f64_div(f64_from(1), f64_from(1000000000))) == 1,
      "M3c: whole-model integer logits match full-quant f64 (< 1e-9 relerr; all 7 BitLinears)");
    # HONEST delta: integer vs the weight-only TRAINED model (int8-quantizing activations
    # the model never saw at train time) — a small nonzero gap (reported, not hidden).
    var ci_d = f64_from(0); cii = 0;
    while (cii < ciTV) {
        var cd = f64_abs(f64_sub(tget(ki_logits, cii), tget(li_wo, cii)));
        if (f64_gt(cd, ci_d) == 1) { ci_d = cd; }
        cii = cii + 1;
    }
    assert(f64_is_finite(ci_d) == 1,
      "M3c: integer-vs-trained activation-quant delta is finite (the honest small-scale gap)");
    # argmax agreement: the int8-activation integer model predicts the same next token as
    # the trained f64 model at every position (the small logit delta doesn't flip the rank).
    var ci_ag = 0; var ci_t = 0;
    while (ci_t < ciT) {
        var ci_o = ci_t * ciV * 8;
        if (logits_argmax(ki_logits + ci_o, ciV) == logits_argmax(li_wo + ci_o, ciV)) { ci_ag = ci_ag + 1; }
        ci_t = ci_t + 1;
    }
    assert(ci_ag == ciT, "M3c: integer inference argmax matches the trained f64 model at all T positions");
    # 0.4.1: the SIMD kernel through the whole model (mode 2) — all 7 BitLinears at
    # C=4/F=8 run below one 16-lane group (pure-tail) and the head carries the bias;
    # logits must be BIT-IDENTICAL to the scalar integer path (mode 0, saved above).
    var li_int = t_alloc(ciTV); t_copy(li_int, ki_logits, ciTV);
    tx_fwd_q(2, citok, ciV, ciT, ciC, ciF);
    var ci_sok = 1; cii = 0;
    while (cii < ciTV) { if (tget(ki_logits, cii) != tget(li_int, cii)) { ci_sok = 0; } cii = cii + 1; }
    assert(ci_sok == 1,
      "M3d: whole-model SIMD inference (mode 2) bit-identical to the scalar integer kernel (incl. the biased head)");

    test_group("0.7.0 pack-once deployment inference (tx_pack_init / tx_pack / tx_fwd_packed)");
    # Quantize + pack the trained model ONCE, then serve — same quantize, same
    # pack, same kernel as mode 2, hoisted out of the call => logits BIT-IDENTICAL
    # to the scalar integer path (li_int, saved above). A second serve from the
    # same packed store must reproduce them (the store is read-only at serve time).
    tx_pack_init(ciV, ciT, ciC, ciF);
    tx_pack(ciV, ciT, ciC, ciF);
    tx_fwd_packed(citok, ciV, ciT, ciC, ciF);
    var pk_ok = 1; cii = 0;
    while (cii < ciTV) { if (tget(ki_logits, cii) != tget(li_int, cii)) { pk_ok = 0; } cii = cii + 1; }
    assert(pk_ok == 1,
      "0.7.0: packed serving logits bit-identical to the scalar integer kernel (pack hoisted, nothing else changed)");
    tx_fwd_packed(citok, ciV, ciT, ciC, ciF);
    var pk_ok2 = 1; cii = 0;
    while (cii < ciTV) { if (tget(ki_logits, cii) != tget(li_int, cii)) { pk_ok2 = 0; } cii = cii + 1; }
    assert(pk_ok2 == 1,
      "0.7.0: a second serve from the same packed store reproduces the logits (store is serve-time read-only)");

    test_group("0.8.0 hardening gates (audit fixes)");
    # gamma == 0 (all-zero weights): ternary_one divided by zero -> Inf/NaN ->
    # f64_to -> INT_MIN -> clipped to -1, so an all-zero vector quantized to all
    # -1 (silent sign garbage). Fixed: gamma==0 => 0 (b1.58: gamma==0 <=> all-zero).
    var hz_w = t_alloc(4);   # t_alloc zero-fills
    var hz_q = t_alloc(4);
    var hz_g = ternary_quantize(hz_w, 4, hz_q);
    assert(f64_eq(hz_g, f64_from(0)) == 1, "0.8.0: all-zero weights quantize with gamma == 0");
    var hz_ok = 1; var hzi = 0;
    while (hzi < 4) { if (tload(hz_q, hzi) != 0) { hz_ok = 0; } hzi = hzi + 1; }
    assert(hz_ok == 1, "0.8.0: all-zero weights quantize to all-ZERO ternary codes (was all -1 pre-fix)");
    assert(ternary_one(f64_from(3), f64_from(0)) == 0,
      "0.8.0: ternary_one(w, gamma=0) returns 0, not the INT_MIN-clip -1");
    # guard() itself: the pass path is a no-op (the fail path exits the process —
    # exercised by construction on every guarded entry throughout this suite).
    assert(guard(1, "never printed") == 0, "0.8.0: guard(cond=1) passes through");

    test_group("0.6.0 API-freeze gates: every public entry point exercised directly");
    # ref_dot — the M0 full-precision baseline dot (exact-int f64s => exact result).
    var rd_w = t_alloc(2); var rd_x = t_alloc(2);
    tstore(rd_w, 0, f64_from(2)); tstore(rd_w, 1, f64_from(3));
    tstore(rd_x, 0, f64_from(1)); tstore(rd_x, 1, f64_from(1));
    assert(f64_eq(ref_dot(rd_w, rd_x, 2), f64_from(5)) == 1,
      "API: ref_dot exact on integer-valued f64s (2*1 + 3*1 = 5)");
    # bl_forward_q — the per-layer mode dispatcher, called directly (drivers above
    # reach it only through tx_fwd_q). ki_* scratch is live from tx_int_init; the
    # M3 group's m3x/m3W (M=2, K=4, N=3) fit inside the ciC=4/ciF=8/ciV=6 sizing.
    var bq_y0 = t_alloc(m3MN); var bq_y2 = t_alloc(m3MN);
    var bq_g0 = bl_forward_q(0, m3x, m3W, 0, bq_y0, m3M, m3K, m3N);
    var bq_g2 = bl_forward_q(2, m3x, m3W, 0, bq_y2, m3M, m3K, m3N);
    assert(bq_g0 == bq_g2, "API: bl_forward_q returns the same gamma for mode 0 and mode 2 (same quantization)");
    var bq_ok = 1; var bqi = 0;
    while (bqi < m3MN) { if (tget(bq_y0, bqi) != tget(bq_y2, bqi)) { bq_ok = 0; } bqi = bqi + 1; }
    assert(bq_ok == 1, "API: bl_forward_q mode 2 (SIMD) bit-identical to mode 0 (scalar) through the dispatcher");
    # The manual training-loop quartet (tx_loss -> tx_zero_grads -> tx_bwd -> tx_sgd)
    # composed BY THE CALLER, from a fresh init — the public surface tx_train wraps.
    # (Re-points the tx_* globals; placed after every gate that reads the M3c model.)
    tx_init(ciV, ciT, ciC, ciF);
    tx_param_init(ciV, ciT, ciC, ciF, 7);
    var mq_l0 = tx_loss(citok, citgt, ciV, ciT, ciC, ciF);
    var mq_nlr = f64_div(f64_from(0 - 1), f64_from(10));
    var mq_s = 0;
    while (mq_s < 5) {
        tx_zero_grads(ciV, ciT, ciC, ciF);
        tx_loss(citok, citgt, ciV, ciT, ciC, ciF);
        tx_bwd(citok, citgt, ciV, ciT, ciC, ciF);
        tx_sgd(ciV, ciT, ciC, ciF, mq_nlr);
        mq_s = mq_s + 1;
    }
    var mq_l1 = tx_loss(citok, citgt, ciV, ciT, ciC, ciF);
    assert(f64_is_finite(mq_l1) == 1, "API: manually-composed train step (zero/loss/bwd/sgd) keeps the loss finite");
    assert(f64_lt(mq_l1, mq_l0) == 1,
      "API: 5 manually-composed SGD steps descend the loss (the quartet tx_train wraps)");

    test_group("1.1.2 P(-1) sweep: repairs and hardening");
    # (a) the activation STE mask. At the row max, a/(a/127) rounds to 127.00000000000001
    # for absmax a = 1.1, and the old |x/s| > 127 test zeroed that element's gradient
    # although the forward never clamped it. Saturated now means |x/s| >= 127.5.
    var mx_x = t_alloc(3); var mx_xe = t_alloc(3); var mx_s = t_alloc(1); var mx_dx = t_alloc(3);
    tstore(mx_x, 0, f64_div(f64_from(11), f64_from(10)));        # 1.1, the absmax
    tstore(mx_x, 1, f64_div(f64_from(0 - 1), f64_from(2)));
    tstore(mx_x, 2, f64_div(f64_from(1), f64_from(4)));
    bl_act_quant(mx_x, 1, 3, mx_xe, mx_s);
    assert(f64_gt(f64_div(tload(mx_x, 0), tload(mx_s, 0)), f64_from(127)) == 1,
      "1.1.2 maskx: the case is live (1.1 / s rounds above 127)");
    t_fill(mx_dx, 3, f64_from(1));
    bl_ste_mask_x(mx_dx, mx_x, 1, 3, mx_s);
    assert(f64_eq(tload(mx_dx, 0), f64_from(1)) == 1, "1.1.2 maskx: the row max keeps its gradient (it was zeroed)");
    assert(f64_eq(tload(mx_dx, 1), f64_from(1)) == 1, "1.1.2 maskx: an interior element keeps its gradient");
    # a caller scale small enough to saturate: x/s = 200 (masked), 127.4 (kept), 127.5 (masked)
    tstore(mx_s, 0, f64_from(1));
    tstore(mx_x, 0, f64_from(200));
    tstore(mx_x, 1, f64_div(f64_from(1274), f64_from(10)));
    tstore(mx_x, 2, f64_div(f64_from(255), f64_from(2)));
    t_fill(mx_dx, 3, f64_from(1));
    bl_ste_mask_x(mx_dx, mx_x, 1, 3, mx_s);
    assert(f64_eq(tload(mx_dx, 0), f64_from(0)) == 1, "1.1.2 maskx: |x/s| = 200 is saturated and masked");
    assert(f64_eq(tload(mx_dx, 1), f64_from(1)) == 1, "1.1.2 maskx: |x/s| = 127.4 rounds to 127, not masked");
    assert(f64_eq(tload(mx_dx, 2), f64_from(0)) == 1, "1.1.2 maskx: |x/s| = 127.5 rounds past 127, masked");

    # (b) a NaN activation propagates through the integer path instead of becoming a code
    var nn_K = 5;
    var nn_x = t_alloc(2 * nn_K); var nn_q = t_alloc(2 * nn_K); var nn_s = t_alloc(2);
    var nn_W = t_alloc(nn_K * 3); var nn_Wq = t_alloc(nn_K * 3); var nn_We = t_alloc(nn_K * 3);
    var nn_y = t_alloc(6); var nn_y1 = t_alloc(3); var nn_q1 = t_alloc(nn_K); var nn_s1 = t_alloc(1);
    rng_seed(91); t_randn(nn_x, 2 * nn_K, f64_from(1)); t_randn(nn_W, nn_K * 3, f64_from(1));
    tstore(nn_x, nn_K + 2, f64_div(f64_from(0), f64_from(0)));   # row 1 holds a NaN
    var nn_g = bl_weight_effective(nn_W, nn_K * 3, nn_Wq, nn_We);
    act_quant_int(nn_x, 2, nn_K, nn_q, nn_s);
    assert(all_nan(nn_s + 8, 1) == 1, "1.1.2 NaN: act_quant_int gives the NaN row a NaN scale");
    ternary_matmul_free(nn_q, nn_s, nn_Wq, nn_g, 0, nn_y, 2, nn_K, 3);
    assert(all_nan(nn_y + 24, 3) == 1, "1.1.2 NaN: every output of the NaN row is NaN (was a finite logit)");
    act_quant_int(nn_x, 1, nn_K, nn_q1, nn_s1);
    ternary_matmul_free(nn_q1, nn_s1, nn_Wq, nn_g, 0, nn_y1, 1, nn_K, 3);
    var nn_ok = 1; var nni = 0;
    while (nni < 3) { if (tget(nn_y, nni) != tget(nn_y1, nni)) { nn_ok = 0; } nni = nni + 1; }
    assert(nn_ok == 1, "1.1.2 NaN: the NaN-free row is bit-identical to running it alone");
    var nn_xe = t_alloc(2 * nn_K); var nn_sf = t_alloc(2);
    bl_act_quant(nn_x, 2, nn_K, nn_xe, nn_sf);
    assert(all_nan(nn_sf + 8, 1) == 1, "1.1.2 NaN: bl_act_quant applies the same absmax rule");

    # (c) absmean of an empty tensor is +0 (was 0/0 = NaN)
    assert(f64_eq(absmean(nn_x, 0), f64_from(0)) == 1, "1.1.2: absmean(w, 0) = 0");

    # (d) the GPU tile path's host fallback, never run by the suite before 1.1.2 (gpumm
    # uses one 8x16x32 shape, all multiples of the tile): ragged M, K, N and a bias
    assert(gpu_fallback_matches(8, 16, 32, 101, 0) == 1,
      "1.1.2 gpu: 8x16x32 (gpumm's shape) bit-identical, 0 GPU tiles");
    assert(gpu_fallback_matches(11, 9, 13, 102, 1) == 1,
      "1.1.2 gpu: 11x9x13 + bias (ragged in every dim) bit-identical");
    assert(gpu_fallback_matches(3, 20, 5, 103, 0) == 1,
      "1.1.2 gpu: 3x20x5 (three k-tiles, partial last) bit-identical");
    assert(gpu_fallback_matches(1, 1, 1, 104, 1) == 1, "1.1.2 gpu: 1x1x1 + bias bit-identical");

    # (e) a shorter prompt is legal (T <= the init T) and serves the same logits as the
    # prefix of the full sequence: attention is causal, everything else is per token.
    var pf_T = 2; var pf_full = t_alloc(ciT * ciV);
    tx_fwd_packed(citok, ciV, ciT, ciC, ciF); t_copy(pf_full, ki_logits, ciT * ciV);
    tx_fwd_packed(citok, ciV, pf_T, ciC, ciF);
    var pf_ok = 1; var pfi = 0;
    while (pfi < pf_T * ciV) { if (tget(ki_logits, pfi) != tget(pf_full, pfi)) { pf_ok = 0; } pfi = pfi + 1; }
    assert(pf_ok == 1, "1.1.2: serving a 2-token prefix gives the first 2 rows of the 4-token serve, bit for bit");

    # (f) every guard's FAIL path, in a forked child (exit 1 = the guard fired)
    g_V = ciV; g_T = ciT; g_C = ciC; g_F = ciF; g_tok = citok; g_tgt = citgt;
    g_bad = t_alloc(ciT); t_copy(g_bad, citok, ciT); store64(g_bad + 8, ciV);   # id V is one past the vocabulary
    g_buf = t_alloc(16); g_buf2 = t_alloc(32);
    assert(child_exit(&sc_ok_noop) == 0, "guard harness: a child that returns exits 0");
    assert(child_exit(&sc_ok_short_t) == 0, "guard: tx_fwd at T - 1 is legal");
    assert(child_exit(&sc_tpack2_bad) == 1, "guard: tpack2 refuses a non-ternary weight");
    assert(child_exit(&sc_pack_w_bad) == 1, "guard: tsimd_pack_w refuses a non-ternary weight");
    assert(child_exit(&sc_simd_big_k) == 1, "guard: the SIMD kernel refuses K > 2^22");
    assert(child_exit(&sc_tx_pack_noinit) == 1, "guard: tx_pack before tx_pack_init");
    assert(child_exit(&sc_packed_not_ready) == 1, "guard: tx_fwd_packed before tx_pack");
    assert(child_exit(&sc_fwd_tok_hi) == 1, "guard: tx_fwd refuses token id V");
    assert(child_exit(&sc_fwd_tok_neg) == 1, "guard: tx_fwd refuses token id -1");
    assert(child_exit(&sc_bwd_tok) == 1, "guard: tx_bwd refuses token id V (it used to write past tx_dtokemb)");
    assert(child_exit(&sc_xent_fwd_tgt) == 1, "guard: softmax_xent_fwd refuses target id V");
    assert(child_exit(&sc_xent_bwd_tgt) == 1, "guard: softmax_xent_bwd refuses target id -1");
    assert(child_exit(&sc_fwd_c) == 1, "guard: tx_fwd refuses a C other than tx_init's");
    assert(child_exit(&sc_fwd_t) == 1, "guard: tx_fwd refuses T past tx_init's");
    assert(child_exit(&sc_fwd_t0) == 1, "guard: tx_fwd refuses T = 0");
    assert(child_exit(&sc_fwd_noinit) == 1, "guard: tx_fwd before tx_init");
    assert(child_exit(&sc_packed_tok) == 1, "guard: tx_fwd_packed refuses token id V");
    assert(child_exit(&sc_fwdq_noint) == 1, "guard: tx_fwd_q before tx_int_init");
    assert(child_exit(&sc_blq_cap) == 1, "guard: bl_forward_q refuses N past the tx_int_init sizing");
    assert(child_exit(&sc_block_f) == 1, "guard: block_fwd refuses an F other than blk_init's");
    assert(child_exit(&sc_sgd_v) == 1, "guard: tx_sgd refuses a V other than tx_init's");
    assert(child_exit(&sc_pack_dims) == 1, "guard: tx_pack refuses dims other than the model's");

    test_group("1.2.0 packed-model serialization (tx_pack_serialize / tx_pack_deserialize)");
    # (a) the load's memory bound: tx_model_alloc_bytes is exactly what the inits allocate
    var am_cfg = 0;
    while (am_cfg < 2) {
        var zaV = 6; var zaT = 4; var zaC = 4; var zaF = 8;
        if (am_cfg == 1) { zaV = 40; zaT = 6; zaC = 32; zaF = 48; }
        var a0 = alloc_used();
        tx_init(zaV, zaT, zaC, zaF); tx_int_init(zaV, zaT, zaC, zaF); tx_pack_init(zaV, zaT, zaC, zaF);
        assert(tx_model_alloc_bytes(zaV, zaT, zaC, zaF) == alloc_used() - a0,
          "1.2.0: tx_model_alloc_bytes == the bytes tx_init + tx_int_init + tx_pack_init allocate");
        am_cfg = am_cfg + 1;
    }
    assert(tx_model_alloc_bytes(0, 4, 4, 8) == (0 - 1), "1.2.0: tx_model_alloc_bytes refuses a dim of 0");
    assert(tx_model_alloc_bytes(6, 4, 1048577, 8) == (0 - 1), "1.2.0: tx_model_alloc_bytes refuses a dim past 2^20");

    # (b) round trip: a TRAINED model, then a wide one (C = 20, F = 40: K = 20 and 40 put a
    # 16-lane span AND a tail in every layer, so the recomputed wsum must stop at K16), each
    # served after its in-memory state is overwritten
    var rt_cfg = 0;
    while (rt_cfg < 2) {
        var rV = ciV; var rT = ciT; var rC = ciC; var rF = ciF;
        if (rt_cfg == 1) { rV = 40; rT = 6; rC = 20; rF = 40; }
        var rst = t_alloc(2); var rtok = t_alloc(rT); var rtgt = t_alloc(rT); var rti = 0;
        while (rti < rT) {
            store64(rtok + rti * 8, (rti * 7 + 1) % rV); store64(rtgt + rti * 8, (rti * 7 + 2) % rV);
            rti = rti + 1;
        }
        tx_train(rtok, rtgt, rV, rT, rC, rF, 40, 11 + rt_cfg, rst);
        tx_int_init(rV, rT, rC, rF); tx_pack_init(rV, rT, rC, rF); tx_pack(rV, rT, rC, rF);
        g_tok_s = rtok;
        tx_fwd_packed(rtok, rV, rT, rC, rF);
        g_ref = t_alloc(rT * rV); t_copy(g_ref, ki_logits, rT * rV);
        var rn = tx_pack_serial_bytes();
        var rbuf = alloc(rn + 64); var rbuf2 = alloc(rn + 64);
        assert(tx_pack_serialize(rbuf, rn) == rn, "1.2.0: tx_pack_serialize writes tx_pack_serial_bytes() bytes");
        tx_pack_serialize(rbuf2, rn);
        assert(same_bytes(rbuf, rbuf2, rn) == 1, "1.2.0: serializing twice gives the same bytes");
        tx_init(rV + 3, rT + 1, rC + 4, rF + 4); tx_param_init(rV + 3, rT + 1, rC + 4, rF + 4, 99);   # overwrite
        assert(tx_pack_deserialize(rbuf, rn, 1 << 40) == 0,
          "1.2.0: tx_pack_deserialize loads what tx_pack_serialize wrote");
        assert(serves_ref(rV, rT, rC, rF) == 1,
          "1.2.0: the loaded model serves bit-identically to the live packed model");
        tx_fwd_packed(rtok, rV, 2, rC, rF);
        var rpf = 1; var rpi = 0;
        while (rpi < 2 * rV) { if (tget(ki_logits, rpi) != tget(g_ref, rpi)) { rpf = 0; } rpi = rpi + 1; }
        assert(rpf == 1, "1.2.0: the loaded model serves a prefix's rows bit for bit");
        tx_pack_serialize(rbuf2, rn);
        assert(same_bytes(rbuf, rbuf2, rn) == 1,
          "1.2.0: re-serializing the loaded model gives the same bytes (canonical)");
        rt_cfg = rt_cfg + 1;
    }

    # (c) every status code, on a valid artifact mutated one field at a time. C = 3 so the
    # 9-weight attention layers end mid-byte: there are padding BITS as well as bytes.
    var zeV = 5; var zeT = 3; var zeC = 3; var zeF = 5;
    var art = make_artifact(zeV, zeT, zeC, zeF, 21); var an = g_art_n;
    var need = tx_model_alloc_bytes(zeV, zeT, zeC, zeF);
    var big = 1 << 40;
    assert(tx_pack_deserialize(art, an, need) == 0, "1.2.0: max_bytes equal to the need loads");
    var m = art_copy(art, an);
    assert(tx_pack_deserialize(m, an - 1, big) == pk_err_length(), "1.2.0: a buffer one byte short -> pk_err_length");
    assert(tx_pack_deserialize(m, an + 8, big) == pk_err_length(), "1.2.0: trailing bytes -> pk_err_length");
    assert(tx_pack_deserialize(m, 10, big) == pk_err_length(), "1.2.0: shorter than a header -> pk_err_length");
    store8(m, 0x55);
    assert(tx_pack_deserialize(m, an, big) == pk_err_magic(), "1.2.0: a wrong magic -> pk_err_magic");
    m = art_copy(art, an); store64(m + 8, 2);
    assert(tx_pack_deserialize(m, an, big) == pk_err_version(), "1.2.0: format version 2 -> pk_err_version");
    m = art_copy(art, an); store64(m + 56, 1);
    assert(tx_pack_deserialize(m, an, big) == pk_err_header(), "1.2.0: a nonzero flags word -> pk_err_header");
    m = art_copy(art, an); store64(m + 24, 0);
    assert(tx_pack_deserialize(m, an, big) == pk_err_header(), "1.2.0: V = 0 -> pk_err_header");
    m = art_copy(art, an); store64(m + 40, 1048577);
    assert(tx_pack_deserialize(m, an, big) == pk_err_header(), "1.2.0: C = 2^20 + 1 -> pk_err_header");
    m = art_copy(art, an); store64(m + 16, an + 8);
    assert(tx_pack_deserialize(m, an, big) == pk_err_length(), "1.2.0: a length field that disagrees -> pk_err_length");
    m = art_copy(art, an); store64(m + 32, zeT + 1);
    assert(tx_pack_deserialize(m, an, big) == pk_err_length(), "1.2.0: dims that imply another size -> pk_err_length");
    assert(tx_pack_deserialize(art, an, need - 1) == pk_err_too_big(), "1.2.0: max_bytes one short -> pk_err_too_big");
    m = art_copy(art, an); store8(m + 100, load8(m + 100) ^ 4);
    assert(tx_pack_deserialize(m, an, big) == pk_err_checksum(), "1.2.0: one flipped payload bit -> pk_err_checksum");
    m = art_copy(art, an); store8(m + 72, load8(m + 72) | 3); art_fix(m, an);       # weight 0 of layer 0 := code 3
    assert(tx_pack_deserialize(m, an, big) == pk_err_weights(), "1.2.0: a weight code of 3 -> pk_err_weights");
    m = art_copy(art, an); store8(m + 74, load8(m + 74) | 0x80); art_fix(m, an);    # bits past the 9th code
    assert(tx_pack_deserialize(m, an, big) == pk_err_weights(), "1.2.0: a nonzero padding bit -> pk_err_weights");
    m = art_copy(art, an); store8(m + 79, 1); art_fix(m, an);                        # a padding byte
    assert(tx_pack_deserialize(m, an, big) == pk_err_weights(), "1.2.0: a nonzero padding byte -> pk_err_weights");
    m = art_copy(art, an); store64(m + 64, f64_neg(f64_from(1))); art_fix(m, an);
    assert(tx_pack_deserialize(m, an, big) == pk_err_gamma(), "1.2.0: a negative gamma -> pk_err_gamma");
    m = art_copy(art, an); store64(m + 64, f64_div(f64_from(0), f64_from(0))); art_fix(m, an);
    assert(tx_pack_deserialize(m, an, big) == pk_err_gamma(), "1.2.0: a NaN gamma -> pk_err_gamma");
    var pofs = an - 8 - 8 * (zeV * zeC + zeT * zeC + 3 * zeC + zeV);                      # first f64 parameter
    m = art_copy(art, an); store64(m + pofs, f64_div(f64_from(1), f64_from(0))); art_fix(m, an);
    assert(tx_pack_deserialize(m, an, big) == pk_err_param(), "1.2.0: an infinite embedding -> pk_err_param");
    m = art_copy(art, an); store64(m + an - 16, f64_div(f64_from(0), f64_from(0))); art_fix(m, an);
    assert(tx_pack_deserialize(m, an, big) == pk_err_param(), "1.2.0: a NaN head bias -> pk_err_param");
    assert(serves_ref(zeV, zeT, zeC, zeF) == 1,
      "1.2.0: after 19 refused loads the loaded model still serves bit-identically");
    # the encoder's own refusals
    var small = alloc(an + 8); store8(small, 7);
    assert(tx_pack_serialize(small, an - 1) == (0 - 1), "1.2.0: tx_pack_serialize with cap < size -> -1");
    assert(load8(small) == 7, "1.2.0: ... and writes nothing");
    var keep = tget(tx_bhead, 0);
    tset(tx_bhead, 0, f64_div(f64_from(0), f64_from(0)));
    assert(tx_pack_serialize(small, an) == (0 - 2), "1.2.0: tx_pack_serialize refuses a NaN parameter (-2)");
    tset(tx_bhead, 0, keep);

    # (d) a loaded model has no latent weights: the paths that read them refuse it
    tx_pack_deserialize(art, an, big);
    var zdims = t_alloc(4);
    tx_pack_dims(zdims);
    var zdok = (load64(zdims) == zeV) & (load64(zdims + 8) == zeT);
    zdok = zdok & (load64(zdims + 16) == zeC) & (load64(zdims + 24) == zeF);
    assert(zdok == 1, "1.3.0: tx_pack_dims reports the loaded model's V, T, C, F");
    assert(child_exit(&sc_dims_none) == 1, "1.3.0 guard: tx_pack_dims refuses when no packed model is live");
    g_V = zeV; g_T = zeT; g_C = zeC; g_F = zeF; g_tok = g_tok_s;
    g_tgt = t_alloc(zeT); t_copy(g_tgt, g_tok_s, zeT);
    assert(child_exit(&sc_po_serve) == 0, "1.2.0: a loaded model serves (tx_fwd_packed)");
    assert(child_exit(&sc_po_fwd) == 1, "1.2.0 guard: tx_fwd refuses a loaded model");
    assert(child_exit(&sc_po_fwdq) == 1, "1.2.0 guard: tx_fwd_q refuses a loaded model");
    assert(child_exit(&sc_po_bwd) == 1, "1.2.0 guard: tx_bwd refuses a loaded model");
    assert(child_exit(&sc_po_sgd) == 1, "1.2.0 guard: tx_sgd refuses a loaded model");
    assert(child_exit(&sc_po_pack) == 1, "1.2.0 guard: tx_pack refuses a loaded model (it would pack zero latents)");
    assert(child_exit(&sc_po_reinit) == 0, "1.2.0: after tx_param_init the model is ordinary again");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
