# tentib benchmarks — the 0.5.0 numbers behind docs/benchmarks.md.
# Two surfaces, B-series fairness (identical shapes, warm cache, single thread;
# toolchain + CPU reported in the doc):
#   1. per-layer kernel sweep (M=1 row, K x N): branchy / branchless / SIMD
#      (pack-once, the deployment shape) / rosnet SIMD-f64 linear_fwd — the same
#      quantized layer, four compute paths. + pack/act-quant amortization costs.
#   2. whole-model forward -> tok/s at a b1.58-shaped config (F = 4C): the f64
#      weight-only path vs the scalar integer kernel vs the integer-SIMD kernel.
#      Modes 0/2 re-quantize (+ mode 2 re-packs) per call, mirroring the f64
#      path's per-call weight quantization — every path pays its prep, honestly.
# Pattern: bench_new -> bench_run (per-call costs are 1 us - 10 ms; no batching
# needed) -> bench_avg_ns. See lib/bench.cyr for the overhead guidance.

include "lib/tyche.cyr"      # rng_* (rosnet's t_randn -> rng_normal; link dep)
include "lib/rosnet.cyr"     # t_alloc / linear_fwd / f64 helpers
include "src/ternary.cyr"    # absmean / ternary_quantize (M0)
include "src/bitlinear.cyr"  # bl_forward_full / bl_weight_effective (M1)
include "src/layers.cyr"     # rmsnorm / gelu / attention (M2)
include "src/model.cyr"      # softmax_xent (M2)
include "lib/akshara.cyr"    # corpus_set / gd_ld (link dep for block.cyr)
include "src/block.cyr"      # tx_init / tx_param_init / tx_fwd (M2)
include "src/kernel.cyr"     # the matmul-free kernels incl. 0.4.1 SIMD (M3)
include "src/serial.cyr"     # tx_pack_serialize / tx_pack_deserialize (1.2.0)
include "src/decode.cyr"     # tx_dec_reset / tx_dec_step — incremental decode (1.4.0)

fn _putc(ch): i64 { var b[8]; store8(&b, ch); sys_write(1, &b, 1); return 0; }
# The harness's printer: a NUL-terminated string to stdout.
fn puts(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } print(s, n); return 0; }
# akshara loader/streaming consumer symbols — unused (corpus_set/gd_ld only)
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
# akshara hook, not wired here: stdin reading is refused (-1).
fn read_stdin(buf, cap): i64 { return 0 - 1; }
# akshara hook, not wired here: seeking is refused (-1).
fn file_seek(fd, off): i64 { return 0 - 1; }

# ---- 1. per-layer kernel sweep ------------------------------------------------
# One quantized M=1 x K -> N BitLinear, timed through all four compute paths.
# Globals so the zero-arg bench fnptrs can reach the current shape's buffers.

var bK = 0; var bN = 0;
var bx = 0; var bqx = 0; var bsi = 0; var bg = 0;
var bWq = 0; var bWe = 0; var bxe = 0;
var byi = 0; var byb = 0; var bys = 0; var byf = 0;
var bw8t = 0; var bwsum = 0; var bxu8 = 0;
var bw2 = 0; var bxu8m = 0; var bwrow = 0; var by2 = 0;       # 1.5.1: the 2-bit store

# One timed call: the branchy scalar kernel on the layer_setup operands.
fn bw_branchy(): i64 { return ternary_matmul_free(bqx, bsi, bWq, bg, 0, byi, 1, bK, bN); }
# One timed call: the branchless scalar kernel.
fn bw_branchless(): i64 { return ternary_matmul_free_bl(bqx, bsi, bWq, bg, 0, byb, 1, bK, bN); }
# One timed call: the SIMD kernel on the pre-packed weights.
fn bw_simd(): i64 { return ternary_matmul_free_simd(bqx, bsi, bw8t, bwsum, bg, 0, bys, 1, bK, bN, bxu8); }
# One timed call: the 2-bit SIMD kernel on the same weights stored 2 bits each (1.5.1).
fn bw_simd2(): i64 { return _tmf_simd2(bqx, bsi, bw2, bwsum, bg, 0, by2, 1, bK, bN, bxu8m, bwrow); }
# One timed call: rosnet's f64 linear_fwd on the dequantized operands.
fn bw_rosnet(): i64 { return linear_fwd(bxe, bWe, 0, byf, 1, bK, bN); }
# One timed call: tsimd_pack_w (the once-per-weight pack).
fn bw_pack(): i64 { return tsimd_pack_w(bWq, bK, bN, bw8t, bwsum); }
# One timed call: act_quant_int on one token row.
fn bw_actq(): i64 { return act_quant_int(bx, 1, bK, bqx, bsi); }

# Build one random quantized layer at K x N (fresh buffers; rosnet's bump
# allocator never frees — fine for a handful of shapes).
fn layer_setup(K, N, seed): i64 {
    bK = K; bN = N;
    var KN = K * N;
    bx = t_alloc(K); var W = t_alloc(KN);
    bWq = t_alloc(KN); bWe = t_alloc(KN); bxe = t_alloc(K);
    bqx = t_alloc(K); bsi = t_alloc(1);
    byi = t_alloc(N); byb = t_alloc(N); bys = t_alloc(N); byf = t_alloc(N);
    bw8t = alloc(KN); bwsum = t_alloc(N); bxu8 = alloc(K);
    rng_seed(seed);
    t_randn(bx, K, f64_from(1));
    t_randn(W, KN, f64_div(f64_from(1), f64_from(2)));
    var sf = t_alloc(1);
    bg = bl_forward_full(bx, W, 0, byf, 1, K, N, bWq, bWe, bxe, sf);   # bWe/bxe = the f64 path's inputs
    act_quant_int(bx, 1, K, bqx, bsi);
    tsimd_pack_w(bWq, K, N, bw8t, bwsum);                              # pack-once (deployment)
    bw2 = alloc(N * _pk2_row_bytes(K) + 8); bxu8m = alloc(K + 16); bwrow = alloc(K + 16);
    by2 = t_alloc(N);
    _pk2_from_w8t(bw8t, K, N, bw2);                                    # the 2-bit store (1.5.1)
    return 0;
}

# Time one fnptr: warmup then measured runs; returns avg ns/call.
fn timed(fp, warm, iters): i64 {
    var w = 0;
    while (w < warm) { fncall0(fp); w = w + 1; }
    var b = bench_new("row");
    bench_run(b, fp, iters);
    return bench_avg_ns(b);
}

# Print num/den with one decimal (den != 0).
fn f2dec(num, den): i64 {   # print num/den with 1 decimal (den != 0)
    var whole = num / den;
    var tenth = ((num * 10) / den) % 10;
    fmt_int(whole); _putc(46); fmt_int(tenth);
    return 0;
}

# Time the four kernels at one K x N and print the row.
fn layer_row(K, N, seed, iters): i64 {
    layer_setup(K, N, seed);
    var tby = timed(&bw_branchy, 3, iters);
    var tbl = timed(&bw_branchless, 3, iters);
    var tsd = timed(&bw_simd, 3, iters);
    var ts2 = timed(&bw_simd2, 3, iters);
    var trs = timed(&bw_rosnet, 3, iters);
    fmt_int(K); puts("x"); fmt_int(N);
    puts("  branchy="); fmt_int(tby);
    puts("  branchless="); fmt_int(tbl);
    puts("  simd="); fmt_int(tsd);
    puts("  simd2="); fmt_int(ts2);
    puts("  rosnet-f64="); fmt_int(trs);
    puts("  ns/call   simd-speedup: vs-f64="); f2dec(trs, tsd);
    puts("x  vs-branchless="); f2dec(tbl, tsd); puts("x\n");
    return 0;
}

# ---- 2. whole-model forward -> tok/s -------------------------------------------
var wmV = 0; var wmT = 0; var wmC = 0; var wmF = 0; var wmtok = 0;

# One whole-model f64 forward (the timed unit).
fn wm_f64(): i64 { return tx_fwd(wmtok, wmV, wmT, wmC, wmF); }
# One whole-model scalar-integer forward.
fn wm_int(): i64 { return tx_fwd_q(0, wmtok, wmV, wmT, wmC, wmF); }
# One whole-model integer-SIMD forward (re-packs per call).
fn wm_simd(): i64 { return tx_fwd_q(2, wmtok, wmV, wmT, wmC, wmF); }
# One packed-serving forward.
fn wm_packed(): i64 { return tx_fwd_packed(wmtok, wmV, wmT, wmC, wmF); }
var wmtgt = 0;
var wmnlr = 0;
var wmbuf = 0; var wmn = 0;
# One timed call: write the live packed model to bytes (1.2.0).
fn wm_ser(): i64 { return tx_pack_serialize(wmbuf, wmn); }
# One SGD training step on the f64 path: zero grads, forward + loss, backward, update.
fn wm_step(): i64 {
    tx_zero_grads(wmV, wmT, wmC, wmF);
    tx_loss(wmtok, wmtgt, wmV, wmT, wmC, wmF);
    tx_bwd(wmtok, wmtgt, wmV, wmT, wmC, wmF);
    return tx_sgd(wmV, wmT, wmC, wmF, wmnlr);
}

# Generate a T-token window the 1.3.x way: one full packed forward per token, over the
# window so far (1.4.0 bench; the per-token cost is this / T).
fn wm_gen_full(): i64 {
    var t = 1;
    while (t <= wmT) { tx_fwd_packed(wmtok, wmV, t, wmC, wmF); t = t + 1; }
    return 0;
}
# The same T tokens through the incremental decoder: a reset, then one cached step each.
fn wm_gen_step(): i64 {
    tx_dec_reset();
    var t = 0;
    while (t < wmT) { tx_dec_step(load64(wmtok + t * 8)); t = t + 1; }
    return 0;
}
# One load of the bench artifact over the loaded model of the same dims (1.4.0: it
# reuses the buffers, so it can be timed over many calls).
fn wm_load_same(): i64 { return tx_pack_deserialize(wmbuf, wmn, 1 << 40); }
# The same for a serving-only load over a serving-only model (1.5.0).
fn wm_load_serving_same(): i64 { return tx_pack_deserialize_serving(wmbuf, wmn, 1 << 40); }

# Tokens per second for an average forward time in ns.
fn toks_per_s(avg_ns): i64 {   # T tokens per forward
    if (avg_ns == 0) { return 0; }
    return (wmT * 1000000000) / avg_ns;
}

# Build, time and print the whole-model rows at one config.
fn wm_bench(V, T, C, F, seed, iters): i64 {
    wmV = V; wmT = T; wmC = C; wmF = F;
    tx_init(V, T, C, F);
    tx_param_init(V, T, C, F, seed);
    tx_int_init(V, T, C, F);
    wmtok = t_alloc(T);
    var t = 0;
    while (t < T) { store64(wmtok + t * 8, (rng_u64() & 0x7FFFFFFFFFFFFFFF) % V); t = t + 1; }
    var params = V * C + T * C + 3 * C + 4 * C * C + 2 * C * F + C * V + V;
    puts("config V="); fmt_int(V); puts(" T="); fmt_int(T); puts(" C="); fmt_int(C);
    puts(" F="); fmt_int(F); puts("  params="); fmt_int(params);
    puts("  ternary-linear weights: f64="); fmt_int((4 * C * C + 2 * C * F + C * V) * 8);
    puts(" B -> 2-bit packed="); fmt_int((4 * C * C + 2 * C * F + C * V + 3) / 4); puts(" B\n");
    var tf = timed(&wm_f64, 2, iters);
    var ti = timed(&wm_int, 2, iters);
    var ts = timed(&wm_simd, 2, iters);
    tx_pack_init(V, T, C, F);                     # 0.7.0: quantize + pack ONCE...
    var tpk0 = now_ns();
    tx_pack(V, T, C, F);
    var tpk = now_ns() - tpk0;
    var td = timed(&wm_packed, 2, iters);         # ...then serve
    puts("  f64 weight-only        = "); fmt_int(tf); puts(" ns/fwd  ("); fmt_int(toks_per_s(tf)); puts(" tok/s)\n");
    puts("  integer scalar         = "); fmt_int(ti); puts(" ns/fwd  ("); fmt_int(toks_per_s(ti)); puts(" tok/s)\n");
    puts("  integer SIMD (0.4.1)   = "); fmt_int(ts);
    puts(" ns/fwd  ("); fmt_int(toks_per_s(ts)); puts(" tok/s)  simd-vs-f64=");
    f2dec(tf, ts); puts("x\n");
    puts("  PACKED serving (0.7.0) = "); fmt_int(td);
    puts(" ns/fwd  ("); fmt_int(toks_per_s(td)); puts(" tok/s)  packed-vs-f64=");
    f2dec(tf, td); puts("x   (one-time tx_pack = "); fmt_int(tpk); puts(" ns, amortized over the serve)\n");
    # Training throughput (1.1.2): one full SGD step, f64 path. Runs last because it
    # moves the latent weights.
    wmtgt = t_alloc(T);
    t = 0;
    while (t < T) { store64(wmtgt + t * 8, (rng_u64() & 0x7FFFFFFFFFFFFFFF) % V); t = t + 1; }
    wmnlr = f64_div(f64_from(0 - 1), f64_from(100));
    var tst = timed(&wm_step, 2, iters);
    puts("  training step (f64)    = "); fmt_int(tst); puts(" ns/step\n");
    # The packed model as bytes (1.2.0). A fresh load allocates a whole model (the bump
    # allocator never frees), so it is timed over 3 calls, not `iters`. Clearing
    # tx_packed_only before each makes the live model count as built in this process,
    # which a load never overwrites (1.4.0), so all three take the allocating path.
    wmn = tx_pack_serial_bytes(); wmbuf = alloc(wmn);
    var tse = timed(&wm_ser, 2, iters);
    var tde = 0; var di = 0;
    while (di < 3) {
        tx_packed_only = 0;
        var d0 = now_ns();
        tx_pack_deserialize(wmbuf, wmn, 1 << 40);
        tde = tde + now_ns() - d0;
        di = di + 1;
    }
    tde = tde / 3;
    var tds = timed(&wm_load_same, 2, iters);    # 1.4.0: over a loaded model of the same dims
    puts("  serialize              = "); fmt_int(tse); puts(" ns/op  ("); fmt_int(wmn); puts(" bytes)\n");
    puts("  deserialize            = "); fmt_int(tde); puts(" ns/op  (allocates ");
    fmt_int(tx_model_alloc_bytes(V, T, C, F)); puts(" bytes)\n");
    puts("  deserialize same dims  = "); fmt_int(tds); puts(" ns/op  (allocates 0 bytes: reuses the loaded model's)\n");
    # Incremental decode (1.4.0), on the loaded model: a T-token window one token at a
    # time, with a full forward per token (the 1.3.x way) and with the cached step.
    var tgf = timed(&wm_gen_full, 2, iters) / T;
    var tgs = timed(&wm_gen_step, 2, iters) / T;
    puts("  decode, full fwd/token = "); fmt_int(tgf); puts(" ns/tok  (window grows 1.."); fmt_int(T); puts(")\n");
    puts("  decode, cached step    = "); fmt_int(tgs); puts(" ns/tok  ("); f2dec(tgf, tgs);
    puts("x the full forward per token; cache "); fmt_int(tx_dec_alloc_bytes(T, C)); puts(" bytes)\n");
    # Loading for serving only (1.5.0). Fresh: tx_packed_only cleared first, as above, so
    # nothing is reused; timed over 3 calls. Then over a serving-only model of the same dims.
    var tsv = 0; di = 0;
    while (di < 3) {
        tx_packed_only = 0;
        var s0 = now_ns();
        tx_pack_deserialize_serving(wmbuf, wmn, 1 << 40);
        tsv = tsv + now_ns() - s0;
        di = di + 1;
    }
    tsv = tsv / 3;
    var tss = timed(&wm_load_serving_same, 2, iters);
    var tsp = timed(&wm_packed, 2, iters);         # serving from the serving-only model
    puts("  deserialize serving    = "); fmt_int(tsv); puts(" ns/op  (allocates ");
    fmt_int(tx_serve_alloc_bytes(V, T, C, F)); puts(" bytes)\n");
    puts("  serving, same dims     = "); fmt_int(tss); puts(" ns/op  (allocates 0 bytes)\n");
    puts("  PACKED, serving-only   = "); fmt_int(tsp); puts(" ns/fwd  ("); fmt_int(toks_per_s(tsp));
    puts(" tok/s; the same kernel, on the serving-only model's buffers)\n");
    # The 2-bit weight store (1.5.1, internal): a fresh compact load (3 calls), then packed serving
    # and the cached decode step from it, the same logits as the i8 store's.
    var tcl = 0; di = 0;
    while (di < 3) {
        tx_packed_only = 0;
        var c0 = now_ns();
        _tx_pack_deserialize_compact(wmbuf, wmn, 1 << 40);
        tcl = tcl + now_ns() - c0;
        di = di + 1;
    }
    tcl = tcl / 3;
    var tc2 = timed(&wm_packed, 2, iters);
    var tcg = timed(&wm_gen_step, 2, iters) / T;
    var wi8 = 0; var w2b = 0; var li = 0;
    while (li < 7) {
        var lK = _pk_layer_k(li, C, F); var lN = _pk_layer_n(li, C, F, V);
        wi8 = wi8 + lK * lN; w2b = w2b + lN * _pk2_row_bytes(lK);
        li = li + 1;
    }
    puts("  deserialize 2-bit      = "); fmt_int(tcl); puts(" ns/op  (allocates ");
    fmt_int(_tx_compact_alloc_bytes(V, T, C, F)); puts(" bytes; weights "); fmt_int(w2b);
    puts(" bytes, against "); fmt_int(wi8); puts(" as i8)\n");
    puts("  PACKED, 2-bit store    = "); fmt_int(tc2); puts(" ns/fwd  ("); fmt_int(toks_per_s(tc2));
    puts(" tok/s; "); f2dec(tc2 * 10, tsp); puts("/10 of the i8 store's time)\n");
    puts("  decode, 2-bit step     = "); fmt_int(tcg); puts(" ns/tok  ("); f2dec(tcg * 10, tgs);
    puts("/10 of the i8 store's step)\n");
    return 0;
}

# The benchmark harness; see docs/benchmarks.md for the method.
fn main(): i64 {
    alloc_init();
    puts("tentib bench — single thread, warm cache; every path re-quantizes per call\n");
    puts("(whole-model) or is pack-once (layer sweep); report CPU + cyrius pin with the numbers.\n\n");
    puts("[1] per-layer kernel sweep (M=1 row, ns/call; SIMD row is pack-once):\n");
    layer_row(128, 128, 9, 200);
    layer_row(256, 256, 10, 100);
    layer_row(512, 512, 11, 50);
    layer_row(768, 768, 12, 30);      # GPT-2-small hidden-dim-shaped row
    puts("\n[2] prep amortization at 768x768 (ns/call; pack is once-per-weight, act-quant once-per-token):\n");
    puts("  tsimd_pack_w="); fmt_int(timed(&bw_pack, 2, 30));
    puts("  act_quant_int="); fmt_int(timed(&bw_actq, 2, 200)); puts("\n");
    puts("\n[3] whole-model forward -> tok/s (b1.58-shaped F=4C; T tokens/fwd):\n");
    wm_bench(256, 32, 128, 512, 1337, 30);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
